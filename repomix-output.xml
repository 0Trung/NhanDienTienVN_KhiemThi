import { AppError } from '../contracts';
import type { AppErrorCode } from '../contracts';

/** Các mã lỗi mà module camera có thể tạo ra. */
export type CameraErrorCode = Extract<
  AppErrorCode,
  'UNSUPPORTED_BROWSER' | 'CAMERA_PERMISSION_DENIED' | 'CAMERA_NOT_FOUND' | 'CAMERA_IN_USE' | 'CAMERA_FAILED'
>;

/** Thông điệp tiếng Việt nói rõ việc cần làm. fatal = true khi tự thử lại vô ích, người dùng phải can thiệp ngoài ứng dụng. */
const ERROR_INFO: Readonly<Record<CameraErrorCode, { message: string; fatal: boolean }>> = {
  UNSUPPORTED_BROWSER: {
    fatal: true,
    message: 'Thiết bị này chưa hỗ trợ dùng camera trong ứng dụng. Hãy cập nhật Android System WebView hoặc Chrome rồi mở lại ứng dụng.',
  },
  CAMERA_PERMISSION_DENIED: {
    fatal: true,
    message: 'Ứng dụng chưa được phép dùng camera. Hãy vào Cài đặt, chọn Ứng dụng, chọn ứng dụng này, bật quyền Camera rồi mở lại.',
  },
  CAMERA_NOT_FOUND: {
    fatal: true,
    message: 'Không tìm thấy camera trên thiết bị. Hãy kiểm tra camera có bị hỏng hoặc bị che không rồi mở lại ứng dụng.',
  },
  CAMERA_IN_USE: {
    fatal: false,
    message: 'Camera đang được ứng dụng khác sử dụng. Hãy đóng các ứng dụng đang dùng camera, kết thúc cuộc gọi video nếu có, rồi thử lại.',
  },
  CAMERA_FAILED: {
    fatal: false,
    message: 'Không mở được camera. Hãy đóng hẳn ứng dụng rồi mở lại; nếu vẫn lỗi thì hãy khởi động lại điện thoại.',
  },
};

/** Thông điệp riêng cho ngữ cảnh không an toàn (mã UNSUPPORTED_BROWSER). */
export const INSECURE_CONTEXT_MESSAGE =
  'Camera chỉ dùng được trên kết nối an toàn (https hoặc localhost). Hãy mở ứng dụng qua địa chỉ https.';

/** Tên lỗi DOM → mã lỗi ứng dụng (F2). Dùng Map để tên như "constructor" không bị coi là khoá có sẵn. */
const NAME_TO_CODE: ReadonlyMap<string, CameraErrorCode> = new Map<string, CameraErrorCode>([
  ['NotAllowedError', 'CAMERA_PERMISSION_DENIED'],
  ['SecurityError', 'CAMERA_PERMISSION_DENIED'],
  ['NotFoundError', 'CAMERA_NOT_FOUND'],
  ['DevicesNotFoundError', 'CAMERA_NOT_FOUND'],
  ['NotReadableError', 'CAMERA_IN_USE'],
  ['TrackStartError', 'CAMERA_IN_USE'],
]);

/** Đọc `name` của một giá trị bị ném ra bất kỳ; không phải đối tượng có name dạng chuỗi thì trả chuỗi rỗng. */
export function errorName(err: unknown): string {
  const name = typeof err === 'object' && err !== null ? (err as { name?: unknown }).name : undefined;
  return typeof name === 'string' ? name : '';
}

/** Lỗi "ràng buộc không thoả" (tên mới và tên cũ của trình duyệt). */
export function isOverconstrainedError(err: unknown): boolean {
  const name = errorName(err);
  return name === 'OverconstrainedError' || name === 'ConstraintNotSatisfiedError';
}

/** Tạo AppError camera với thông điệp tiếng Việt chuẩn; `message` chỉ để ghi đè trường hợp đặc biệt. */
export function createCameraError(code: CameraErrorCode, detail?: unknown, message?: string): AppError {
  const info = ERROR_INFO[code];
  return new AppError(code, message ?? info.message, info.fatal, detail);
}

/** Ánh xạ mọi giá trị bị ném ra từ API camera sang AppError (F2). AppError có sẵn được giữ nguyên. */
export function mapCameraError(err: unknown): AppError {
  if (err instanceof AppError) return err;
  return createCameraError(NAME_TO_CODE.get(errorName(err)) ?? 'CAMERA_FAILED', err);
}
</file>

<file path="src/camera/camera-service.ts">
import type { ITorchPort } from '../contracts';
import { createLogger } from '../utils/logger';
import { INSECURE_CONTEXT_MESSAGE, createCameraError, isOverconstrainedError, mapCameraError } from './camera-errors';

const log = createLogger('camera:service');

/** Nhãn ống kính phụ: không được ưu tiên khi chọn camera chính (F5). */
const SECONDARY_LENS = /ultra|wide|tele|macro|depth/i;
const BACK_FACING = /back|rear|environment/i;
const IDEAL_SIZE = { width: { ideal: 1280 }, height: { ideal: 720 } };
const IDEAL_FPS = { frameRate: { ideal: 30 } };
const FACING_BACK = { facingMode: { ideal: 'environment' } };

/** Phần của navigator.mediaDevices mà module dùng (tiêm đồ giả khi test). */
export interface MediaDevicesLike {
  getUserMedia(constraints: MediaStreamConstraints): Promise<MediaStream>;
  enumerateDevices?(): Promise<MediaDeviceInfo[]>;
}

/** Khả năng và ràng buộc ngoài chuẩn lib.dom (Image Capture). */
interface TrackCapabilitiesExt { torch?: boolean; focusMode?: readonly string[] }
type ConstraintSetExt = MediaTrackConstraintSet & { torch?: boolean; focusMode?: string };

/** Chuỗi ràng buộc, hạ dần khi gặp OverconstrainedError (F1): đủ → bỏ độ phân giải → bỏ cả facingMode. audio luôn false. */
export const CONSTRAINT_STEPS: ReadonlyArray<MediaStreamConstraints> = [
  { audio: false, video: { ...FACING_BACK, ...IDEAL_SIZE, ...IDEAL_FPS } },
  { audio: false, video: { ...FACING_BACK, ...IDEAL_FPS } },
  { audio: false, video: { ...IDEAL_FPS } },
];

/**
 * Chọn camera sau chính (F5). Trả về deviceId cần chuyển sang, hoặc null nếu không cần chuyển:
 * nhãn rỗng (chưa có quyền), chưa đủ 2 camera sau, hoặc camera đang dùng không phải ống kính phụ.
 */
export function pickMainBackCamera(devices: readonly MediaDeviceInfo[], currentDeviceId?: string): string | null {
  const back = devices.filter((d) => d.kind === 'videoinput' && d.label !== '' && BACK_FACING.test(d.label));
  if (back.length < 2) return null;
  const main = back.find((d) => !SECONDARY_LENS.test(d.label));
  const current = back.find((d) => d.deviceId === currentDeviceId);
  return main && current && SECONDARY_LENS.test(current.label) ? main.deviceId : null;
}

/**
 * Cấu hình thẻ video: playsinline, muted, autoplay; aria-hidden để trình đọc màn hình không bắt focus;
 * kiểu hiển thị phủ kín khung chứa. Việc gắn thẻ vào DOM là của nơi dùng (P11).
 */
export function prepareVideoElement(video: HTMLVideoElement): void {
  video.muted = true;
  video.autoplay = true;
  video.playsInline = true;
  for (const [name, value] of [['muted', ''], ['autoplay', ''], ['playsinline', ''], ['aria-hidden', 'true']] as const) {
    video.setAttribute(name, value);
  }
  Object.assign(video.style, { display: 'block', width: '100%', height: '100%', objectFit: 'cover' });
}

/** Gắn stream vào thẻ video và chờ phát. play() lỗi thì ném CAMERA_FAILED. */
export async function attachStream(video: HTMLVideoElement, stream: MediaStream): Promise<void> {
  prepareVideoElement(video);
  video.srcObject = stream;
  try {
    await video.play();
  } catch (err) {
    throw createCameraError('CAMERA_FAILED', err);
  }
}

/** Gỡ stream khỏi thẻ video (việc dừng track là của CameraSource.close). */
export function detachStream(video: HTMLVideoElement): void {
  try {
    video.pause();
  } catch (err) {
    log.debug('video.pause() lỗi khi gỡ stream', err);
  }
  video.srcObject = null;
}

function stopStream(stream: MediaStream | null): void {
  for (const t of stream?.getTracks() ?? []) t.stop();
}

export interface CameraSourceDeps {
  /** navigator.mediaDevices (undefined khi ngữ cảnh không an toàn hoặc trình duyệt cũ). */
  mediaDevices: MediaDevicesLike | undefined;
  /** window.isSecureContext; undefined nghĩa là không biết, không chặn. */
  isSecureContext: boolean | undefined;
  torchPort?: ITorchPort;
  /** Gọi khi track video kết thúc ngoài ý muốn (app khác chiếm camera, rút camera). */
  onEnded: () => void;
}

export interface CameraSource {
  /** Xin quyền, mở camera sau, chọn camera chính, lấy nét liên tục, dò đèn. Ném AppError. */
  open(): Promise<MediaStream>;
  /** Dừng mọi track, tắt đèn qua cổng nếu cần. Gọi nhiều lần an toàn. */
  close(): void;
  /** Track video còn sống (readyState live). */
  isLive(): boolean;
  readonly torchSupported: boolean;
  /** true nếu bật/tắt được; không hỗ trợ hoặc lỗi thì false, không ném. */
  setTorch(on: boolean): Promise<boolean>;
}

type TorchMode = 'track' | 'port' | 'none';

export function createCameraSource(deps: CameraSourceDeps): CameraSource {
  const port = deps.torchPort;
  let stream: MediaStream | null = null;
  let track: MediaStreamTrack | null = null;
  let torchMode: TorchMode = 'none';
  let torchOn = false;

  function checkSupport(): MediaDevicesLike {
    if (deps.isSecureContext === false) {
      throw createCameraError('UNSUPPORTED_BROWSER', 'INSECURE_CONTEXT', INSECURE_CONTEXT_MESSAGE);
    }
    const md = deps.mediaDevices;
    if (!md || typeof md.getUserMedia !== 'function') throw createCameraError('UNSUPPORTED_BROWSER', 'NO_MEDIA_DEVICES');
    return md;
  }

  /** getUserMedia với chuỗi hạ ràng buộc; chỉ hạ khi gặp OverconstrainedError. */
  async function acquire(md: MediaDevicesLike): Promise<MediaStream> {
    let lastError: unknown;
    for (const [step, constraints] of CONSTRAINT_STEPS.entries()) {
      try {
        return await md.getUserMedia(constraints);
      } catch (err) {
        if (!isOverconstrainedError(err)) throw mapCameraError(err);
        log.warn(`Ràng buộc bước ${step} không thoả, hạ xuống bước kế`, err);
        lastError = err;
      }
    }
    throw mapCameraError(lastError);
  }

  /** Có nhiều camera sau thì chuyển sang camera chính. Lỗi ở bước chọn thì giữ stream hiện có. */
  async function preferMainCamera(md: MediaDevicesLike, current: MediaStream): Promise<MediaStream> {
    let targetId: string | null = null;
    try {
      const currentId = current.getVideoTracks()[0]?.getSettings().deviceId;
      if (md.enumerateDevices) targetId = pickMainBackCamera(await md.enumerateDevices(), currentId);
    } catch (err) {
      log.warn('Không liệt kê được camera, giữ camera mặc định', err);
    }
    if (targetId === null) return current;
    stopStream(current); // một số máy không mở được hai luồng cùng lúc
    try {
      return await md.getUserMedia({ audio: false, video: { deviceId: { exact: targetId }, ...IDEAL_SIZE, ...IDEAL_FPS } });
    } catch (err) {
      log.warn('Không mở được camera chính, quay về camera mặc định', err);
      return acquire(md);
    }
  }

  function readCapabilities(t: MediaStreamTrack): TrackCapabilitiesExt | undefined {
    try {
      return typeof t.getCapabilities === 'function' ? (t.getCapabilities() as unknown as TrackCapabilitiesExt) : undefined;
    } catch {
      return undefined;
    }
  }

  async function applyContinuousFocus(t: MediaStreamTrack): Promise<void> {
    if (readCapabilities(t)?.focusMode?.includes('continuous') !== true) return;
    const focus: ConstraintSetExt = { focusMode: 'continuous' };
    try {
      await t.applyConstraints({ advanced: [focus] });
    } catch (err) {
      log.warn('Không bật được lấy nét liên tục', err);
    }
  }

  /** Đèn: ưu tiên getUserMedia (capabilities.torch); không có thì hỏi cổng dự phòng. */
  async function detectTorch(t: MediaStreamTrack): Promise<TorchMode> {
    if (readCapabilities(t)?.torch === true) return 'track';
    try {
      if (port && (await port.isSupported())) return 'port';
    } catch (err) {
      log.warn('Cổng đèn dự phòng báo lỗi khi dò', err);
    }
    return 'none';
  }

  function close(): void {
    if (torchMode === 'port' && torchOn && port) void port.set(false).catch(() => undefined);
    if (track) track.onended = null;
    stopStream(stream);
    stream = null;
    track = null;
    torchMode = 'none';
    torchOn = false;
  }

  async function open(): Promise<MediaStream> {
    const md = checkSupport();
    close();
    let next = await acquire(md);
    try {
      next = await preferMainCamera(md, next);
      const videoTrack = next.getVideoTracks()[0];
      if (!videoTrack) throw createCameraError('CAMERA_FAILED', 'NO_VIDEO_TRACK');
      stream = next;
      track = videoTrack;
      await applyContinuousFocus(videoTrack);
      torchMode = await detectTorch(videoTrack);
      if (videoTrack.readyState === 'ended') throw createCameraError('CAMERA_IN_USE', 'ENDED_WHILE_OPENING');
      videoTrack.onended = () => {
        if (track === videoTrack) deps.onEnded();
      };
      return next;
    } catch (err) {
      stopStream(next);
      close();
      throw mapCameraError(err);
    }
  }

  async function setTorch(on: boolean): Promise<boolean> {
    if (torchMode === 'none' || track === null) return false;
    let ok = false;
    try {
      if (torchMode === 'track') {
        const torch: ConstraintSetExt = { torch: on };
        await track.applyConstraints({ advanced: [torch] });
        ok = true;
      } else if (port) {
        ok = await port.set(on);
      }
    } catch (err) {
      log.warn('Không điều khiển được đèn', err);
    }
    if (ok) torchOn = on;
    return ok;
  }

  return {
    open,
    close,
    isLive: () => track !== null && track.readyState === 'live',
    get torchSupported(): boolean {
      return torchMode !== 'none';
    },
    setTorch,
  };
}
</file>

<file path="src/camera/frame-capture.ts">
import type { CapturedFrame } from '../contracts';
import { createLogger } from '../utils/logger';
import { clamp } from '../utils/math';
import type { Clock } from '../utils/time';

const log = createLogger('camera:capture');

/** Tốc độ lấy mẫu cho phép (khung/giây): ngoài khoảng này thì bị kẹp. */
export const MIN_SAMPLING_FPS = 0.2;
export const MAX_SAMPLING_FPS = 30;
/** HTMLMediaElement.HAVE_CURRENT_DATA: đã có ít nhất một khung hình để chụp. */
const HAVE_CURRENT_DATA = 2;
/** Không thấy khung video nào trong ngần này thì bỏ requestVideoFrameCallback, chuyển sang hẹn giờ để vòng lặp không đứng im. */
const VIDEO_STALL_MS = 1000;

export type FrameHandler = (frame: CapturedFrame) => void | Promise<void>;

/** Bộ hẹn giờ được tiêm vào để test chạy bằng đồng hồ giả. */
export interface Scheduler {
  setTimeout(fn: () => void, ms: number): unknown;
  clearTimeout(handle: unknown): void;
}

export const systemScheduler: Scheduler = {
  setTimeout: (fn, ms) => globalThis.setTimeout(fn, ms),
  clearTimeout: (handle) => globalThis.clearTimeout(handle as ReturnType<typeof globalThis.setTimeout>),
};

/** Phần của HTMLVideoElement mà vòng lấy mẫu cần. */
export interface FrameSource {
  readonly readyState: number;
  readonly videoWidth: number;
  readonly videoHeight: number;
  requestVideoFrameCallback?(callback: () => void): number;
  cancelVideoFrameCallback?(handle: number): void;
}

export interface FrameCaptureDeps {
  source: FrameSource;
  /** Chụp khung hiện tại của video, thường là () => createImageBitmap(video). */
  createBitmap: () => Promise<ImageBitmap>;
  clock: Clock;
  scheduler: Scheduler;
  fps: number;
}

export interface FrameCapture {
  /** Đăng ký handler; trả về hàm huỷ đăng ký. */
  addHandler(handler: FrameHandler): () => void;
  /** Bắt đầu hoặc tiếp tục lấy mẫu; gọi khi đang chạy thì vô hại. */
  start(): void;
  /** Dừng và huỷ mọi hẹn giờ; handler đang chạy được chạy nốt. */
  stop(): void;
  /** Đổi tốc độ, có hiệu lực ngay cả khi đang chờ. Giá trị không hợp lệ bị bỏ qua. */
  setFps(fps: number): void;
}

/** fps hợp lệ thì kẹp vào [MIN, MAX]; NaN, vô cực, ≤ 0 thì trả `fallback`. */
export function sanitizeFps(fps: number, fallback: number): number {
  return Number.isFinite(fps) && fps > 0 ? clamp(fps, MIN_SAMPLING_FPS, MAX_SAMPLING_FPS) : fallback;
}

function closeQuietly(bitmap: ImageBitmap): void {
  try {
    bitmap.close();
  } catch (err) {
    log.debug('bitmap.close() lỗi', err);
  }
}

/**
 * Vòng lấy mẫu tuần tự có backpressure: chụp → gọi lần lượt các handler và CHỜ xong → mới tính lần kế.
 * Khoảng cách giữa hai lần BẮT ĐẦU chụp ≥ 1000/fps, đã trừ thời gian handler tiêu tốn.
 * Có requestVideoFrameCallback thì chụp ở khung video mới đầu tiên đã đủ khoảng cách; không thì dùng hẹn giờ.
 */
export function createFrameCapture(deps: FrameCaptureDeps): FrameCapture {
  const { source, createBitmap, clock, scheduler } = deps;
  const handlers = new Set<FrameHandler>();
  let fps = sanitizeFps(deps.fps, MIN_SAMPLING_FPS);
  let running = false;
  let busy = false;
  let failing = false; // createImageBitmap đang lỗi liên tục: chỉ log lần đầu
  let nextFrameId = 1;
  let lastStart = Number.NEGATIVE_INFINITY;
  let useVideoCallback = typeof source.requestVideoFrameCallback === 'function';
  let waitTimer: unknown = null;
  let stallTimer: unknown = null;
  let videoCallback: number | null = null;

  function clearPending(): void {
    if (waitTimer !== null) scheduler.clearTimeout(waitTimer);
    if (stallTimer !== null) scheduler.clearTimeout(stallTimer);
    if (videoCallback !== null) source.cancelVideoFrameCallback?.(videoCallback);
    waitTimer = stallTimer = videoCallback = null;
  }

  function schedule(): void {
    if (!running || busy) return;
    clearPending();
    if (useVideoCallback && source.requestVideoFrameCallback) {
      videoCallback = source.requestVideoFrameCallback(onVideoFrame);
      stallTimer = scheduler.setTimeout(onStall, VIDEO_STALL_MS);
    } else {
      waitTimer = scheduler.setTimeout(() => {
        waitTimer = null;
        void tick();
      }, Math.max(0, 1000 / fps - (clock() - lastStart)));
    }
  }

  /** Mỗi khung video mới chỉ kiểm tra đã đủ khoảng cách chưa: đủ thì chụp, chưa thì chờ khung kế. */
  function onVideoFrame(): void {
    if (clock() - lastStart < 1000 / fps) return schedule();
    clearPending();
    void tick();
  }

  function onStall(): void {
    log.warn('requestVideoFrameCallback không phản hồi, chuyển sang lấy mẫu bằng hẹn giờ');
    useVideoCallback = false;
    schedule();
  }

  async function tick(): Promise<void> {
    if (!running || busy) return;
    busy = true;
    lastStart = clock();
    try {
      await captureAndDeliver(lastStart);
    } catch (err) {
      log.error('Lỗi không mong đợi trong vòng lấy mẫu', err);
    } finally {
      busy = false;
    }
    schedule();
  }

  async function captureAndDeliver(timestamp: number): Promise<void> {
    if (source.readyState < HAVE_CURRENT_DATA || source.videoWidth <= 0 || source.videoHeight <= 0) return;
    let bitmap: ImageBitmap;
    try {
      bitmap = await createBitmap();
      failing = false;
    } catch (err) {
      if (!failing) log.warn('createImageBitmap(video) lỗi, bỏ qua khung này', err);
      failing = true;
      return;
    }
    if (!running || bitmap.width <= 0 || bitmap.height <= 0) return closeQuietly(bitmap);
    const frame: CapturedFrame = {
      bitmap,
      meta: { frameId: nextFrameId++, width: bitmap.width, height: bitmap.height, timestamp },
    };
    let called = 0;
    let failed = false;
    for (const handler of [...handlers]) {
      if (!handlers.has(handler)) continue;
      called += 1;
      try {
        await handler(frame);
      } catch (err) {
        failed = true;
        log.error('Handler onFrame ném lỗi, vòng lấy mẫu vẫn chạy', err);
      }
    }
    // Bên nhận tự close khi xử lý xong; chỉ đóng thay khi không ai nhận hoặc có handler lỗi.
    if (called === 0 || failed) closeQuietly(bitmap);
  }

  return {
    addHandler(handler) {
      handlers.add(handler);
      return () => void handlers.delete(handler);
    },
    start() {
      if (running) return;
      running = true;
      schedule();
    },
    stop() {
      running = false;
      clearPending();
    },
    setFps(next) {
      const valid = sanitizeFps(next, Number.NaN);
      if (Number.isNaN(valid)) return log.warn(`Bỏ qua tốc độ lấy mẫu không hợp lệ: ${String(next)}`);
      fps = valid;
      if (waitTimer !== null) schedule();
    },
  };
}
