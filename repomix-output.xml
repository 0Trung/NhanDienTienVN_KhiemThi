<file path="src/decision/state-manager.ts">
import type { AppState, SystemEvent } from '../contracts';

/** Nguyên nhân chuyển trạng thái đến từ kết quả phân tích khung hình (nhánh ANALYSIS dùng ở lượt 2). */
export type AnalysisTrigger =
  | 'NO_MONEY_SEEN'      // khung không có tiền → NO_CANDIDATE
  | 'UNCERTAIN_SEEN'     // chưa chắc, xung đột hoặc bị chặn → UNCERTAIN
  | 'OVERLAP_SEEN'       // chồng lấn → OVERLAPPING
  | 'UNSTABLE_SEEN'      // chắc nhưng chưa ổn định → STABILIZING
  | 'STEADY_SEEN'        // ổn định, đã công bố, không có gì mới → DETECTING
  | 'RESULT_PUBLISHED';  // công bố kết quả mới → SPEAKING

/** Mọi nguyên nhân có thể làm đổi trạng thái. */
export type StateTrigger = SystemEvent | 'FAILURE' | AnalysisTrigger;

/** Giai đoạn: khởi động, đang quét, đang đọc kết quả, lỗi. */
export type Phase = 'STARTUP' | 'SCANNING' | 'SPEAKING' | 'ERROR';

/** Ảnh chụp bất biến của máy. Hai cờ model/camera được ghi ở mọi trạng thái khởi động để không mất sự kiện đến sớm. */
export interface MachineSnapshot {
  readonly state: AppState;
  readonly modelReady: boolean;
  readonly cameraReady: boolean;
  readonly backgrounded: boolean;
}

export interface TransitionResult {
  /** false = chuyển trái phép, bị bỏ qua. */
  readonly accepted: boolean;
  readonly from: AppState;
  /** Bằng `from` khi bị bỏ qua hoặc không đổi. */
  readonly to: AppState;
  /** Ảnh chụp SAU khi áp dụng (chính ảnh đầu vào khi bị bỏ qua). */
  readonly snapshot: MachineSnapshot;
  /** [] khi hợp lệ; ['ILLEGAL_TRANSITION', 'NGUYÊN_NHÂN@TRẠNG_THÁI'] khi bị bỏ qua. */
  readonly reasons: readonly string[];
}

export const INITIAL_SNAPSHOT: MachineSnapshot = Object.freeze({
  state: 'INITIALIZING',
  modelReady: false,
  cameraReady: false,
  backgrounded: false,
});

type Row = Readonly<Partial<Record<StateTrigger, AppState>>>;

/** Hàng chung của mọi trạng thái đang quét; trở lại từ nền thì về DETECTING. */
function scanningRow(self: AppState): Row {
  return {
    NO_MONEY_SEEN: 'NO_CANDIDATE', UNCERTAIN_SEEN: 'UNCERTAIN', OVERLAP_SEEN: 'OVERLAPPING',
    UNSTABLE_SEEN: 'STABILIZING', STEADY_SEEN: 'DETECTING', RESULT_PUBLISHED: 'SPEAKING',
    MODEL_READY: self, CAMERA_READY: self, APP_BACKGROUNDED: self, APP_FOREGROUNDED: 'DETECTING', FAILURE: 'ERROR',
  };
}

/** Hàng của trạng thái khởi động: ghi cờ và nền/trở lại giữ nguyên; `own` thêm hoặc đè các cạnh riêng. */
function startupRow(self: AppState, own: Row): Row {
  return { MODEL_READY: self, CAMERA_READY: self, APP_BACKGROUNDED: self, APP_FOREGROUNDED: self, FAILURE: 'ERROR', ...own };
}

/**
 * Bảng chuyển: TRANSITIONS[trạng thái hiện tại][nguyên nhân] = trạng thái kế tiếp; ô vắng = trái phép.
 * RESULT_READY là trạng thái dành riêng: engine công bố kết quả đi thẳng sang SPEAKING nên không dừng ở đó.
 * Hai quy tắc phụ nằm trong `transition`.
 */
export const TRANSITIONS: Readonly<Record<AppState, Row>> = {
  INITIALIZING: startupRow('INITIALIZING', { APP_STARTED: 'AWAITING_START' }),
  AWAITING_START: startupRow('AWAITING_START', { GESTURE_UNLOCKED: 'LOADING_MODEL' }),
  LOADING_MODEL: startupRow('LOADING_MODEL', { PERMISSION_REQUESTED: 'WAITING_PERMISSION' }),
  WAITING_PERMISSION: startupRow('WAITING_PERMISSION', { CAMERA_READY: 'LOADING_MODEL' }),
  READY: scanningRow('READY'),
  NO_CANDIDATE: scanningRow('NO_CANDIDATE'),
  DETECTING: scanningRow('DETECTING'),
  UNCERTAIN: scanningRow('UNCERTAIN'),
  OVERLAPPING: scanningRow('OVERLAPPING'),
  STABILIZING: scanningRow('STABILIZING'),
  RESULT_READY: scanningRow('RESULT_READY'),
  SPEAKING: {
    RESULT_SPEECH_ENDED: 'DETECTING', MODEL_READY: 'SPEAKING', CAMERA_READY: 'SPEAKING',
    APP_BACKGROUNDED: 'SPEAKING', APP_FOREGROUNDED: 'DETECTING', FAILURE: 'ERROR',
  },
  ERROR: { APP_BACKGROUNDED: 'ERROR', APP_FOREGROUNDED: 'ERROR', FAILURE: 'ERROR' },
};

/** Giai đoạn của một trạng thái, suy ra từ bảng: trạng thái nhận kết quả phân tích là đang quét. */
export function phaseOf(state: AppState): Phase {
  if (state === 'ERROR' || state === 'SPEAKING') return state;
  return TRANSITIONS[state].STEADY_SEEN === undefined ? 'STARTUP' : 'SCANNING';
}

/**
 * Áp dụng một nguyên nhân lên ảnh chụp hiện tại (hàm thuần, không sửa đầu vào). Ngoài bảng có hai quy tắc:
 * 1. PERMISSION_REQUESTED bị bỏ qua khi camera đã sẵn sàng (quyền đã xong, không xin lại).
 * 2. Nếu đích là LOADING_MODEL hoặc WAITING_PERMISSION mà đã đủ MODEL_READY và CAMERA_READY thì đích là READY.
 *    Cờ được ghi từ mọi trạng thái khởi động, nhưng READY chỉ đạt được sau GESTURE_UNLOCKED
 *    (chưa có thao tác chạm thì chưa nói được).
 */
export function transition(current: MachineSnapshot, trigger: StateTrigger): TransitionResult {
  const target = TRANSITIONS[current.state][trigger];
  if (target === undefined || (trigger === 'PERMISSION_REQUESTED' && current.cameraReady)) {
    return {
      accepted: false,
      from: current.state,
      to: current.state,
      snapshot: current,
      reasons: ['ILLEGAL_TRANSITION', `${trigger}@${current.state}`],
    };
  }
  const modelReady = current.modelReady || trigger === 'MODEL_READY';
  const cameraReady = current.cameraReady || trigger === 'CAMERA_READY';
  const backgrounded = trigger === 'APP_BACKGROUNDED' ? true : trigger === 'APP_FOREGROUNDED' ? false : current.backgrounded;
  const waiting = target === 'LOADING_MODEL' || target === 'WAITING_PERMISSION';
  const to: AppState = waiting && modelReady && cameraReady ? 'READY' : target;
  return { accepted: true, from: current.state, to, snapshot: { state: to, modelReady, cameraReady, backgrounded }, reasons: [] };
}
</file>

<file path="src/offline/key-value-port.ts">
import { AppError } from '../contracts';

/**
 * Cổng khóa–giá trị nhỏ nhất mà kho cài đặt cần.
 * Quy ước: mọi lỗi của nơi lưu phải nổi lên dưới dạng AppError STORAGE_FAILED
 * để kho cài đặt biết đường rơi về bản dự phòng.
 */
export interface KeyValuePort {
  get(key: string): Promise<string | null>;
  set(key: string, value: string): Promise<void>;
  remove(key: string): Promise<void>;
}

/** Phần của plugin Preferences mà adapter dùng: get/set/remove nhận một đối tượng tùy chọn, get trả { value }. */
export interface PreferencesLike {
  get(options: { key: string }): Promise<{ value: string | null }>;
  set(options: { key: string; value: string }): Promise<void>;
  remove(options: { key: string }): Promise<void>;
}

/** Phần của Storage (localStorage) mà adapter dùng. */
export interface StorageLike {
  getItem(key: string): string | null;
  setItem(key: string, value: string): void;
  removeItem(key: string): void;
}

type Action = 'đọc' | 'lưu' | 'xóa';

/** Chạy một thao tác lưu trữ; mọi lỗi (kể cả ném đồng bộ) được gói thành AppError STORAGE_FAILED. */
async function guard<T>(action: Action, fn: () => T | Promise<T>): Promise<T> {
  try {
    return await fn();
  } catch (e) {
    throw new AppError('STORAGE_FAILED', `Không ${action} được cài đặt.`, false, e);
  }
}

/** Bản trong bộ nhớ: không bao giờ lỗi, mất khi app tắt. */
export function createMemoryPort(): KeyValuePort {
  const data = new Map<string, string>();
  return {
    get: async (key) => data.get(key) ?? null,
    set: async (key, value) => {
      data.set(key, value);
    },
    remove: async (key) => {
      data.delete(key);
    },
  };
}

/** localStorage của WebView; null khi không có hoặc bị chặn (truy cập có thể ném SecurityError). */
export function getLocalStorage(): StorageLike | null {
  try {
    return typeof localStorage === 'undefined' ? null : localStorage;
  } catch {
    return null;
  }
}

/** Bản localStorage. `storage` null thì mọi thao tác đều lỗi STORAGE_FAILED (để rơi về bản kế tiếp). */
export function createLocalStoragePort(storage: StorageLike | null = getLocalStorage()): KeyValuePort {
  const need = (): StorageLike => {
    if (!storage) throw new Error('localStorage không dùng được');
    return storage;
  };
  return {
    get: (key) => guard('đọc', () => need().getItem(key)),
    set: (key, value) => guard('lưu', () => need().setItem(key, value)),
    remove: (key) => guard('xóa', () => need().removeItem(key)),
  };
}

/**
 * Nạp plugin Preferences. ĐÂY LÀ NƠI DUY NHẤT trong mã nguồn được import plugin này.
 * Plugin Capacitor là một Proxy: trả thẳng nó qua async/Promise sẽ làm Promise gọi `.then` của nó
 * ("Preferences.then() is not implemented") và treo mãi, nên chỉ trả một đối tượng thường bọc ba hàm cần dùng.
 */
async function loadPreferencesPlugin(): Promise<PreferencesLike> {
  const { Preferences } = await import('@capacitor/preferences');
  return {
    get: (options) => Preferences.get(options),
    set: (options) => Preferences.set(options),
    remove: (options) => Preferences.remove(options),
  };
}

/** Bản Preferences (lưu native trong APK). `load` tiêm được để test chạy trong Node. */
export function createPreferencesPort(load: () => Promise<PreferencesLike> = loadPreferencesPlugin): KeyValuePort {
  let cached: Promise<PreferencesLike> | null = null;
  const plugin = (): Promise<PreferencesLike> => {
    cached ??= load().catch((e: unknown) => {
      cached = null; // lần sau cho phép nạp lại
      throw e;
    });
    return cached;
  };
  return {
    get: (key) =>
      guard('đọc', async () => {
        const { value } = await (await plugin()).get({ key });
        return typeof value === 'string' ? value : null;
      }),
    set: (key, value) => guard('lưu', async () => (await plugin()).set({ key, value })),
    remove: (key) => guard('xóa', async () => (await plugin()).remove({ key })),
  };
}

export interface DefaultPortsOptions {
  /** true khi chạy trong APK (getPlatform() === 'android-native'): ưu tiên Preferences. */
  native: boolean;
  /** Ghi đè localStorage (dùng khi test); null nghĩa là không có. Bỏ trống thì dùng localStorage thật nếu có. */
  storage?: StorageLike | null;
  /** Ghi đè cách nạp plugin Preferences (dùng khi test). */
  loadPreferences?: () => Promise<PreferencesLike>;
}

/** Các cổng bền theo thứ tự ưu tiên: Preferences (chỉ khi native) rồi localStorage. Bộ nhớ trong do kho cài đặt tự thêm cuối. */
export function createDefaultPorts(o: DefaultPortsOptions): KeyValuePort[] {
  const ports: KeyValuePort[] = [];
  if (o.native) ports.push(createPreferencesPort(o.loadPreferences));
  const storage = o.storage === undefined ? getLocalStorage() : o.storage;
  if (storage) ports.push(createLocalStoragePort(storage));
  return ports;
}
</file>

<file path="src/offline/privacy-guard.ts">
import { AppError } from '../contracts';

/** Mảng byte lớn hơn mức này (4 KB) bị coi là có thể chứa ảnh. */
export const MAX_BINARY_BYTES = 4 * 1024;
/** Độ sâu tối đa khi duyệt giá trị lồng nhau; sâu hơn thì không kiểm chứng được nên từ chối. */
const MAX_DEPTH = 8;

/** Kiểu đối tượng luôn bị chặn, nhỏ hay lớn đều không được lưu (ảnh và khối nhị phân dạng tệp). */
const BLOCKED_TYPES: ReadonlySet<string> = new Set([
  'ImageBitmap',
  'ImageData',
  'Blob',
  'File',
  'VideoFrame',
  'OffscreenCanvas',
  'HTMLCanvasElement',
]);
const DATA_IMAGE = /^\s*data:image/i;

interface Finding {
  path: string;
  reason: string;
}

/** Nhãn kiểu theo Symbol.toStringTag, đúng cả khi khác realm. */
function typeOf(value: object): string {
  return Object.prototype.toString.call(value).slice(8, -1);
}

/** Nhận diện ImageBitmap theo hình dạng (width, height, close) phòng khi môi trường không có lớp thật, như Node hay đồ giả. */
function looksLikeBitmap(value: object): boolean {
  const o = value as { width?: unknown; height?: unknown; close?: unknown };
  return typeof o.close === 'function' && typeof o.width === 'number' && typeof o.height === 'number';
}

/** Số byte nếu value là ArrayBuffer hoặc TypedArray/DataView, ngược lại null. */
function byteLengthOf(value: object, type: string): number | null {
  if (ArrayBuffer.isView(value)) return value.byteLength;
  if (type === 'ArrayBuffer' || type === 'SharedArrayBuffer') return (value as ArrayBuffer).byteLength;
  return null;
}

function inspect(value: unknown, path: string, depth: number, seen: WeakSet<object>): Finding | null {
  if (typeof value === 'string') return DATA_IMAGE.test(value) ? { path, reason: 'chuỗi data:image' } : null;
  if (typeof value !== 'object' || value === null || seen.has(value)) return null;
  seen.add(value);

  const type = typeOf(value);
  if (BLOCKED_TYPES.has(type)) return { path, reason: type };
  if (looksLikeBitmap(value)) return { path, reason: 'ImageBitmap' };

  const bytes = byteLengthOf(value, type);
  if (bytes !== null) return bytes > MAX_BINARY_BYTES ? { path, reason: `mảng byte ${bytes} byte` } : null;

  if (depth >= MAX_DEPTH) return { path, reason: 'lồng quá sâu, không kiểm chứng được' };
  for (const [key, child] of Object.entries(value)) {
    const found = inspect(child, `${path}.${key}`, depth + 1, seen);
    if (found) return found;
  }
  return null;
}

/**
 * Ném AppError STORAGE_FAILED nếu giá trị sắp lưu chứa ảnh: ImageBitmap, ImageData, Blob (cùng File, VideoFrame, canvas),
 * ArrayBuffer/TypedArray lớn hơn 4 KB, hoặc chuỗi bắt đầu bằng data:image. Duyệt cả giá trị lồng nhau.
 * `detail` của lỗi chỉ ghi đường dẫn và lý do, KHÔNG chứa dữ liệu.
 */
export function assertNoImageData(value: unknown): void {
  const found = inspect(value, '$', 0, new WeakSet());
  if (found) {
    throw new AppError('STORAGE_FAILED', `Từ chối lưu dữ liệu hình ảnh (${found.reason}) tại "${found.path}".`, false, found);
  }
}
</file>

<file path="src/utils/event-bus.ts">
import { createLogger } from './logger';

const log = createLogger('event-bus');

type StoredHandler = (payload: unknown) => void;
interface Entry { readonly handler: StoredHandler }

export interface EventBus<E extends Record<string, unknown>> {
  on<K extends keyof E>(k: K, h: (p: E[K]) => void): () => void;
  off<K extends keyof E>(k: K, h: (p: E[K]) => void): void;
  emit<K extends keyof E>(k: K, p: E[K]): void;
}

/**
 * Bus sự kiện nhỏ, có kiểu theo bản đồ sự kiện E.
 * - on trả về hàm hủy đăng ký.
 * - Lỗi ném ra trong một handler được ghi log và KHÔNG ảnh hưởng handler khác.
 * - emit duyệt trên bản chụp danh sách, nên handler tự hủy trong lúc emit không làm mất handler kế tiếp.
 */
export function createEventBus<E extends Record<string, unknown>>(): EventBus<E> {
  const registry = new Map<keyof E, Entry[]>();

  function removeEntry(key: keyof E, entry: Entry): void {
    const list = registry.get(key);
    if (!list) return;
    const index = list.indexOf(entry);
    if (index === -1) return;
    list.splice(index, 1);
    if (list.length === 0) registry.delete(key);
  }

  function on<K extends keyof E>(k: K, h: (p: E[K]) => void): () => void {
    const entry: Entry = { handler: h as StoredHandler };
    const list = registry.get(k);
    if (list) list.push(entry);
    else registry.set(k, [entry]);
    return () => removeEntry(k, entry);
  }

  function off<K extends keyof E>(k: K, h: (p: E[K]) => void): void {
    const list = registry.get(k);
    const entry = list?.find((e) => e.handler === (h as StoredHandler));
    if (entry) removeEntry(k, entry);
  }

  function emit<K extends keyof E>(k: K, p: E[K]): void {
    const list = registry.get(k);
    if (!list || list.length === 0) return;
    for (const entry of list.slice()) {
      try {
        entry.handler(p);
      } catch (err) {
        log.error(`Handler của sự kiện "${String(k)}" ném lỗi`, err);
      }
    }
  }

  return { on, off, emit };
}
</file>

