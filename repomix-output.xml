<file path="src/analyzer/brightness-analyzer.ts">
import type { FrameAnalysis, GrayImage } from '../contracts';
import { mean } from '../utils/math';

/** Kết quả đo độ sáng, đúng phần tương ứng của FrameAnalysis['quality']. */
export type BrightnessInfo = Pick<FrameAnalysis['quality'], 'brightness' | 'lowLight'>;

/**
 * Đo độ sáng trung bình của ảnh xám.
 * brightness là trung bình cộng mọi điểm ảnh, thang 0..255 (0 = đen, 255 = trắng);
 * lowLight = brightness < lowLightMean (nghiêm ngặt, đúng ranh thì chưa coi là thiếu sáng).
 * Ảnh rỗng (không có điểm ảnh) cho brightness = 0 và lowLight = true: không đo được thì coi là tối.
 *
 * @param gray Ảnh xám 1 kênh, mỗi điểm 0..255.
 * @param lowLightMean Ngưỡng thiếu sáng, thang 0..255 (config.analyzer.lowLightMean).
 */
export function measureBrightness(gray: GrayImage, lowLightMean: number): BrightnessInfo {
  const brightness = mean(gray.data);
  return { brightness, lowLight: brightness < lowLightMean };
}
</file>

<file path="src/analyzer/confidence-analyzer.ts">
import type { Detection } from '../contracts';

/**
 * Kết quả tách detection theo độ tin cậy.
 * Cả ba mảng giữ NGUYÊN THỨ TỰ của đầu vào (trái → phải) và chứa chính các đối tượng Detection đầu vào (không sao chép).
 */
export interface ConfidenceSplit {
  /** Độ tin cậy ≥ confSure. */
  sure: Detection[];
  /** confLow ≤ độ tin cậy < confSure. */
  unsure: Detection[];
  /** Hợp của sure và unsure, tức mọi detection có độ tin cậy ≥ confLow, theo đúng thứ tự đầu vào. */
  kept: Detection[];
}

/**
 * Tách detection thành "chắc" và "chưa chắc".
 * - confidence ≥ confSure → sure (đúng ranh thì tính là chắc).
 * - confLow ≤ confidence < confSure → unsure (đúng ranh confLow thì còn giữ).
 * - confidence < confLow hoặc NaN → bị loại khỏi cả ba mảng (so sánh với NaN luôn sai nên thà loại còn hơn tin).
 * Hàm thuần, không sửa đầu vào.
 * @param detections Danh sách detection của một khung hình.
 * @param confLow Ngưỡng thấp nhất còn xét, độ tin cậy không đơn vị trong [0, 1] (config.inference.confLow).
 * @param confSure Ngưỡng đủ chắc, độ tin cậy không đơn vị trong [0, 1] (config.inference.confSure).
 */
export function splitByConfidence(
  detections: readonly Detection[],
  confLow: number,
  confSure: number,
): ConfidenceSplit {
  const sure: Detection[] = [];
  const unsure: Detection[] = [];
  const kept: Detection[] = [];
  for (const d of detections) {
    if (d.confidence >= confSure) {
      sure.push(d);
      kept.push(d);
    } else if (d.confidence >= confLow) {
      unsure.push(d);
      kept.push(d);
    }
  }
  return { sure, unsure, kept };
}
</file>

<file path="src/analyzer/conflict-detector.ts">
import type { Detection, FrameAnalysis } from '../contracts';
import { iou, isValidBox } from '../utils/geometry';

/** Kết quả phát hiện xung đột lớp, đúng kiểu FrameAnalysis['conflict']. */
export type ConflictInfo = FrameAnalysis['conflict'];

/**
 * Phát hiện xung đột lớp: hai hộp gần như cùng một vật (IoU ≥ conflictIou) nhưng KHÁC mệnh giá,
 * nghĩa là mô hình đang phân vân giữa hai mệnh giá cho cùng một tờ tiền.
 * So sánh theo mệnh giá (denomination), không theo classId.
 * Hộp suy biến (không hợp lệ theo isValidBox) bị bỏ qua. Cùng mệnh giá thì không bao giờ là xung đột.
 *
 * @param detections Detection của khung hình, hộp theo pixel trong khung gốc.
 * @param conflictIou Ngưỡng IoU, không đơn vị trong [0, 1] (config.analyzer.conflictIou).
 * @returns detected: có cặp xung đột; pairs: cặp id (theo thứ tự đầu vào).
 */
export function detectClassConflict(detections: readonly Detection[], conflictIou: number): ConflictInfo {
  const pairs: Array<[string, string]> = [];
  for (let i = 0; i < detections.length; i++) {
    const a = detections[i];
    if (a === undefined || !isValidBox(a.bbox)) continue;
    for (let j = i + 1; j < detections.length; j++) {
      const b = detections[j];
      if (b === undefined || !isValidBox(b.bbox)) continue;
      if (a.denomination === b.denomination) continue;
      if (iou(a.bbox, b.bbox) >= conflictIou) pairs.push([a.id, b.id]);
    }
  }
  return { detected: pairs.length > 0, pairs };
}
</file>

<file path="src/analyzer/frame-analyzer.ts">
import type { AppConfig, Detection, FrameAnalysis, IFrameAnalyzer, InferenceResult } from '../contracts';
import { center } from '../utils/geometry';
import { measureBlur } from './blur-detector';
import { measureBrightness } from './brightness-analyzer';
import { splitByConfidence } from './confidence-analyzer';
import { detectClassConflict } from './conflict-detector';
import { detectOverlap } from './overlap-detector';
import { analyzePosition } from './position-analyzer';
import { createTemporalStabilizer, isFrameValid } from './temporal-stabilizer';

/** Sắp từ trái sang phải (tâm x tăng dần, hòa thì theo tâm y), ổn định. Trả mảng mới, không sửa đầu vào. */
function sortLeftToRight(detections: readonly Detection[]): Detection[] {
  return [...detections].sort((a, b) => {
    const ca = center(a.bbox);
    const cb = center(b.bbox);
    return ca.x - cb.x || ca.y - cb.y;
  });
}

/**
 * Tạo bộ phân tích khung hình. Chỉ MÔ TẢ khung hình (chắc hay không, chồng lấn, xung đột, vị trí, mờ, tối, ổn định),
 * tuyệt đối không quyết định đọc hay không, không nói, không tính tổng.
 *
 * Mỗi lần analyze: sắp detection trái → phải, tách sure/unsure (A1), rồi chạy A2 đến A6 trên mọi detection có
 * độ tin cậy ≥ confLow (cả chắc lẫn chưa chắc), cuối cùng đưa khung vào bộ ổn định (A7).
 * Ngưỡng: confLow, confSure lấy từ config.inference; mọi ngưỡng còn lại từ config.analyzer. Không có hằng số ma thuật.
 * Trạng thái duy nhất giữ lại giữa các khung: cửa sổ của bộ ổn định và emptyStreak.
 * Không sửa InferenceResult đầu vào; kết quả dùng mảng mới (các đối tượng Detection được dùng chung với đầu vào).
 * Ném RangeError nếu config.analyzer.stabilizer không hợp lệ (xem createTemporalStabilizer).
 *
 * @param config Cấu hình ứng dụng (DEFAULT_CONFIG hoặc bản đã hiệu chỉnh).
 */
export function createFrameAnalyzer(config: AppConfig): IFrameAnalyzer {
  const { inference, analyzer } = config;
  const stabilizer = createTemporalStabilizer(analyzer.stabilizer);
  let emptyStreak = 0;

  /** Phân tích một kết quả suy luận; meta.timestamp (mili-giây) là mốc thời gian cho cửa sổ ổn định. */
  function analyze(r: InferenceResult): FrameAnalysis {
    const { sure, unsure, kept } = splitByConfidence(sortLeftToRight(r.detections), inference.confLow, inference.confSure);
    const overlap = detectOverlap(kept, analyzer.overlapRatio);
    const conflict = detectClassConflict(kept, analyzer.conflictIou);
    const position = analyzePosition(kept, r.meta, analyzer.minAreaRatio, analyzer.edgeMarginRatio);
    const blur = measureBlur(r.gray, r.meta, kept.map((d) => d.bbox), analyzer.blurThreshold);
    const brightness = measureBrightness(r.gray, analyzer.lowLightMean);

    const stability = stabilizer.push({
      timestamp: r.meta.timestamp,
      valid: isFrameValid({ sure, unsure, overlap, conflict }),
      sure,
    });
    emptyStreak = kept.length === 0 ? emptyStreak + 1 : 0;

    return {
      meta: { ...r.meta },
      detections: kept,
      sure,
      unsure,
      overlap,
      conflict,
      position,
      quality: { ...blur, ...brightness },
      stability,
      emptyStreak,
    };
  }

  /** Xóa cửa sổ ổn định và đưa emptyStreak về 0 (ví dụ khi camera tạm dừng rồi chạy lại). */
  function reset(): void {
    stabilizer.reset();
    emptyStreak = 0;
  }

  return { analyze, reset };
}
</file>

<file path="src/analyzer/overlap-detector.ts">
import type { Detection, FrameAnalysis } from '../contracts';
import { isValidBox, overlapOverMin } from '../utils/geometry';

/** Kết quả phát hiện chồng lấn, đúng kiểu FrameAnalysis['overlap']. */
export type OverlapInfo = FrameAnalysis['overlap'];

/**
 * Phát hiện các tờ tiền chồng lên nhau.
 *
 * Với mọi cặp hộp: ratio = diện tích giao / diện tích hộp NHỎ HƠN (overlapOverMin, không đơn vị, trong [0, 1]).
 * Cặp có ratio > overlapRatio (so sánh nghiêm ngặt) là chồng lấn.
 * Hộp suy biến (không hợp lệ theo isValidBox) bị bỏ qua hoàn toàn, không tạo cặp nào.
 *
 * LƯU Ý HIỆU CHỈNH: hai tờ đặt NGHIÊNG cạnh nhau có hộp bao (hộp song song với trục ảnh)
 * có thể chồng nhau dù hai tờ thật không chồng. Vì vậy ngưỡng overlapRatio phải được
 * hiệu chỉnh bằng ảnh thật trên điện thoại, không tin giá trị mặc định.
 *
 * @param detections Detection của khung hình, hộp theo pixel trong khung gốc.
 * @param overlapRatio Ngưỡng chồng lấn, không đơn vị (config.analyzer.overlapRatio).
 * @returns detected: có cặp chồng lấn; maxRatio: ratio lớn nhất trong mọi cặp hợp lệ (0 nếu không có cặp);
 *          pairs: cặp id (theo thứ tự đầu vào) có ratio > overlapRatio.
 */
export function detectOverlap(detections: readonly Detection[], overlapRatio: number): OverlapInfo {
  const pairs: Array<[string, string]> = [];
  let maxRatio = 0;
  for (let i = 0; i < detections.length; i++) {
    const a = detections[i];
    if (a === undefined || !isValidBox(a.bbox)) continue;
    for (let j = i + 1; j < detections.length; j++) {
      const b = detections[j];
      if (b === undefined || !isValidBox(b.bbox)) continue;
      const ratio = overlapOverMin(a.bbox, b.bbox);
      if (ratio > maxRatio) maxRatio = ratio;
      if (ratio > overlapRatio) pairs.push([a.id, b.id]);
    }
  }
  return { detected: pairs.length > 0, maxRatio, pairs };
}
</file>

<file path="src/analyzer/position-analyzer.ts">
import type { Detection, FrameAnalysis, FrameMeta } from '../contracts';
import { area } from '../utils/geometry';

/** Kết quả phân tích vị trí, đúng kiểu FrameAnalysis['position']. */
export type PositionInfo = FrameAnalysis['position'];

/**
 * Mô tả vị trí các tờ tiền so với khung hình.
 * - tooSmall: có ít nhất một hộp với (diện tích hộp / diện tích khung) < minAreaRatio. Hộp suy biến có diện tích 0 nên tính là nhỏ.
 * - partial: có ít nhất một hộp chạm mép khung, tức mép hộp cách mép khung không quá
 *   edgeMarginRatio × cạnh NGẮN của khung (biên tính bằng pixel, so sánh bao gồm đúng ranh).
 *   Hộp tràn ra ngoài khung cũng tính là chạm mép.
 * - Không có detection nào: cả hai đều false.
 * - Kích thước khung không hợp lệ (không hữu hạn hoặc ≤ 0) mà có detection: không kiểm chứng được hộp
 *   có đủ lớn và nằm trọn trong khung, nên theo nguyên tắc Fail Safe trả cả hai true.
 *
 * @param detections Detection của khung hình, hộp theo pixel trong khung gốc.
 * @param frame Kích thước khung gốc, pixel (FrameMeta.width, FrameMeta.height).
 * @param minAreaRatio Tỷ lệ diện tích tối thiểu, không đơn vị (config.analyzer.minAreaRatio).
 * @param edgeMarginRatio Biên mép, tỷ lệ của cạnh ngắn khung, không đơn vị (config.analyzer.edgeMarginRatio).
 */
export function analyzePosition(
  detections: readonly Detection[],
  frame: Pick<FrameMeta, 'width' | 'height'>,
  minAreaRatio: number,
  edgeMarginRatio: number,
): PositionInfo {
  if (detections.length === 0) return { tooSmall: false, partial: false };

  const { width, height } = frame;
  const frameArea = width * height;
  if (!Number.isFinite(frameArea) || !(width > 0) || !(height > 0)) {
    return { tooSmall: true, partial: true };
  }

  const marginPx = edgeMarginRatio * Math.min(width, height);
  let tooSmall = false;
  let partial = false;
  for (const { bbox } of detections) {
    if (area(bbox) / frameArea < minAreaRatio) tooSmall = true;
    if (bbox.x1 <= marginPx || bbox.y1 <= marginPx || bbox.x2 >= width - marginPx || bbox.y2 >= height - marginPx) {
      partial = true;
    }
  }
  return { tooSmall, partial };
}
</file>

