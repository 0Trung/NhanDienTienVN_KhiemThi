  it('nhịp giữa chừng lỗi thì chỉ rung nốt phần còn lại bằng navigator.vibrate', async () => {
    const env = setup({ port: (i) => (i === 2 ? 'false' : 'ok'), web: true });
    env.service.play('ERROR');
    env.timers.advance(1000);
