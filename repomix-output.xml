<file path="src/vision/decode.ts">
import { AppError } from '../contracts';
import type { BBox, RawModelOutput } from '../contracts';

/** Bố cục tensor đầu ra của YOLO: channels_first = [1, 4+nc, N]; channels_last = [1, N, 4+nc]. */
export type OutputLayout = 'channels_first' | 'channels_last';

/** Số kênh toạ độ đứng đầu mỗi anchor: tâm x, tâm y, rộng, cao (pixel của ảnh vuông S×S). */
export const BOX_CHANNELS = 4;

/** Số ứng viên tối đa được giữ lại trước NMS (F3). */
export const MAX_NMS_CANDIDATES = 300;

/** Số cột của đầu ra đã nhúng NMS: [1, N, 6] = x1, y1, x2, y2, điểm, lớp. */
const EMBEDDED_NMS_COLUMNS = 6;

/** Hình dạng đã nhận diện của tensor đầu ra. */
export interface TensorLayout {
  layout: OutputLayout;
  /** N: số anchor, lấy từ dims (không hard-code). */
  anchors: number;
  /** 4 + nc. */
  channels: number;
}

function structuralError(message: string, dims: readonly number[]): AppError {
  return new AppError('INFERENCE_FAILED', message, true, { dims: [...dims] });
}

/**
 * F1: nhận diện bố cục từ dims với nc = classCount.
 * Dims quyết định bố cục; `hint` chỉ dùng để hoà khi cả hai cách đọc cùng khớp (ví dụ [1, 13, 13]),
 * không có hint thì mặc định channels_first (đầu ra chuẩn của YOLO11).
 * Ném AppError INFERENCE_FAILED (fatal) nêu dims nhận được và dims mong đợi khi không khớp;
 * riêng dạng [1, N, 6] (NMS nhúng sẵn) có thông điệp hướng dẫn xuất lại với nms=False.
 */
export function resolveLayout(dims: readonly number[], classCount: number, hint?: OutputLayout): TensorLayout {
  const channels = BOX_CHANNELS + classCount;
  const got = `[${dims.join(', ')}]`;
  const expected = `[1, ${channels}, N] (channels_first) hoặc [1, N, ${channels}] (channels_last), nc = ${classCount}`;
  const [batch, d1, d2] = dims;
  if (
    dims.length !== 3 || batch !== 1 || d1 === undefined || d2 === undefined ||
    !dims.every((d) => Number.isInteger(d) && d > 0)
  ) {
    throw structuralError(`Dims đầu ra không hợp lệ: nhận ${got}, mong đợi ${expected}.`, dims);
  }

  const firstMatches = d1 === channels;
  const lastMatches = d2 === channels;
  if (!firstMatches && !lastMatches) {
    if (d2 === EMBEDDED_NMS_COLUMNS) {
      throw structuralError(
        `Đầu ra ${got} có dạng [1, N, 6]: mô hình đã nhúng NMS nên không dùng được. ` +
          `Hãy xuất lại ONNX với nms=False (mong đợi ${expected}).`,
        dims,
      );
    }
    throw structuralError(`Dims đầu ra không khớp: nhận ${got}, mong đợi ${expected}.`, dims);
  }

  let layout: OutputLayout;
  if (firstMatches && lastMatches) layout = hint ?? 'channels_first';
  else layout = firstMatches ? 'channels_first' : 'channels_last';
  return { layout, anchors: layout === 'channels_first' ? d2 : d1, channels };
}

/**
 * F2 + F3: giải mã anchor thành ứng viên, giữ bộ nhớ tạm giữa các khung (F8).
 * Mọi mảng được cấp phát một lần rồi ghi đè; chỉ lớn thêm khi gặp tensor có nhiều anchor hơn trước.
 */
export class AnchorDecoder {
  /** Số ứng viên của khung vừa giải mã; boxes, classIds, scores chỉ có nghĩa ở [0, count). */
  count = 0;
  /** Hộp x1, y1, x2, y2 trong hệ toạ độ ảnh vuông S×S, sắp theo điểm GIẢM DẦN. Đối tượng bị ghi đè ở khung sau. */
  readonly boxes: BBox[] = [];
  readonly classIds = new Int32Array(MAX_NMS_CANDIDATES);
  readonly scores = new Float32Array(MAX_NMS_CANDIDATES);

  // Vùng nháp theo anchor đã qua ngưỡng (chưa cắt trần, chưa sắp).
  private anchorOf = new Int32Array(0);
  private classOf = new Int32Array(0);
  private scoreOf = new Float32Array(0);
  private order = new Int32Array(0);

  /** Điểm cao hơn đứng trước; hoà điểm thì anchor có chỉ số nhỏ hơn đứng trước (kết quả xác định). */
  private readonly byScoreDesc = (a: number, b: number): number => {
    const sa = this.scoreOf[a] ?? 0;
    const sb = this.scoreOf[b] ?? 0;
    if (sa !== sb) return sa > sb ? -1 : 1;
    return a - b;
  };

  /**
   * Giải mã một tensor. Với mỗi anchor, lớp thắng là argmax điểm lớp (hoà thì lớp nhỏ hơn), không có objectness;
   * anchor được giữ khi điểm > confLow (so sánh nghiêm ngặt, ở độ chính xác float32 như giai_ma của bản mẫu P01).
   * Rồi giữ tối đa MAX_NMS_CANDIDATES điểm cao nhất và đổi tâm-rộng-cao sang x1, y1, x2, y2.
   * Anchor có toạ độ không hữu hạn bị bỏ và không chiếm chỗ. Trả về số ứng viên.
   */
  decode(raw: RawModelOutput, layout: TensorLayout, confLow: number): number {
    const { data } = raw;
    const { anchors, channels } = layout;
    if (data.length !== anchors * channels) {
      throw new AppError(
        'INFERENCE_FAILED',
        `Độ dài dữ liệu đầu ra (${data.length}) không khớp dims [${raw.dims.join(', ')}] (cần ${anchors * channels}).`,
        false,
        { dims: [...raw.dims], length: data.length },
      );
    }
    this.reserve(anchors);
    const { anchorOf, classOf, scoreOf, order } = this;

    const classCount = channels - BOX_CHANNELS;
    const channelsFirst = layout.layout === 'channels_first';
    const anchorStride = channelsFirst ? 1 : channels; // bước nhảy giữa hai anchor liền nhau
    const channelStride = channelsFirst ? anchors : 1; // bước nhảy giữa hai kênh của cùng một anchor
    const threshold = Math.fround(confLow);

    let passed = 0;
    for (let i = 0; i < anchors; i++) {
      const scoreBase = i * anchorStride + BOX_CHANNELS * channelStride;
      let best = Number.NEGATIVE_INFINITY;
      let bestClass = -1;
      for (let c = 0; c < classCount; c++) {
        const s = data[scoreBase + c * channelStride];
        if (s !== undefined && s > best) {
          best = s;
          bestClass = c;
        }
      }
      if (best > threshold) {
        anchorOf[passed] = i;
        classOf[passed] = bestClass;
        scoreOf[passed] = best;
        passed++;
      }
    }

    const ranked = order.subarray(0, passed);
    for (let k = 0; k < passed; k++) ranked[k] = k;
    ranked.sort(this.byScoreDesc);

    let count = 0;
    for (let r = 0; r < passed && count < MAX_NMS_CANDIDATES; r++) {
      const slot = ranked[r] ?? 0;
      const base = (anchorOf[slot] ?? 0) * anchorStride;
      const cx = data[base] ?? Number.NaN;
      const cy = data[base + channelStride] ?? Number.NaN;
      const w = data[base + 2 * channelStride] ?? Number.NaN;
      const h = data[base + 3 * channelStride] ?? Number.NaN;
      if (!Number.isFinite(cx + cy + w + h)) continue; // NaN hoặc vô cực ở bất kỳ giá trị nào
      // Làm tròn từng toạ độ về float32 như bản mẫu P01 (giai_ma ép xyxy sang float32 trước NMS).
      const x1 = Math.fround(cx - w / 2);
      const y1 = Math.fround(cy - h / 2);
      const x2 = Math.fround(cx + w / 2);
      const y2 = Math.fround(cy + h / 2);
      this.setCandidate(count, x1, y1, x2, y2, classOf[slot] ?? 0, scoreOf[slot] ?? 0);
      count++;
    }
    this.count = count;
    return count;
  }

  private reserve(anchors: number): void {
    if (this.anchorOf.length >= anchors) return;
    this.anchorOf = new Int32Array(anchors);
    this.classOf = new Int32Array(anchors);
    this.scoreOf = new Float32Array(anchors);
    this.order = new Int32Array(anchors);
  }

  private setCandidate(k: number, x1: number, y1: number, x2: number, y2: number, classId: number, score: number): void {
    const box = this.boxes[k];
    if (box === undefined) {
      this.boxes[k] = { x1, y1, x2, y2 };
    } else {
      box.x1 = x1;
      box.y1 = y1;
      box.x2 = x2;
      box.y2 = y2;
    }
    this.classIds[k] = classId;
    this.scores[k] = score;
  }
}
</file>

<file path="src/vision/nms.ts">
import type { BBox } from '../contracts';
import { iou } from '../utils/geometry';

export interface NmsOptions {
  /** Loại hộp có IoU LỚN HƠN ngưỡng này với một hộp đã giữ (so sánh nghiêm ngặt). */
  iouThreshold: number;
  /** true: gộp mọi lớp (agnostic); false: chỉ so các hộp cùng lớp (class-aware). */
  agnostic: boolean;
  /** Dừng khi đã giữ đủ số hộp này. */
  maxDetections: number;
}

/**
 * F4: NMS tham lam. Điều kiện đầu vào: ứng viên [0, count) đã sắp theo điểm GIẢM DẦN.
 * Mỗi ứng viên chỉ được so với các hộp ĐÃ GIỮ (tối đa maxDetections), không so với hộp đã bị loại,
 * nên chi phí là O(count × maxDetections), không có vòng lặp O(N²) trên toàn bộ anchor.
 * Ghi chỉ số ứng viên được giữ vào `kept` (theo thứ tự điểm giảm dần) và trả về số hộp giữ.
 * `kept` phải đủ chỗ cho min(count, maxDetections) phần tử.
 */
export function greedyNms(
  boxes: readonly BBox[],
  classIds: ArrayLike<number>,
  count: number,
  opts: NmsOptions,
  kept: Int32Array,
): number {
  const limit = Math.min(opts.maxDetections, count, kept.length);
  let keptCount = 0;
  for (let r = 0; r < count && keptCount < limit; r++) {
    const box = boxes[r];
    if (box === undefined) continue;
    const classId = classIds[r];
    let suppressed = false;
    for (let k = 0; k < keptCount; k++) {
      const other = kept[k] ?? 0;
      if (!opts.agnostic && classIds[other] !== classId) continue;
      const otherBox = boxes[other];
      if (otherBox !== undefined && iou(box, otherBox) > opts.iouThreshold) {
        suppressed = true;
        break;
      }
    }
    if (!suppressed) {
      kept[keptCount] = r;
      keptCount++;
    }
  }
  return keptCount;
}
</file>

<file path="src/vision/tensor.ts">
/**
 * P03 · F2 + phần thuần của F4 — Chuyển mảng RGBA thành tensor YOLO (NCHW float32) và ảnh xám nhỏ.
 * Chỉ nhận mảng byte: không đụng DOM, chạy được trong Node và Web Worker.
 */
import { AppError } from '../contracts';
import type { GrayImage, LetterboxMeta } from '../contracts';

/** Mảng byte điểm ảnh: Uint8Array hoặc Uint8ClampedArray (ImageData.data). */
export type ByteArray = Uint8Array | Uint8ClampedArray;
/** Ảnh RGBA 8 bit: 4 byte mỗi điểm (R, G, B, A), các hàng nối tiếp nhau, không đệm. */
export interface RgbaImage { data: ByteArray; width: number; height: number }

/** Giá trị nền lề mặc định (model-config.json: padValue = 114). */
export const DEFAULT_PAD_VALUE = 114;
const CHANNELS = 3;
const BYTES_PER_PIXEL = 4;
const BYTE_MAX = 255;
/** Hệ số độ sáng 0,299R + 0,587G + 0,114B nhân 1000 để cộng bằng số nguyên (làm tròn không sai số nhị phân). */
const LUMA_R = 299;
const LUMA_G = 587;
const LUMA_B = 114;
const LUMA_SCALE = 1000;

/**
 * Bảng v/255 dạng float32, tính một lần. Giá trị bằng đúng kết quả phép chia float32 của numpy ở bản mẫu P01
 * (v/255 có chu kỳ nhị phân 8 bit nên làm tròn kép double→float32 không bao giờ lệch).
 */
const UNIT_LUT = new Float32Array(BYTE_MAX + 1).map((_, v) => v / BYTE_MAX);

function fail(message: string, detail?: unknown): never {
  throw new AppError('INFERENCE_FAILED', message, false, detail);
}

function isSize(n: number): boolean {
  return Number.isInteger(n) && n > 0;
}

/**
 * Bảng nội suy một trục, tâm điểm ảnh lệch nửa ô như cv2.INTER_LINEAR: với mỗi toạ độ đích d có hai chỉ số nguồn
 * kề nhau (i0, i1) và trọng số w của i1. Ngoài mép thì lặp điểm mép (w = 0).
 */
export interface AxisTable { i0: Int32Array; i1: Int32Array; w: Float64Array }

/** Dựng bảng nội suy cho trục có srcN điểm nguồn và dstN điểm đích (cả hai là số nguyên dương). */
export function buildAxisTable(srcN: number, dstN: number): AxisTable {
  const i0 = new Int32Array(dstN);
  const i1 = new Int32Array(dstN);
  const w = new Float64Array(dstN);
  const ratio = srcN / dstN;
  const last = srcN - 1;
  for (let d = 0; d < dstN; d++) {
    const f = (d + 0.5) * ratio - 0.5;
    const base = Math.floor(f);
    if (base < 0) {
      // trước tâm điểm đầu: i0 = i1 = 0, w = 0
    } else if (base >= last) {
      i0[d] = last;
      i1[d] = last;
    } else {
      i0[d] = base;
      i1[d] = base + 1;
      w[d] = f - base;
    }
  }
  return { i0, i1, w };
}

/**
 * F2 — Vùng ảnh đã resize (newWidth × newHeight RGBA) → tensor NCHW [1,3,S,S], kênh RGB, chia 255, một lượt duyệt.
 * Lề ngoài vùng ảnh = padValue/255; vùng ảnh dán tại (padX, padY). Mọi phần tử của tensor đều được ghi đúng một lần,
 * nên dùng lại `out` giữa các khung không để sót dữ liệu cũ.
 * `out` chỉ được dùng nếu đúng độ dài 3·S·S, nếu không (hoặc đã bị detach do transfer) thì cấp phát mảng mới: luôn dùng giá trị trả về.
 * @throws AppError INFERENCE_FAILED khi meta không hợp lệ, vùng ảnh thiếu byte hoặc padValue ngoài 0..255.
 */
export function rgbaToTensor(
  region: ByteArray,
  meta: LetterboxMeta,
  out?: Float32Array,
  padValue: number = DEFAULT_PAD_VALUE,
): Float32Array {
  const { inputSize: size, newWidth: w, newHeight: h, padX, padY } = meta;
  const metaOk =
    isSize(size) && isSize(w) && isSize(h) && Number.isInteger(padX) && Number.isInteger(padY) &&
    padX >= 0 && padY >= 0 && padX + w <= size && padY + h <= size;
  if (!metaOk) fail('Siêu dữ liệu letterbox không hợp lệ', meta);
  if (region.length < w * h * BYTES_PER_PIXEL) fail(`Vùng ảnh có ${region.length} byte, cần ${w * h * BYTES_PER_PIXEL}`, meta);
  if (!(padValue >= 0 && padValue <= BYTE_MAX)) fail(`padValue phải trong 0..255, nhận được ${String(padValue)}`);

  const plane = size * size;
  const tensor = out !== undefined && out.length === CHANNELS * plane ? out : new Float32Array(CHANNELS * plane);
  const pad = padValue / BYTE_MAX;
  const greenAt = plane;
  const blueAt = 2 * plane;
  const fillSpan = (from: number, to: number): void => {
    tensor.fill(pad, from, to);
    tensor.fill(pad, greenAt + from, greenAt + to);
    tensor.fill(pad, blueAt + from, blueAt + to);
  };

  for (let y = 0; y < size; y++) {
    const row = y * size;
    if (y < padY || y >= padY + h) {
      fillSpan(row, row + size); // hàng lề trên/dưới
      continue;
    }
    const left = row + padX;
    const right = left + w;
    fillSpan(row, left);
    fillSpan(right, row + size);
    let p = (y - padY) * w * BYTES_PER_PIXEL;
    for (let i = left; i < right; i++, p += BYTES_PER_PIXEL) {
      tensor[i] = UNIT_LUT[region[p]!]!;
      tensor[greenAt + i] = UNIT_LUT[region[p + 1]!]!;
      tensor[blueAt + i] = UNIT_LUT[region[p + 2]!]!;
    }
  }
  return tensor;
}

/** Độ sáng của điểm ảnh tại byte p, nhân LUMA_SCALE. */
function luma(d: ByteArray, p: number): number {
  return LUMA_R * d[p]! + LUMA_G * d[p + 1]! + LUMA_B * d[p + 2]!;
}

/**
 * F4 (phần thuần) — Thu nhỏ ảnh RGBA về chiều rộng thumbWidth, GIỮ tỷ lệ gốc (cao = round(h·thumbWidth/w), tối thiểu 1),
 * KHÔNG có lề, rồi đổi sang độ sáng 0,299R + 0,587G + 0,114B làm tròn về 0..255. Nội suy bilinear; chiều rộng luôn đúng thumbWidth.
 * `out` được dùng lại nếu đúng độ dài width·height, nếu không thì cấp phát mới: luôn dùng giá trị trả về.
 * @throws AppError INFERENCE_FAILED khi kích thước nguồn hoặc thumbWidth không hợp lệ, hoặc nguồn thiếu byte.
 */
export function toGray(source: RgbaImage, thumbWidth: number, out?: Uint8Array): GrayImage {
  const { data, width: srcW, height: srcH } = source;
  if (!isSize(srcW) || !isSize(srcH) || data.length < srcW * srcH * BYTES_PER_PIXEL) {
    fail(`Ảnh nguồn không hợp lệ: ${String(srcW)}×${String(srcH)}, ${data.length} byte`);
  }
  if (!isSize(thumbWidth)) fail(`thumbWidth không hợp lệ: ${String(thumbWidth)}`);

  const width = thumbWidth;
  const height = Math.max(1, Math.round((srcH * width) / srcW));
  const gray = out !== undefined && out.length === width * height ? out : new Uint8Array(width * height);
  const cols = buildAxisTable(srcW, width);
  const rows = buildAxisTable(srcH, height);
  const stride = srcW * BYTES_PER_PIXEL;
  let o = 0;
  for (let y = 0; y < height; y++) {
    const top = rows.i0[y]! * stride;
    const bottom = rows.i1[y]! * stride;
    const wy = rows.w[y]!;
    for (let x = 0; x < width; x++) {
      const a = cols.i0[x]! * BYTES_PER_PIXEL;
      const b = cols.i1[x]! * BYTES_PER_PIXEL;
      const wx = cols.w[x]!;
      const l00 = luma(data, top + a);
      const l10 = luma(data, bottom + a);
      const upper = l00 + (luma(data, top + b) - l00) * wx;
      const lower = l10 + (luma(data, bottom + b) - l10) * wx;
      gray[o++] = Math.round((upper + (lower - upper) * wy) / LUMA_SCALE);
    }
  }
  return { data: gray, width, height };
}
