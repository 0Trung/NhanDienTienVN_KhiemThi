<file path="src/vision/worker-core.ts">
import { AppError } from '../contracts';
import type { Detection, FrameMeta, IPostProcessor, IPreprocessor, PreprocessResult, WorkerRequest, WorkerResponse } from '../contracts';
import { center } from '../utils/geometry';
import { createLogger } from '../utils/logger';
import { systemClock } from '../utils/time';
import type { Clock } from '../utils/time';
import type { ModelRunner } from './model-manager';

const log = createLogger('worker-core');

export interface WorkerCoreOptions {
  model: ModelRunner;
  preprocessor: IPreprocessor;
  postProcessor: IPostProcessor;
  now?: Clock;
}

export interface WorkerCore {
  /** Trả đúng một phản hồi cho INIT/INFER; DISPOSE không có phản hồi (null). */
  handle(request: WorkerRequest): Promise<WorkerResponse | null>;
}

/** Đóng bitmap; lỗi khi đóng chỉ được ghi log, không làm hỏng luồng xử lý. */
export function closeBitmap(bitmap: ImageBitmap): void {
  try {
    bitmap.close();
  } catch (e) {
    log.warn('Không đóng được bitmap', e);
  }
}

/** Trái → phải theo tâm x, hòa thì theo y: bảo đảm hợp đồng InferenceResult dù hậu xử lý đã sắp hay chưa. */
function leftToRight(a: Detection, b: Detection): number {
  const ca = center(a.bbox);
  const cb = center(b.bbox);
  return ca.x - cb.x || ca.y - cb.y;
}

/**
 * Lõi xử lý của worker (F5): nhận WorkerRequest, trả WorkerResponse. Chỉ xử lý một khung một lúc:
 * khung đến khi đang bận bị DROPPED. Bitmap được đóng ở mọi nhánh (đóng ngay sau tiền xử lý để giải phóng bộ nhớ sớm).
 */
export function createWorkerCore(o: WorkerCoreOptions): WorkerCore {
  const now = o.now ?? systemClock;
  let busy = false;
  let disposed = false;

  async function infer(meta: FrameMeta, bitmap: ImageBitmap): Promise<WorkerResponse> {
    if (busy || disposed) {
      closeBitmap(bitmap);
      return { type: 'DROPPED', frameId: meta.frameId };
    }
    busy = true; // đặt đồng bộ, trước mọi await, để khung đến sau thấy ngay
    try {
      const t0 = now();
      let pre: PreprocessResult;
      try {
        pre = o.preprocessor.process(bitmap);
      } finally {
        closeBitmap(bitmap);
      }
      const t1 = now();
      const raw = await o.model.predict(pre.tensor);
      const t2 = now();
      const detections = o.postProcessor.process(raw, pre.letterbox, meta).slice().sort(leftToRight);
      const t3 = now();
      const timings = { preprocessMs: t1 - t0, inferMs: t2 - t1, postprocessMs: t3 - t2, totalMs: t3 - t0 };
      return { type: 'RESULT', result: { meta, detections, gray: pre.gray, timings } };
    } catch (e) {
      log.warn(`Khung ${meta.frameId} lỗi`, e);
      return {
        type: 'ERROR',
        code: e instanceof AppError ? e.code : 'INFERENCE_FAILED',
        message: `Không xử lý được khung hình ${meta.frameId}: ${e instanceof Error ? e.message : String(e)}`,
        fatal: false,
        frameId: meta.frameId,
      };
    } finally {
      busy = false;
    }
  }

  return {
    async handle(request) {
      switch (request.type) {
        case 'INFER':
          return infer(request.meta, request.bitmap);
        case 'INIT': // mô hình đã nạp sẵn khi tạo core: báo lại thông tin
          return { type: 'READY', info: o.model.info };
        case 'DISPOSE':
          if (disposed) return null; // gọi lặp: mô hình đã được giải phóng, không giải phóng lần hai
          disposed = true;
          try {
            await o.model.dispose();
          } catch (e) {
            log.warn('Giải phóng mô hình lỗi', e);
          }
          return null;
      }
    },
  };
}
</file>

<file path="src/voice/audio-clip-engine.ts">
import { AppError } from '../contracts';
import type { ITtsEngine, TtsCapabilities, TtsHooks } from '../contracts';
import { createLogger } from '../utils/logger';

const log = createLogger('audio-clip');

/** Engine phát file mp3 ghi sẵn theo audioKey; canSpeak cho biết khóa nào thực sự có file. */
export interface AudioClipEngine extends ITtsEngine {
  canSpeak(audioKey: string): boolean;
}

/** Phần của fetch mà engine dùng (fetch thật thỏa mãn kiểu này). */
export type AudioFetch = (url: string, init?: { method: string }) => Promise<{ ok: boolean; json(): Promise<unknown> }>;

export interface AudioClipDeps {
  /** Thư mục gốc của ứng dụng (Vite base), ví dụ "./". Manifest nằm ở <baseUrl>audio/manifest.json. */
  baseUrl: string;
  fetchFn: AudioFetch;
  createAudio: () => HTMLAudioElement;
}

const UNAVAILABLE: TtsCapabilities = {
  available: false,
  vietnameseVoice: false,
  offlineVietnamese: false,
  requiresUserGesture: false,
};

/** Tên file hợp lệ: không có dấu gạch chéo, không bắt đầu bằng dấu chấm (chặn đường dẫn lạ trong manifest). */
const SAFE_FILE_NAME = /^[A-Za-z0-9_-][A-Za-z0-9_.-]*$/;

/** WAV im lặng 2 mẫu, dựng từ byte: dùng để "mở khóa" phần tử audio trong lần chạm đầu tiên. */
export function silentWavDataUri(): string {
  const bytes = [
    0x52, 0x49, 0x46, 0x46, 0x26, 0x00, 0x00, 0x00, 0x57, 0x41, 0x56, 0x45, // "RIFF", 38, "WAVE"
    0x66, 0x6d, 0x74, 0x20, 0x10, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, // "fmt ", 16, PCM, mono
    0x40, 0x1f, 0x00, 0x00, 0x40, 0x1f, 0x00, 0x00, 0x01, 0x00, 0x08, 0x00, // 8000 Hz, 8000 byte/s, 1, 8 bit
    0x64, 0x61, 0x74, 0x61, 0x02, 0x00, 0x00, 0x00, 0x80, 0x80, // "data", 2 byte im lặng
  ];
  return `data:audio/wav;base64,${btoa(String.fromCharCode(...bytes))}`;
}

function parseManifest(data: unknown): Array<[string, string]> {
  if (typeof data !== 'object' || data === null || Array.isArray(data)) return [];
  return Object.entries(data).filter(
    (entry): entry is [string, string] => typeof entry[1] === 'string' && SAFE_FILE_NAME.test(entry[1]),
  );
}

/** Engine audio-clip với các thành phần tiêm vào (dùng cho test và cho createAudioClipEngine). */
export function createAudioClipEngineWith(deps: AudioClipDeps): AudioClipEngine {
  const base = deps.baseUrl.endsWith('/') ? deps.baseUrl : `${deps.baseUrl}/`;
  const clips = new Map<string, string>(); // khóa → URL của file đã xác nhận tồn tại
  let audio: HTMLAudioElement | null = null; // MỘT phần tử audio, tạo lười và dùng lại cho mọi câu
  let counter = 0;
  let current = 0; // id của clip đang phát; 0 = không có
  let unlocked = false;

  function getAudio(): HTMLAudioElement {
    audio ??= deps.createAudio();
    return audio;
  }

  async function init(): Promise<TtsCapabilities> {
    clips.clear();
    try {
      const res = await deps.fetchFn(`${base}audio/manifest.json`);
      if (res.ok) {
        const entries = parseManifest(await res.json());
        await Promise.all(
          entries.map(async ([key, file]) => {
            const url = `${base}audio/${file}`;
            try {
              if ((await deps.fetchFn(url, { method: 'HEAD' })).ok) clips.set(key, url);
            } catch (e) {
              log.warn(`Không kiểm tra được file ${file}:`, e);
            }
          }),
        );
      }
    } catch (e) {
      log.warn('Không đọc được manifest âm thanh ghi sẵn:', e);
    }
    if (clips.size === 0) return { ...UNAVAILABLE };
    // requiresUserGesture = true: giả định chính sách tự phát của WebView chưa được nới (nếu đã nới thì để false).
    return { available: true, vietnameseVoice: true, offlineVietnamese: true, requiresUserGesture: true };
  }

  /** Gọi trong lần chạm đầu tiên: phát một clip im lặng trên chính phần tử audio sẽ dùng về sau. */
  function unlock(): void {
    if (unlocked) return;
    unlocked = true;
    try {
      const el = getAudio();
      el.src = silentWavDataUri();
      const started: Promise<void> | undefined = el.play();
      started?.catch((e: unknown) => {
        if (e instanceof Error && e.name === 'NotAllowedError') unlocked = false; // vẫn bị khóa: thử lại lần chạm sau
      });
    } catch (e) {
      unlocked = false;
      log.warn('unlock lỗi:', e);
    }
  }

  function speak(_text: string, opts: { rate: number; lang: string; audioKey?: string }, hooks: TtsHooks): void {
    const url = opts.audioKey === undefined ? undefined : clips.get(opts.audioKey);
    if (url === undefined) {
      hooks.onError(new AppError('TTS_UNAVAILABLE', `Không có âm thanh ghi sẵn cho khóa ${String(opts.audioKey)}`));
      return;
    }
    const el = getAudio();
    if (current !== 0) el.pause(); // không để hai clip chồng nhau
    counter += 1;
    const id = counter;
    current = id;
    el.onended = () => {
      if (current !== id) return;
      current = 0;
      hooks.onEnd();
    };
    el.onerror = () => {
      if (current !== id) return;
      current = 0;
      hooks.onError(new AppError('TTS_UNAVAILABLE', 'Không phát được file âm thanh ghi sẵn'));
    };
    const fail = (e: unknown): void => {
      if (current !== id) return;
      current = 0;
      hooks.onError(new AppError('TTS_UNAVAILABLE', 'Trình duyệt từ chối phát âm thanh ghi sẵn', false, e));
    };
    try {
      el.src = url;
      el.playbackRate = opts.rate;
      const started: Promise<void> | undefined = el.play();
      if (started === undefined) hooks.onStart();
      else {
        started.then(() => {
          if (current === id) hooks.onStart();
        }, fail);
      }
    } catch (e) {
      fail(e);
    }
  }

  function cancel(): void {
    current = 0;
    audio?.pause();
  }

  return { name: 'audio-clip', init, unlock, speak, cancel, canSpeak: (audioKey) => clips.has(audioKey) };
}

/** Engine audio-clip thật: phát mp3 trong public/audio (đã nằm sẵn trong APK, chạy được khi không có mạng). */
export function createAudioClipEngine(o?: { baseUrl?: string }): AudioClipEngine {
  return createAudioClipEngineWith({
    baseUrl: o?.baseUrl ?? './',
    fetchFn: (url, init) => fetch(url, init),
    createAudio: () => new Audio(),
  });
}
</file>

<file path="src/voice/haptic-service.ts">
import type { HapticEvent, IHaptics } from '../contracts';
import { createLogger } from '../utils/logger';
import { getPlatform } from '../utils/platform';
import { createCapacitorHapticPort } from './haptics-adapter';

const log = createLogger('haptics');

/** Mẫu rung theo quy ước Web Vibration API: [rung, nghỉ, rung, nghỉ, ...], đơn vị mili-giây. */
export const HAPTIC_PATTERNS: Readonly<Record<HapticEvent, readonly number[]>> = {
  START: [30],
  SUCCESS: [40, 60, 40],
  UNCERTAIN: [300],
  ERROR: [100, 80, 100, 80, 300],
};

/**
 * Cổng nhỏ che plugin rung native. Plugin chỉ nhận MỘT khoảng rung liên tục,
 * nên chuỗi nhiều nhịp do HapticService phát bằng hẹn giờ.
 * Bản triển khai thật không được ném lỗi: không rung được thì trả false.
 */
export interface HapticPort {
  vibrate(durationMs: number): Promise<boolean>;
}

/** Hàm rung của trình duyệt (navigator.vibrate): nhận cả mẫu và tự hủy mẫu đang chạy. */
export type WebVibrate = (pattern: number[]) => boolean;

/** Hẹn giờ được tiêm vào để test không phải chờ thật. */
export interface HapticTimers {
  setTimeout(handler: () => void, ms: number): unknown;
  clearTimeout(handle: unknown): void;
}

export interface HapticServiceDeps {
  isEnabled: () => boolean;
  /** Cổng plugin native; bỏ trống hoặc null nếu không chạy trong APK. */
  port?: HapticPort | null;
  /** Dự phòng trình duyệt; bỏ trống hoặc null nếu không có navigator.vibrate. */
  webVibrate?: WebVibrate | null;
  timers?: HapticTimers;
}

const REAL_TIMERS: HapticTimers = {
  setTimeout: (handler, ms) => globalThis.setTimeout(handler, ms),
  clearTimeout: (handle) => globalThis.clearTimeout(handle as number),
};

/** Gọi cổng rung và gom MỌI kiểu thất bại (trả false, từ chối, ném đồng bộ) về false. */
async function deliver(port: HapticPort, durationMs: number): Promise<boolean> {
  try {
    return (await port.vibrate(durationMs)) !== false;
  } catch {
    return false;
  }
}

/**
 * Bộ rung với các thành phần được tiêm vào (dùng cho test và cho createHaptics).
 * - Native: phát từng nhịp qua port bằng hẹn giờ; chuỗi mới hủy chuỗi cũ còn chờ.
 * - Không native hoặc plugin lỗi: dùng navigator.vibrate nếu có.
 * - Không có cả hai: supported = false và play không làm gì.
 * - Cài đặt tắt rung được kiểm tra ở mọi nhịp, kể cả giữa chừng một chuỗi.
 */
export function createHapticService(deps: HapticServiceDeps): IHaptics {
  const port = deps.port ?? null;
  const webVibrate = deps.webVibrate ?? null;
  const timers = deps.timers ?? REAL_TIMERS;
  let portFailed = false;
  let generation = 0;
  let pending: unknown[] = [];

  function enabled(): boolean {
    try {
      return deps.isEnabled();
    } catch (e) {
      log.warn('isEnabled ném lỗi, coi như đã tắt rung', e);
      return false;
    }
  }

  function cancelPending(): void {
    for (const handle of pending) timers.clearTimeout(handle);
    pending = [];
  }

  function playWeb(pattern: readonly number[]): void {
    if (webVibrate === null) return;
    try {
      webVibrate([...pattern]);
    } catch (e) {
      log.warn('navigator.vibrate lỗi', e);
    }
  }

  function onPortFailure(pattern: readonly number[], index: number, gen: number): void {
    if (!portFailed) log.warn('Plugin rung native lỗi, chuyển sang navigator.vibrate nếu có');
    portFailed = true;
    if (gen !== generation) return; // chuỗi này đã bị thay, không được chạm vào chuỗi mới
    cancelPending();
    playWeb(pattern.slice(index)); // rung nốt phần còn lại của chuỗi bằng trình duyệt
  }

  function pulse(activePort: HapticPort, pattern: readonly number[], index: number, gen: number): void {
    if (gen !== generation) return;
    if (!enabled()) {
      cancelPending();
      return;
    }
    const duration = pattern[index];
    if (duration === undefined) return;
    void deliver(activePort, duration).then((ok) => {
      if (!ok) onPortFailure(pattern, index, gen);
    });
  }

  function playNative(activePort: HapticPort, pattern: readonly number[], gen: number): void {
    let offset = 0;
    for (let index = 0; index < pattern.length; index += 2) {
      if (offset === 0) {
        pulse(activePort, pattern, index, gen);
      } else {
        pending.push(timers.setTimeout(() => pulse(activePort, pattern, index, gen), offset));
      }
      offset += (pattern[index] ?? 0) + (pattern[index + 1] ?? 0);
    }
  }

  function play(e: HapticEvent): void {
    if (!enabled()) return;
    const pattern = HAPTIC_PATTERNS[e];
    if (pattern === undefined) return;
    cancelPending();
    generation += 1;
    if (port !== null && !portFailed) playNative(port, pattern, generation);
    else playWeb(pattern);
  }

  return {
    get supported(): boolean {
      return (port !== null && !portFailed) || webVibrate !== null;
    },
    play,
  };
}

function detectWebVibrate(): WebVibrate | null {
  try {
    if (typeof navigator === 'undefined' || typeof navigator.vibrate !== 'function') return null;
    return (pattern) => navigator.vibrate(pattern);
  } catch {
    return null;
  }
}

/**
 * Bộ rung thật. Trong APK (android-native) dùng @capacitor/haptics qua adapter;
 * ngoài APK dùng navigator.vibrate nếu trình duyệt có.
 * isEnabled thường là () => settings.vibrationEnabled.
 */
export function createHaptics(o: { isEnabled: () => boolean }): IHaptics {
  return createHapticService({
    isEnabled: o.isEnabled,
    port: getPlatform() === 'android-native' ? createCapacitorHapticPort() : null,
    webVibrate: detectWebVibrate(),
  });
}
</file>

