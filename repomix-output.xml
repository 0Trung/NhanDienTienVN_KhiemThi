import { DEFAULT_CONFIG } from '../config/app-config';
import type { Detection, GoldenBox, GoldenFixture, GoldenFixtures, IInferenceClient } from '../contracts';
import { iou } from '../utils/geometry';
import { setLogLevel } from '../utils/logger';
import { createSolidFrameSource, runBenchmark } from '../vision/benchmark';
import type { Stats } from '../vision/benchmark';
import { createInferenceClient } from '../vision/inference-client';

/**
 * Trang kiểm tra vàng, CHỈ dành cho dev (golden-check.html, không vào bản build APK).
 * Chạy client.infer THẬT trên ảnh trong public/golden/ rồi so với golden_fixtures.json của P01.
 * Thêm ?bench=30 (và &res=1280x720) để chạy benchmark sau phần kiểm tra.
 */

/** Dung sai theo đề bài P05 (không dùng `tolerance` gợi ý trong golden_fixtures.json). */
const MAX_CONF_DIFF = 0.02;
const MIN_IOU = 0.95;

export interface GoldenVerdict { pass: boolean; maxConfDiff: number; minIou: number; note: string }

/** So kết quả thật với hộp vàng: cùng số hộp, cùng lớp, lệch confidence ≤ 0,02 và IoU ≥ 0,95 (cả hai bên đã sắp trái → phải). */
export function compareToGolden(actual: readonly Detection[], expected: readonly GoldenBox[]): GoldenVerdict {
  if (actual.length !== expected.length) {
    return { pass: false, maxConfDiff: NaN, minIou: NaN, note: `số hộp ${actual.length} ≠ ${expected.length}` };
  }
  let maxConfDiff = 0;
  let minIou = 1;
  const problems: string[] = [];
  expected.forEach((box, i) => {
    const det = actual[i];
    if (!det) return;
    if (det.classId !== box.classId) problems.push(`hộp ${i}: lớp ${det.classId} ≠ ${box.classId}`);
    maxConfDiff = Math.max(maxConfDiff, Math.abs(det.confidence - box.confidence));
    minIou = Math.min(minIou, iou(det.bbox, box.bbox));
  });
  if (maxConfDiff > MAX_CONF_DIFF) problems.push(`lệch confidence ${maxConfDiff.toFixed(4)} > ${MAX_CONF_DIFF}`);
  if (minIou < MIN_IOU) problems.push(`IoU ${minIou.toFixed(4)} < ${MIN_IOU}`);
  return { pass: problems.length === 0, maxConfDiff, minIou, note: problems.join('; ') };
}

const root = document.getElementById('out') ?? document.body;
const fmt = (x: number, digits = 4): string => (Number.isFinite(x) ? x.toFixed(digits) : '-');

function add(tag: string, text: string): void {
  const el = document.createElement(tag);
  el.textContent = text;
  root.append(el);
}

function addTable(head: readonly string[], rows: ReadonlyArray<readonly string[]>): void {
  const table = document.createElement('table');
  const addRow = (cells: readonly string[], tag: 'th' | 'td'): void => {
    const tr = document.createElement('tr');
    for (const text of cells) {
      const cell = document.createElement(tag);
      cell.textContent = text;
      tr.append(cell);
    }
    const last = cells[cells.length - 1] ?? '';
    if (tag === 'td' && last.startsWith('ĐẠT')) tr.className = 'pass';
    if (tag === 'td' && last.startsWith('KHÔNG ĐẠT')) tr.className = 'fail';
    table.append(tr);
  };
  addRow(head, 'th');
  for (const r of rows) addRow(r, 'td');
  root.append(table);
}

async function fetchOk(url: string): Promise<Response> {
  const res = await fetch(url);
  if (!res.ok) throw new Error(`Không đọc được ${url} (HTTP ${res.status}). Chép nội dung thư mục fixtures/ của gói P01 vào public/golden/.`);
  return res;
}

async function checkOne(client: IInferenceClient, fixture: GoldenFixture, frameId: number): Promise<{ row: string[]; pass: boolean }> {
  const bitmap = await createImageBitmap(await (await fetchOk(`./golden/${fixture.image}`)).blob(), { colorSpaceConversion: 'none' });
  const { width, height } = bitmap;
  const result = await client.infer({ bitmap, meta: { frameId, width, height, timestamp: performance.now() } });
  let verdict: GoldenVerdict;
  if (width !== fixture.srcWidth || height !== fixture.srcHeight) {
    verdict = { pass: false, maxConfDiff: NaN, minIou: NaN, note: `ảnh ${width}×${height} ≠ ${fixture.srcWidth}×${fixture.srcHeight}` };
  } else if (result === null) {
    verdict = { pass: false, maxConfDiff: NaN, minIou: NaN, note: 'khung bị bỏ' };
  } else {
    verdict = compareToGolden(result.detections, fixture.boxes);
  }
  const row = [
    fixture.image, fixture.kind, `${result?.detections.length ?? '-'} / ${fixture.boxes.length}`,
    fmt(verdict.maxConfDiff), fmt(verdict.minIou), fmt(result?.timings.totalMs ?? NaN, 1),
    verdict.pass ? 'ĐẠT' : `KHÔNG ĐẠT (${verdict.note})`,
  ];
  return { row, pass: verdict.pass };
}

function parseResolution(text: string | null): [number, number] {
  const [w, h] = (text ?? '640x480').split('x').map(Number);
  return [Number.isFinite(w) && w ? w : 640, Number.isFinite(h) && h ? h : 480];
}

async function main(): Promise<void> {
  setLogLevel('debug');
  const params = new URLSearchParams(location.search);
  add('h1', 'Kiểm tra vàng (chỉ dành cho dev)');
  const golden = (await (await fetchOk('./golden/golden_fixtures.json')).json()) as GoldenFixtures;
  const p = golden.params;
  const client = createInferenceClient({
    modelBaseUrl: './models/',
    ortBaseUrl: './ort/',
    config: {
      ...DEFAULT_CONFIG.inference,
      confLow: p.confLow, confSure: p.confSure, nmsIou: p.nmsIou, agnosticNms: p.agnosticNms, maxDetections: p.maxDetections,
      verifyChecksum: DEFAULT_CONFIG.inference.verifyChecksum && isSecureContext, // crypto.subtle chỉ có ở ngữ cảnh an toàn
    },
  });
  try {
    const info = await client.init();
    add('p', `Mô hình ${info.version} · size ${info.inputSize} · ${info.backend} · ${info.threads} luồng · nạp ${info.loadMs.toFixed(0)} ms · chạy nóng ${info.warmupMs.toFixed(0)} ms · crossOriginIsolated=${String(crossOriginIsolated)}`);
    const fixtures = golden.fixtures.filter((f) => f.size === info.inputSize);
    const rows: string[][] = [];
    let allPass = fixtures.length > 0;
    for (const [i, fixture] of fixtures.entries()) {
      try {
        const { row, pass } = await checkOne(client, fixture, i + 1);
        rows.push(row);
        allPass = allPass && pass;
      } catch (e) {
        rows.push([fixture.image, fixture.kind, '-', '-', '-', '-', `KHÔNG ĐẠT (${e instanceof Error ? e.message : String(e)})`]);
        allPass = false;
      }
    }
    addTable(['ảnh', 'loại', 'hộp thật / vàng', 'max Δconf', 'min IoU', 'ms', 'kết quả'], rows);
    if (fixtures.length === 0) add('p', `Không có mục vàng nào cho size ${info.inputSize}.`);
    const verdict = allPass ? 'ĐẠT' : 'KHÔNG ĐẠT';
    add('h2', `KẾT QUẢ: ${verdict}`);
    document.title = `Kiểm tra vàng: ${verdict}`;
    document.body.dataset.result = allPass ? 'pass' : 'fail';

    const n = Number(params.get('bench') ?? 0);
    if (n > 0) {
      const [w, h] = parseResolution(params.get('res'));
      add('h2', `Benchmark ${n} khung ${w}×${h}`);
      const stats = await runBenchmark(client, createSolidFrameSource(w, h), n);
      const line = (name: string, s: Stats): string[] => [name, s.mean.toFixed(1), s.p50.toFixed(1), s.p95.toFixed(1)];
      addTable(['chỉ số', 'mean (ms)', 'p50 (ms)', 'p95 (ms)'], [line('totalMs', stats.totalMs), line('inferMs', stats.inferMs)]);
      document.body.dataset.bench = 'done';
    }
  } finally {
    client.dispose();
  }
}

main().catch((e: unknown) => {
  add('h2', `LỖI: ${e instanceof Error ? e.message : String(e)}`);
  document.body.dataset.result = 'error';
});
</file>

<file path="src/vision/image-processor.ts">
/**
 * P03 · F3, F5, F6 — Bộ tiền xử lý: khung hình camera (ImageBitmap) → PreprocessResult, chạy được TRONG Web Worker.
 * Hai tầng resize dùng chung computeLetterbox:
 *  (a) tầng Canvas: OffscreenCanvas (thiếu thì canvas DOM) — dùng khi chạy thật;
 *  (b) tầng thuần: resize bilinear trên mảng RGBA — dùng cho test trong Node.
 * Không gọi ONNX, không NMS, không đo thời gian (worker tự đo).
 */
import { AppError } from '../contracts';
import type { IPreprocessor, LetterboxMeta, PreprocessResult, PreprocessorOptions } from '../contracts';
import { createLogger } from '../utils/logger';
import { computeLetterbox } from './letterbox';
import { buildAxisTable, rgbaToTensor, toGray } from './tensor';
import type { ByteArray, RgbaImage } from './tensor';

const log = createLogger('vision/preprocess');
const BYTES_PER_PIXEL = 4;
const BYTE_MAX = 255;

/**
 * Phần ngữ cảnh canvas 2D mà bộ tiền xử lý cần (port nhỏ để giả lập được trong Node).
 * OffscreenCanvasRenderingContext2D và CanvasRenderingContext2D đều thoả cấu trúc này.
 */
export interface Context2DLike {
  imageSmoothingEnabled: boolean;
  imageSmoothingQuality: 'low' | 'medium' | 'high';
  fillStyle: string | CanvasGradient | CanvasPattern;
  fillRect(x: number, y: number, w: number, h: number): void;
  drawImage(
    image: ImageBitmap,
    sx: number, sy: number, sw: number, sh: number,
    dx: number, dy: number, dw: number, dh: number,
  ): void;
  getImageData(sx: number, sy: number, sw: number, sh: number): { readonly data: ByteArray; readonly width: number; readonly height: number };
}
/** Tạo ngữ cảnh canvas vuông size × size. Được tiêm qua tham số để test trong Node. */
export type Context2DFactory = (size: number) => Context2DLike;

/** Làm mịn 'low' = bilinear, gần nhất với cv2.INTER_LINEAR của bản mẫu P01. */
const SMOOTHING_QUALITY = 'low';

/**
 * Ngữ cảnh canvas thật: OffscreenCanvas (Web Worker), thiếu thì canvas DOM; bật willReadFrequently để getImageData nhanh.
 * @throws AppError UNSUPPORTED_BROWSER (fatal) khi môi trường không có canvas 2D.
 */
export function createDefaultContext2D(size: number): Context2DLike {
  const settings: CanvasRenderingContext2DSettings = { willReadFrequently: true, alpha: false };
  let ctx: Context2DLike | null = null;
  let kind: string | null = null;
  if (typeof OffscreenCanvas !== 'undefined') {
    kind = 'OffscreenCanvas';
    ctx = new OffscreenCanvas(size, size).getContext('2d', settings);
  } else if (typeof document !== 'undefined') {
    kind = 'canvas DOM';
    const canvas = document.createElement('canvas');
    canvas.width = size;
    canvas.height = size;
    ctx = canvas.getContext('2d', settings);
  }
  if (ctx === null) {
    const reason = kind === null ? 'môi trường không có OffscreenCanvas lẫn canvas DOM' : `${kind} không trả về ngữ cảnh 2D`;
    throw new AppError('UNSUPPORTED_BROWSER', `Không tạo được canvas 2D để tiền xử lý ảnh: ${reason}`, true);
  }
  log.debug(`Đã tạo canvas tiền xử lý ${size}×${size} bằng ${kind}`);
  return ctx;
}

/**
 * Tầng thuần (b) — resize bilinear RGBA, tâm điểm ảnh lệch nửa ô như cv2.INTER_LINEAR, lặp điểm mép.
 * Uint8ClampedArray tự làm tròn và chặn 0..255. `out` được dùng lại nếu đúng độ dài, nếu không thì cấp phát mới.
 */
export function resizeBilinearRgba(src: RgbaImage, dstW: number, dstH: number, out?: Uint8ClampedArray): Uint8ClampedArray {
  const { data, width: srcW, height: srcH } = src;
  const sizesOk = [srcW, srcH, dstW, dstH].every((n) => Number.isInteger(n) && n > 0);
  if (!sizesOk || data.length < srcW * srcH * BYTES_PER_PIXEL) {
    throw new AppError('INFERENCE_FAILED', `Resize không hợp lệ: ${srcW}×${srcH} → ${dstW}×${dstH}`, false, { srcW, srcH, dstW, dstH });
  }
  const dst = out !== undefined && out.length === dstW * dstH * BYTES_PER_PIXEL ? out : new Uint8ClampedArray(dstW * dstH * BYTES_PER_PIXEL);
  const cols = buildAxisTable(srcW, dstW);
  const rows = buildAxisTable(srcH, dstH);
  const stride = srcW * BYTES_PER_PIXEL;
  let o = 0;
  for (let y = 0; y < dstH; y++) {
    const top = rows.i0[y]! * stride;
    const bottom = rows.i1[y]! * stride;
    const wy = rows.w[y]!;
    for (let x = 0; x < dstW; x++) {
      const a = cols.i0[x]! * BYTES_PER_PIXEL;
      const b = cols.i1[x]! * BYTES_PER_PIXEL;
      const wx = cols.w[x]!;
      for (let c = 0; c < BYTES_PER_PIXEL; c++) {
        const t0 = data[top + a + c]!;
        const b0 = data[bottom + a + c]!;
        const upper = t0 + (data[top + b + c]! - t0) * wx;
        const lower = b0 + (data[bottom + b + c]! - b0) * wx;
        dst[o++] = upper + (lower - upper) * wy;
      }
    }
  }
  return dst;
}

/**
 * Tầng thuần (b) đầy đủ: ảnh RGBA gốc → PreprocessResult, không canvas, không tái sử dụng buffer.
 * Cùng computeLetterbox/rgbaToTensor/toGray với tầng Canvas; gray lấy từ vùng ảnh đã resize (không có lề).
 */
export function preprocessRgba(src: RgbaImage, o: PreprocessorOptions): PreprocessResult {
  const meta = computeLetterbox(src.width, src.height, o.inputSize);
  const same = meta.newWidth === src.width && meta.newHeight === src.height;
  const region: RgbaImage = same
    ? src
    : { data: resizeBilinearRgba(src, meta.newWidth, meta.newHeight), width: meta.newWidth, height: meta.newHeight };
  return { tensor: rgbaToTensor(region.data, meta, undefined, o.padValue), letterbox: meta, gray: toGray(region, o.grayThumbWidth) };
}

/** Tầng Canvas (a): tô nền, vẽ bitmap vào (padX, padY, newW, newH), đọc lại CHỈ vùng ảnh (không đọc lề). */
function drawRegion(ctx: Context2DLike, bitmap: ImageBitmap, meta: LetterboxMeta, background: string): RgbaImage {
  try {
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = SMOOTHING_QUALITY;
    ctx.fillStyle = background;
    ctx.fillRect(0, 0, meta.inputSize, meta.inputSize);
    ctx.drawImage(bitmap, 0, 0, meta.srcWidth, meta.srcHeight, meta.padX, meta.padY, meta.newWidth, meta.newHeight);
    const image = ctx.getImageData(meta.padX, meta.padY, meta.newWidth, meta.newHeight);
    if (image.width !== meta.newWidth || image.height !== meta.newHeight || image.data.length < image.width * image.height * BYTES_PER_PIXEL) {
      throw new AppError('INFERENCE_FAILED', 'Canvas trả về vùng ảnh sai kích thước', false, {
        expected: [meta.newWidth, meta.newHeight],
        actual: [image.width, image.height],
      });
    }
    return image;
  } catch (e) {
    if (e instanceof AppError) throw e;
    throw new AppError('INFERENCE_FAILED', 'Không đọc được điểm ảnh từ bitmap (có thể đã bị đóng)', false, e);
  }
}

/**
 * F5 — Bộ tiền xử lý với canvas được tiêm (createPreprocessor dùng canvas thật). Canvas và buffer được tạo một lần
 * rồi dùng lại giữa các khung; buffer bị detach hoặc đổi kích thước thì tự cấp phát lại.
 * LƯU Ý: tensor và gray.data của kết quả là buffer TÁI SỬ DỤNG, chỉ hợp lệ đến lần process kế tiếp.
 * process() KHÔNG close bitmap (bên nhận CapturedFrame chịu trách nhiệm); lỗi mỗi khung là AppError không fatal:
 * INFERENCE_FAILED khi bitmap đã đóng/kích thước 0 hoặc canvas lỗi, UNSUPPORTED_BROWSER (fatal) khi không có canvas.
 * @throws AppError INFERENCE_FAILED (fatal) khi tuỳ chọn không hợp lệ.
 */
export function createPreprocessorWith(o: PreprocessorOptions, createContext: Context2DFactory): IPreprocessor {
  const { inputSize, padValue, grayThumbWidth } = o;
  const optionsOk =
    Number.isInteger(inputSize) && inputSize > 0 && padValue >= 0 && padValue <= BYTE_MAX && Number.isInteger(grayThumbWidth) && grayThumbWidth > 0;
  if (!optionsOk) throw new AppError('INFERENCE_FAILED', 'Tuỳ chọn tiền xử lý không hợp lệ', true, o);

  const background = `rgb(${padValue},${padValue},${padValue})`;
  let ctx: Context2DLike | null = null;
  let tensorBuf: Float32Array | undefined;
  let grayBuf: Uint8Array | undefined;

  return {
    process(bitmap: ImageBitmap): PreprocessResult {
      // F6: bitmap đã close() có width = height = 0; kiểm tra TRƯỚC khi đụng canvas hay buffer.
      const width = bitmap?.width ?? 0;
      const height = bitmap?.height ?? 0;
      if (!(width > 0 && height > 0)) {
        throw new AppError('INFERENCE_FAILED', 'Bitmap đã đóng hoặc có kích thước 0, không thể tiền xử lý', false, { width, height });
      }
      const letterbox = computeLetterbox(width, height, inputSize);
      ctx ??= createContext(inputSize);
      const region = drawRegion(ctx, bitmap, letterbox, background);
      tensorBuf = rgbaToTensor(region.data, letterbox, tensorBuf, padValue);
      const gray = toGray(region, grayThumbWidth, grayBuf);
      grayBuf = gray.data;
      return { tensor: tensorBuf, letterbox, gray };
    },
  };
}

/** Bảng đăng ký xuất khẩu: createPreprocessor(o: PreprocessorOptions): IPreprocessor, dùng canvas thật. */
export function createPreprocessor(o: PreprocessorOptions): IPreprocessor {
  return createPreprocessorWith(o, createDefaultContext2D);
}
</file>

<file path="src/vision/letterbox.ts">
/**
 * P03 · F1 — Hình học letterbox: đưa khung srcW × srcH vào ảnh vuông inputSize × inputSize, giữ tỷ lệ.
 * Khớp từng bước với hàm letterbox() ở bản mẫu P01 (CELL 5) và Ultralytics LetterBox (center = true).
 * Hàm thuần: không đụng DOM, chạy được trong Node và Web Worker.
 */
import { AppError } from '../contracts';
import type { LetterboxMeta } from '../contracts';

/** Số hữu hạn và > 0: loại 0, số âm, NaN, ±Infinity. */
function isPositiveFinite(n: number): boolean {
  return Number.isFinite(n) && n > 0;
}

/** Cạnh sau resize: làm tròn, tối thiểu 1 (như max(round(...), 1) ở P01), không vượt inputSize. */
function resizedSide(src: number, scale: number, inputSize: number): number {
  return Math.min(inputSize, Math.max(1, Math.round(src * scale)));
}

/** Lề trái/trên = round((S − cạnh mới)/2 − 0,1). "+ 0" đổi -0 (Math.round(-0,1)) thành +0. */
function padFor(inputSize: number, newSide: number): number {
  return Math.round((inputSize - newSide) / 2 - 0.1) + 0;
}

/**
 * scale = min(S/w, S/h) · newW, newH = làm tròn · padX = round((S − newW)/2 − 0,1), padY tương tự.
 * Math.round khác round của Python (làm tròn về số chẵn) chỉ ở điểm đúng .5; bản mẫu P01 đã chấp nhận chênh lệch này.
 * @throws AppError INFERENCE_FAILED khi kích thước khung hoặc inputSize không hợp lệ (0, âm, NaN, vô cực, inputSize không nguyên).
 */
export function computeLetterbox(srcW: number, srcH: number, inputSize: number): LetterboxMeta {
  if (!isPositiveFinite(srcW) || !isPositiveFinite(srcH)) {
    throw new AppError('INFERENCE_FAILED', `Kích thước khung hình không hợp lệ: ${String(srcW)}×${String(srcH)}`, false, {
      srcW,
      srcH,
    });
  }
  if (!Number.isInteger(inputSize) || inputSize <= 0) {
    throw new AppError('INFERENCE_FAILED', `inputSize không hợp lệ: ${String(inputSize)}`, false, { inputSize });
  }
  const scale = Math.min(inputSize / srcW, inputSize / srcH);
  const newWidth = resizedSide(srcW, scale, inputSize);
  const newHeight = resizedSide(srcH, scale, inputSize);
  return {
    inputSize,
    srcWidth: srcW,
    srcHeight: srcH,
    scale,
    newWidth,
    newHeight,
    padX: padFor(inputSize, newWidth),
    padY: padFor(inputSize, newHeight),
  };
}
</file>

<file path="src/vision/model-manager.ts">
import { AppError } from '../contracts';
import type { AppConfig, ClassesJson, ModelConfigJson, ModelInfo, ModelManifest, RawModelOutput } from '../contracts';
import { createLogger } from '../utils/logger';
import { systemClock } from '../utils/time';
import type { Clock } from '../utils/time';
import type { InferenceSession } from 'onnxruntime-web/wasm';

/**
 * Nạp và chạy mô hình ONNX bằng onnxruntime-web. Thuần logic, không phụ thuộc trình duyệt nên chạy được
 * trong Worker lẫn Node; fetch, ORT và thông tin môi trường đều nhận qua tham số để test bằng đồ giả.
 */
const log = createLogger('model-manager');

/** Số luồng WASM tối đa khi trang được cô lập đa nguồn gốc (crossOriginIsolated). */
const MAX_WASM_THREADS = 4;

type Backend = ModelInfo['backend'];

/** Phần của onnxruntime-web mà module này dùng; đồ giả trong test chỉ cần thỏa cấu trúc này. */
export type OrtModule = Pick<typeof import('onnxruntime-web/wasm'), 'env' | 'InferenceSession' | 'Tensor'>;
/** Phần của Response mà module cần; fetch thật thỏa cấu trúc này. */
export interface FetchResponseLike { ok: boolean; status: number; json(): Promise<unknown>; arrayBuffer(): Promise<ArrayBuffer> }
export type FetchLike = (url: string) => Promise<FetchResponseLike>;
/** Thông tin môi trường chạy, đọc từ globalThis (test tiêm giá trị giả). */
export interface RuntimeEnv { crossOriginIsolated: boolean; hardwareConcurrency: number; hasWebGpu: boolean; userAgent: string }

export interface LoadModelOptions {
  baseUrl: string;
  ortBaseUrl: string;
  config: AppConfig['inference'];
  fetchFn?: FetchLike;
  /** Nạp ORT theo backend; mặc định import động onnxruntime-web/wasm hoặc onnxruntime-web/webgpu. */
  ortLoader?: (backend: Backend) => Promise<OrtModule>;
  runtime?: RuntimeEnv;
  now?: Clock;
}

/** Phần worker-core cần của một mô hình đã nạp. */
export interface ModelRunner {
  readonly info: ModelInfo;
  predict(tensor: Float32Array): Promise<RawModelOutput>;
  dispose(): Promise<void>;
}
export interface LoadedModel extends ModelRunner {
  readonly manifest: ModelManifest;
  readonly config: ModelConfigJson;
  /** Nguyên văn classes.json; giá trị được kiểm bằng buildClassMap ở nơi dùng. */
  readonly classes: ClassesJson;
}

const withSlash = (url: string): string => (url.endsWith('/') ? url : `${url}/`);
const fileName = (url: string): string => url.slice(url.lastIndexOf('/') + 1);
const isRecord = (v: unknown): v is Record<string, unknown> => typeof v === 'object' && v !== null && !Array.isArray(v);
const isClasses = (v: unknown): v is ClassesJson => isRecord(v);
const isModelConfig = (v: unknown): v is ModelConfigJson => isRecord(v) && Number.isInteger(v.inputSize) && Number(v.inputSize) > 0;
const isManifest = (v: unknown): v is ModelManifest =>
  isRecord(v) && typeof v.file === 'string' && typeof v.sha256 === 'string' && typeof v.version === 'string' &&
  typeof v.inputName === 'string' && typeof v.outputName === 'string' && Array.isArray(v.inputShape) &&
  Number.isInteger(v.sizeBytes) && Number.isInteger(v.classCount);

function readRuntimeEnv(): RuntimeEnv {
  const g = globalThis as { crossOriginIsolated?: boolean; navigator?: { hardwareConcurrency?: number; userAgent?: string; gpu?: unknown } };
  return {
    crossOriginIsolated: g.crossOriginIsolated === true,
    hardwareConcurrency: g.navigator?.hardwareConcurrency ?? 1,
    hasWebGpu: g.navigator?.gpu !== undefined,
    userAgent: g.navigator?.userAgent ?? '',
  };
}

function describeRuntime(r: RuntimeEnv): string {
  const chrome = /Chrome\/([\d.]+)/.exec(r.userAgent)?.[1] ?? 'không rõ';
  const kind = /;\s*wv\)/.test(r.userAgent) ? 'Android WebView' : 'Chrome';
  return `Môi trường: ${kind} ${chrome}; crossOriginIsolated=${r.crossOriginIsolated}; CPU=${r.hardwareConcurrency}; WebGPU=${r.hasWebGpu}`;
}

/** WebView thường không cô lập đa nguồn gốc nên chỉ dùng đa luồng khi crossOriginIsolated. */
function pickThreads(r: RuntimeEnv): number {
  if (!r.crossOriginIsolated) return 1;
  return Math.max(1, Math.min(MAX_WASM_THREADS, Math.floor(r.hardwareConcurrency) || 1));
}

/** Bản wasm-only dùng ort-wasm-simd-threaded.{mjs,wasm}: đúng các file scripts/copy-ort-wasm.mjs chép vào public/ort. */
function importOrt(backend: Backend): Promise<OrtModule> {
  return backend === 'webgpu' ? import('onnxruntime-web/webgpu') : import('onnxruntime-web/wasm');
}

async function fetchOk(fetchFn: FetchLike, url: string): Promise<FetchResponseLike> {
  let res: FetchResponseLike;
  try {
    res = await fetchFn(url);
  } catch (e) {
    throw new AppError('MODEL_MISSING', `Không đọc được tệp mô hình "${fileName(url)}".`, true, e);
  }
  if (!res.ok) throw new AppError('MODEL_MISSING', `Không tìm thấy tệp mô hình "${fileName(url)}" (HTTP ${res.status}).`, true);
  return res;
}

async function fetchJson<T>(fetchFn: FetchLike, url: string, guard: (v: unknown) => v is T): Promise<T> {
  const res = await fetchOk(fetchFn, url);
  let value: unknown;
  try {
    value = await res.json();
  } catch (e) {
    throw new AppError('MODEL_CORRUPT', `Tệp "${fileName(url)}" không phải JSON hợp lệ.`, true, e);
  }
  if (!guard(value)) throw new AppError('MODEL_CORRUPT', `Tệp "${fileName(url)}" thiếu hoặc sai trường bắt buộc.`, true);
  return value;
}

async function fetchBytes(fetchFn: FetchLike, url: string): Promise<ArrayBuffer> {
  const res = await fetchOk(fetchFn, url);
  try {
    return await res.arrayBuffer();
  } catch (e) {
    throw new AppError('MODEL_MISSING', `Đọc dở tệp mô hình "${fileName(url)}".`, true, e);
  }
}

async function verifyBytes(buffer: ArrayBuffer, manifest: ModelManifest, checksum: boolean): Promise<void> {
  if (buffer.byteLength !== manifest.sizeBytes) {
    throw new AppError('MODEL_CORRUPT', `Tệp mô hình sai kích thước: nhận ${buffer.byteLength} byte, manifest ghi ${manifest.sizeBytes}.`, true);
  }
  if (!checksum) return;
  const subtle = globalThis.crypto?.subtle;
  if (!subtle) {
    throw new AppError('UNSUPPORTED_BROWSER', 'Thiếu crypto.subtle (cần HTTPS hoặc localhost) nên không kiểm tra được sha256; đặt verifyChecksum=false khi chạy thử qua http.', true);
  }
  const bytes = new Uint8Array(await subtle.digest('SHA-256', buffer));
  const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
  if (hex !== manifest.sha256.toLowerCase()) {
    throw new AppError('MODEL_CORRUPT', `Tệp mô hình sai sha256: nhận ${hex.slice(0, 12)}…, manifest ghi ${manifest.sha256.slice(0, 12)}….`, true);
  }
}

/** F4: tạo ort.Tensor [1,3,S,S], chạy session, trả RawModelOutput; luôn giải phóng tensor tạm. */
function makePredict(ort: OrtModule, session: InferenceSession, manifest: ModelManifest, size: number) {
  const dims = [1, 3, size, size];
  const expected = 3 * size * size;
  return async (tensor: Float32Array): Promise<RawModelOutput> => {
    if (tensor.length !== expected) {
      throw new AppError('INFERENCE_FAILED', `Tensor đầu vào có ${tensor.length} phần tử, cần ${expected} (1×3×${size}×${size}).`);
    }
    const input = new ort.Tensor('float32', tensor, dims);
    let outputs: InferenceSession.ReturnType | undefined;
    try {
      outputs = await session.run({ [manifest.inputName]: input }, [manifest.outputName]);
      const out = outputs[manifest.outputName];
      if (!out || !(out.data instanceof Float32Array)) {
        throw new AppError('INFERENCE_FAILED', `Đầu ra "${manifest.outputName}" thiếu hoặc không phải float32.`);
      }
      return { data: out.data, dims: [...out.dims] };
    } finally {
      input.dispose();
      if (outputs) for (const t of Object.values(outputs)) t.dispose();
    }
  };
}

/**
 * F1-F3: đọc manifest/config/classes, tải onnx, kiểm kích thước và sha256, khởi tạo ORT (WASM, hoặc thử WebGPU trước
 * nếu config.preferWebGpu và có navigator.gpu), chạy nóng một lần. Lỗi: MODEL_MISSING, MODEL_CORRUPT, MODEL_INIT_FAILED.
 */
export async function loadModel(o: LoadModelOptions): Promise<LoadedModel> {
  const now = o.now ?? systemClock;
  const fetchFn = o.fetchFn ?? ((url: string) => fetch(url));
  const runtime = o.runtime ?? readRuntimeEnv();
  const t0 = now();
  log.info(describeRuntime(runtime));

  const base = withSlash(o.baseUrl);
  const manifest = await fetchJson(fetchFn, `${base}model-manifest.json`, isManifest);
  const modelConfig = await fetchJson(fetchFn, `${base}model-config.json`, isModelConfig);
  const classes = await fetchJson(fetchFn, `${base}classes.json`, isClasses);
  const size = modelConfig.inputSize;
  const shape = manifest.inputShape;
  if (shape.length !== 4 || shape[2] !== size || shape[3] !== size) {
    throw new AppError('MODEL_CORRUPT', `model-manifest.json (inputShape ${shape.join('×')}) không khớp model-config.json (inputSize ${size}).`, true);
  }
  const buffer = await fetchBytes(fetchFn, `${base}${manifest.file}`);
  await verifyBytes(buffer, manifest, o.config.verifyChecksum);

  const threads = pickThreads(runtime);
  const backends: Backend[] = o.config.preferWebGpu && runtime.hasWebGpu ? ['webgpu', 'wasm'] : ['wasm'];
  let lastError: unknown;
  for (const backend of backends) {
    let session: InferenceSession | undefined;
    try {
      const ort = await (o.ortLoader ?? importOrt)(backend);
      ort.env.wasm.wasmPaths = withSlash(o.ortBaseUrl);
      ort.env.wasm.numThreads = threads;
      ort.env.wasm.simd = true;
      session = await ort.InferenceSession.create(new Uint8Array(buffer), { executionProviders: [backend], graphOptimizationLevel: 'all' });
      const tLoaded = now();
      const predict = makePredict(ort, session, manifest, size);
      await predict(new Float32Array(3 * size * size)); // F3: chạy nóng với tensor toàn 0
      const tWarm = now();
      const live = session;
      const info: ModelInfo = {
        version: manifest.version, inputSize: size, classCount: manifest.classCount,
        backend, threads, loadMs: tLoaded - t0, warmupMs: tWarm - tLoaded,
      };
      log.info('Mô hình sẵn sàng', info);
      return {
        info, manifest, config: modelConfig, classes, predict,
        dispose: async () => {
          try {
            await live.release();
          } catch (e) {
            log.warn('Giải phóng phiên ORT lỗi', e);
          }
        },
      };
    } catch (e) {
      lastError = e;
      log.warn(`Backend ${backend} không dùng được`, e);
      await session?.release().catch(() => undefined);
    }
  }
  const reason = lastError instanceof Error ? lastError.message : String(lastError);
  throw new AppError('MODEL_INIT_FAILED', `Không khởi tạo được ONNX Runtime: ${reason}`, true, lastError);
}
