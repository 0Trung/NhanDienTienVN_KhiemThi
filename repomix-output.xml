<file path="tests/fakes/fake-inference.ts">
import { AppError } from '../../src/contracts';
import type { CapturedFrame, FrameMeta, IInferenceClient, InferenceResult, ModelInfo } from '../../src/contracts';
import { makeInferenceResult } from './factories';

/** Một bước trong kịch bản: kết quả, null (khung bị bỏ), lỗi để ném, hoặc hàm tính kết quả theo khung. */
export type FakeInferenceStep =
  | InferenceResult
  | null
  | AppError
  | ((frame: CapturedFrame) => InferenceResult | null);

export interface FakeInferenceOptions {
  /** Nếu đặt, init() ném lỗi này. */
  initError?: AppError;
  info?: Partial<ModelInfo>;
}

/**
 * Bộ suy luận giả chạy theo kịch bản (hàng đợi). Hết kịch bản thì trả kết quả rỗng (không có tiền).
 * Luôn close bitmap của khung (đúng hợp đồng IInferenceClient), kể cả khi ném lỗi.
 * infer trước init ném INFERENCE_FAILED để lộ lỗi sai thứ tự gọi.
 */
export class FakeInference implements IInferenceClient {
  readonly inferred: FrameMeta[] = [];
  initCalls = 0;
  inferCalls = 0;
  disposeCalls = 0;
  initError: AppError | null;

  private isReady = false;
  private readonly info: ModelInfo;
  private readonly queue: FakeInferenceStep[] = [];

  constructor(options: FakeInferenceOptions = {}) {
    this.initError = options.initError ?? null;
    this.info = {
      version: 'fake',
      inputSize: 640,
      classCount: 9,
      backend: 'wasm',
      threads: 1,
      loadMs: 0,
      warmupMs: 0,
      ...options.info,
    };
  }

  get ready(): boolean {
    return this.isReady;
  }

  /** Thêm các bước vào cuối kịch bản. */
  enqueue(...steps: FakeInferenceStep[]): this {
    this.queue.push(...steps);
    return this;
  }

  async init(): Promise<ModelInfo> {
    this.initCalls += 1;
    if (this.initError) throw this.initError;
    this.isReady = true;
    return { ...this.info };
  }

  async infer(frame: CapturedFrame): Promise<InferenceResult | null> {
    this.inferCalls += 1;
    this.inferred.push(frame.meta);
    try {
      if (!this.isReady) throw new AppError('INFERENCE_FAILED', 'FakeInference: infer được gọi trước init');
      const step = this.queue.shift();
      if (step === undefined) return makeInferenceResult({ meta: frame.meta });
      if (step === null) return null;
      if (typeof step === 'function') return step(frame);
      if (step instanceof AppError) throw step;
      return step;
    } finally {
      frame.bitmap.close();
    }
  }

  dispose(): void {
    this.disposeCalls += 1;
    this.isReady = false;
  }
}
</file>

<file path="tests/fakes/fake-speech.ts">
import type {
  ISpeech,
  RecognitionResult,
  SpeechIntent,
  TtsCapabilities,
  UtteranceEvent,
} from '../../src/contracts';

export interface FakeSpeechOptions {
  /** true (mặc định): say() phát ngay sự kiện utterance 'start'; 'end' chỉ phát khi gọi finishCurrent(). */
  autoStart?: boolean;
  capabilities?: Partial<TtsCapabilities>;
}

/** ISpeech giả: ghi lại mọi SpeechIntent và mô phỏng sự kiện utterance. */
export class FakeSpeech implements ISpeech {
  readonly intents: SpeechIntent[] = [];
  initCalls = 0;
  unlockCalls = 0;
  replayCalls = 0;
  cancelCalls = 0;

  private speaking = false;
  private current: SpeechIntent | null = null;
  private lastResult: RecognitionResult | null = null;
  private readonly autoStart: boolean;
  private readonly capabilities: TtsCapabilities;
  private readonly handlers = new Set<(e: UtteranceEvent) => void>();

  constructor(options: FakeSpeechOptions = {}) {
    this.autoStart = options.autoStart ?? true;
    this.capabilities = {
      available: true,
      vietnameseVoice: true,
      offlineVietnamese: true,
      requiresUserGesture: false,
      ...options.capabilities,
    };
  }

  get isSpeaking(): boolean {
    return this.speaking;
  }

  get lastIntent(): SpeechIntent | undefined {
    return this.intents.at(-1);
  }

  async init(): Promise<TtsCapabilities> {
    this.initCalls += 1;
    return { ...this.capabilities };
  }

  unlock(): void {
    this.unlockCalls += 1;
  }

  say(intent: SpeechIntent): void {
    this.intents.push(intent);
    if (intent.kind === 'RESULT') this.lastResult = intent.result;
    if (this.autoStart) {
      this.current = intent;
      this.speaking = true;
      this.emitUtterance({ phase: 'start', kind: intent.kind });
    }
  }

  /** Giống ISpeech thật: đọc lại kết quả gần nhất, hoặc REPLAY_EMPTY nếu chưa có. */
  replayLast(): void {
    this.replayCalls += 1;
    this.say(this.lastResult ? { kind: 'REPLAY', result: this.lastResult } : { kind: 'REPLAY_EMPTY' });
  }

  cancelAll(): void {
    this.cancelCalls += 1;
    this.current = null;
    this.speaking = false;
  }

  onUtterance(handler: (e: UtteranceEvent) => void): () => void {
    this.handlers.add(handler);
    return () => {
      this.handlers.delete(handler);
    };
  }

  /** Kết thúc câu hiện tại (phát sự kiện 'end'). Trả false nếu không có câu nào. */
  finishCurrent(): boolean {
    if (this.current === null) return false;
    const { kind } = this.current;
    this.current = null;
    this.speaking = false;
    this.emitUtterance({ phase: 'end', kind });
    return true;
  }

  /** Tự phát một sự kiện utterance tới mọi handler. */
  emitUtterance(event: UtteranceEvent): void {
    for (const handler of [...this.handlers]) handler(event);
  }

  /** Các ý định đã nói thuộc một loại, ví dụ ofKind('GUIDANCE'). */
  ofKind<K extends SpeechIntent['kind']>(kind: K): Array<Extract<SpeechIntent, { kind: K }>> {
    return this.intents.filter((i): i is Extract<SpeechIntent, { kind: K }> => i.kind === kind);
  }
}
</file>

<file path="tests/fakes/fake-tts-engine.ts">
import type { ITtsEngine, TtsCapabilities, TtsHooks } from '../../src/contracts';

export interface SpokenUtterance { text: string; rate: number; lang: string; audioKey?: string }

export interface FakeTtsEngineOptions {
  name?: ITtsEngine['name'];
  capabilities?: Partial<TtsCapabilities>;
  /** Nếu đặt, init() bị từ chối với giá trị này. */
  initError?: unknown;
}

/**
 * Engine đọc giả. KHÔNG tự kết thúc: test gọi finishCurrent() để báo onEnd (hoặc failCurrent() để báo onError).
 * - requiresUserGesture = true: speak bị từ chối (onError, ghi vào `rejected`) cho tới khi unlock() được gọi.
 * - speak khi đang có câu phát: câu mới thay câu cũ (không báo hook của câu cũ) và tăng `overlappingSpeaks`.
 * - cancel(): bỏ câu hiện tại, KHÔNG gọi onEnd.
 */
export class FakeTtsEngine implements ITtsEngine {
  readonly name: ITtsEngine['name'];
  readonly spoken: SpokenUtterance[] = [];
  readonly rejected: SpokenUtterance[] = [];
  unlockCalls = 0;
  cancelCalls = 0;
  overlappingSpeaks = 0;

  private readonly capabilities: TtsCapabilities;
  private readonly initError: unknown;
  private unlocked = false;
  private active: { utterance: SpokenUtterance; hooks: TtsHooks } | null = null;

  constructor(options: FakeTtsEngineOptions = {}) {
    this.name = options.name ?? 'native-tts';
    this.initError = options.initError;
    this.capabilities = {
      available: true,
      vietnameseVoice: true,
      offlineVietnamese: true,
      requiresUserGesture: false,
      ...options.capabilities,
    };
  }

  get isSpeaking(): boolean {
    return this.active !== null;
  }

  get texts(): string[] {
    return this.spoken.map((u) => u.text);
  }

  async init(): Promise<TtsCapabilities> {
    if (this.initError !== undefined) throw this.initError;
    return { ...this.capabilities };
  }

  unlock(): void {
    this.unlockCalls += 1;
    this.unlocked = true;
  }

  speak(text: string, opts: { rate: number; lang: string; audioKey?: string }, hooks: TtsHooks): void {
    const utterance: SpokenUtterance = { text, rate: opts.rate, lang: opts.lang, audioKey: opts.audioKey };
    if (this.capabilities.requiresUserGesture && !this.unlocked) {
      this.rejected.push(utterance);
      hooks.onError(new Error('FakeTtsEngine: cần unlock() trước khi phát'));
      return;
    }
    if (this.active !== null) this.overlappingSpeaks += 1;
    this.spoken.push(utterance);
    this.active = { utterance, hooks };
    hooks.onStart();
  }

  cancel(): void {
    this.cancelCalls += 1;
    this.active = null;
  }

  /** Kết thúc câu hiện tại (gọi onEnd). Trả false nếu không có câu nào đang phát. */
  finishCurrent(): boolean {
    if (this.active === null) return false;
    const { hooks } = this.active;
    this.active = null;
    hooks.onEnd();
    return true;
  }

  /** Làm câu hiện tại thất bại (gọi onError). Trả false nếu không có câu nào đang phát. */
  failCurrent(error: unknown = new Error('FakeTtsEngine: lỗi phát giả lập')): boolean {
    if (this.active === null) return false;
    const { hooks } = this.active;
    this.active = null;
    hooks.onError(error);
    return true;
  }
}
</file>

<file path="tests/fakes/fakes.test.ts">
import { describe, expect, it, vi } from 'vitest';
import { DEFAULT_CONFIG, DEFAULT_SETTINGS } from '../../src/config/app-config';
import { AppError } from '../../src/contracts';
import type { CameraStatus, FrameAnalysis, UtteranceEvent } from '../../src/contracts';
import { center } from '../../src/utils/geometry';
import {
  FakeCamera,
  FakeHaptics,
  FakeInference,
  FakeSpeech,
  FakeTtsEngine,
  MemorySettingsStore,
  makeAnalysis,
  makeConflictAnalysis,
  makeDetection,
  makeInferenceResult,
  makeOverlapAnalysis,
  makeSingleSureAnalysis,
  makeStableAnalysis,
  makeUnsureAnalysis,
} from './index';

const SPEAK_OPTS = { rate: 1, lang: 'vi-VN' };

function makeHooks() {
  return { onStart: vi.fn(), onEnd: vi.fn(), onError: vi.fn() };
}

describe('FakeTtsEngine', () => {
  it('speak báo onStart ngay và chỉ báo onEnd khi finishCurrent', () => {
    const engine = new FakeTtsEngine();
    const hooks = makeHooks();
    engine.speak('xin chào', SPEAK_OPTS, hooks);
    expect(hooks.onStart).toHaveBeenCalledTimes(1);
    expect(hooks.onEnd).not.toHaveBeenCalled();
    expect(engine.isSpeaking).toBe(true);

    expect(engine.finishCurrent()).toBe(true);
    expect(hooks.onEnd).toHaveBeenCalledTimes(1);
    expect(engine.isSpeaking).toBe(false);
    expect(engine.texts).toEqual(['xin chào']);
  });

  it('finishCurrent khi không có câu nào trả false', () => {
    expect(new FakeTtsEngine().finishCurrent()).toBe(false);
  });

  it('requiresUserGesture: từ chối phát cho tới khi unlock', () => {
    const engine = new FakeTtsEngine({ capabilities: { requiresUserGesture: true } });
