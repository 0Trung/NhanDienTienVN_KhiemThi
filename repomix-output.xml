      single,
      makeRaw(64, 'channels_first', []),
    ];
    const pp = createPostProcessor({ classMap: CLASS_MAP, inference: INFERENCE });
    const results: Detection[][] = [];
    const snapshots: Detection[][] = [];
    frames.forEach((raw, i) => {
