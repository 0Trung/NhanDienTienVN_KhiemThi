<file path="src/accessibility/aria-live-engine.ts">
/**
 * Engine "aria-live" (F4): đọc bằng TRÌNH ĐỌC MÀN HÌNH của người dùng (TalkBack, VoiceOver) thay cho giọng của app.
 * speak() ghi chữ vào một vùng aria-live="assertive" được ẩn khỏi mắt bằng clip (KHÔNG dùng display:none hay
 * aria-hidden vì trình đọc màn hình sẽ bỏ qua). Câu giống hệt câu trước vẫn được đọc lại: vùng bị xóa trước,
 * rồi ghi lại sau REWRITE_DELAY_MS. Nhịp 0 ms hay một khung hình có thể bị gộp thành "không đổi"; 100 ms là
 * giá trị các thư viện trợ năng thường dùng. Cần thử TalkBack thật để chỉnh.
 *
 * GIỚI HẠN (đã biết, không khắc phục được từ phía web):
 * 1. Không biết lúc nào trình đọc màn hình nói xong, nên onEnd bắn theo THỜI GIAN ƯỚC LƯỢNG
 *    max(MIN_SPEECH_MS, độ dài chữ × MS_PER_CHAR ÷ rate), tính từ lúc gọi speak(). Ước lượng sai thì hai câu có thể
 *    chồng nhau hoặc có khoảng lặng thừa.
 * 2. Không điều khiển được giọng, tốc độ, cao độ: rate chỉ dùng để ước lượng thời gian, audioKey bị bỏ qua.
 *    Giọng do cài đặt trình đọc màn hình của người dùng quyết định.
 * 3. capabilities.vietnameseVoice và offlineVietnamese luôn true theo GIẢ ĐỊNH (không kiểm chứng được); available
 *    chỉ nói "có DOM để ghi", không nói trình đọc màn hình có đang bật hay không. Nếu nó tắt thì KHÔNG có tiếng nào:
 *    P11 chỉ nên chọn engine này khi speechOutput là SCREEN_READER.
 * 4. Vùng assertive có thể cắt ngang câu trình đọc màn hình đang nói; đó là chủ ý (kết quả phải đến ngay).
 * 5. cancel() chỉ xóa vùng; câu trình đọc màn hình đã bắt đầu nói có thể vẫn nói nốt.
 */
import { AppError } from '../contracts';
import type { ITtsEngine, TtsCapabilities } from '../contracts';
import { ROLE_ATTR, safeCall, setStyles } from './a11y-shared';

/** Thời gian đọc ước lượng cho mỗi ký tự ở rate 1.0 (ms). */
export const MS_PER_CHAR = 70;
/** Thời gian đọc ước lượng tối thiểu (ms), kể cả câu rất ngắn. */
export const MIN_SPEECH_MS = 800;
/** Độ trễ giữa lúc xóa vùng và lúc ghi lại chữ (ms). */
export const REWRITE_DELAY_MS = 100;

const VISUALLY_HIDDEN: Readonly<Record<string, string>> = {
  position: 'absolute', width: '1px', height: '1px', margin: '-1px', padding: '0', border: '0',
  overflow: 'hidden', clip: 'rect(0, 0, 0, 0)', 'clip-path': 'inset(50%)', 'white-space': 'nowrap',
};

/** Thời gian (ms) trình đọc màn hình ước chừng cần để đọc xong text ở tốc độ rate. rate không hợp lệ thì coi là 1. */
export function estimateSpeechMs(text: string, rate: number): number {
  const safeRate = Number.isFinite(rate) && rate > 0 ? rate : 1;
  return Math.max(MIN_SPEECH_MS, (text.length * MS_PER_CHAR) / safeRate);
}

type Timer = ReturnType<typeof setTimeout>;
interface Utterance { write: Timer | null; end: Timer | null }

export function createAriaLiveEngine(o?: { root?: HTMLElement }): ITtsEngine {
  let region: HTMLElement | null = null;
  let active: Utterance | null = null;

  const hasDom = (): boolean => o?.root !== undefined || typeof document !== 'undefined';

  function ensureRegion(): HTMLElement | null {
    if (region !== null && region.isConnected) return region;
    const host = o?.root ?? (typeof document === 'undefined' ? null : document.body ?? null);
    if (host === null) return null;
    // Vùng phải có sẵn trong DOM TRƯỚC khi nội dung đổi thì trình đọc màn hình mới theo dõi nó: dựng ở init().
    const el = host.ownerDocument.createElement('div');
    el.setAttribute(ROLE_ATTR, 'live-region');
    el.setAttribute('aria-live', 'assertive');
    el.setAttribute('aria-atomic', 'true');
    setStyles(el, VISUALLY_HIDDEN);
    host.appendChild(el);
    region = el;
    return el;
  }

  function stopActive(): void {
    if (active === null) return;
    if (active.write !== null) clearTimeout(active.write);
    if (active.end !== null) clearTimeout(active.end);
    active = null;
  }

  return {
    name: 'aria-live',

    async init(): Promise<TtsCapabilities> {
      ensureRegion();
      return { available: hasDom(), vietnameseVoice: true, offlineVietnamese: true, requiresUserGesture: false };
    },

    unlock(): void {
      ensureRegion(); // trình đọc màn hình không cần mở khóa; chỉ bảo đảm vùng đã có trong DOM
    },

    speak(text, opts, hooks): void {
      const el = ensureRegion();
      if (el === null) {
        safeCall('onError', () => hooks.onError(new AppError('TTS_UNAVAILABLE', 'Không có DOM để đọc bằng trình đọc màn hình.')));
        return;
      }
      stopActive(); // câu mới thay câu cũ; hook của câu cũ không được gọi
      el.setAttribute('lang', opts.lang);
      el.textContent = ''; // xóa trước để câu giống hệt vẫn là một thay đổi
      const utterance: Utterance = { write: null, end: null };
      utterance.write = setTimeout(() => {
        utterance.write = null;
        el.textContent = text;
      }, REWRITE_DELAY_MS);
      utterance.end = setTimeout(() => {
        if (active !== utterance) return;
        active = null;
        safeCall('onEnd', hooks.onEnd);
      }, estimateSpeechMs(text, opts.rate));
      active = utterance;
      safeCall('onStart', hooks.onStart);
    },

    cancel(): void {
      stopActive(); // bỏ câu hiện tại, KHÔNG gọi onEnd (giống các engine khác)
      if (region !== null) region.textContent = '';
    },
  };
}
</file>

<file path="src/accessibility/gesture-controller.ts">
/**
 * Cử chỉ trên bề mặt camera (F2): chạm = nghe lại kết quả; giữ 600 ms = bật/tắt đèn.
 *
 * LƯU Ý NỀN TẢNG: khi TalkBack hoặc VoiceOver bật, chạm một lần chỉ là khám phá, chạm hai lần mới kích hoạt;
 * bộ lắng nghe cử chỉ tự viết sẽ không nhận được chạm đơn. Vì vậy cử chỉ này CHỈ là đường tắt cho người dùng
 * không bật trình đọc màn hình. Mọi thao tác đều phải làm được bằng button thật (xem accessibility-manager):
 * nút "Nghe lại kết quả" DUY NHẤT, nằm đầu thứ tự focus, do accessibility-manager dựng; controller này
 * không dựng thêm nút nào để không trùng nhãn.
 *
 * Cách làm: dùng Pointer Events; hủy khi ngón di chuyển quá ngưỡng hoặc có ngón thứ hai. Chống kích hoạt kép:
 * sau pointerup trình duyệt còn bắn thêm sự kiện click, nên click đó bị bỏ qua trong CLICK_SWALLOW_MS. Click "thuần"
 * (không có pointer đi trước, ví dụ trình đọc màn hình kích hoạt phần tử) vẫn được coi là một lần chạm.
 */
import { safeCall } from './a11y-shared';

/** Giữ đủ lâu thì bật/tắt đèn (ms). */
export const HOLD_MS = 600;
/** Ngón di chuyển quá khoảng này (px) thì không còn là chạm/giữ. */
export const MOVE_TOLERANCE_PX = 10;
/** Thời gian bỏ qua click đi kèm một cử chỉ pointer vừa xử lý (ms). */
export const CLICK_SWALLOW_MS = 400;

type Timer = ReturnType<typeof setTimeout>;
interface Press { id: number; x: number; y: number; invalid: boolean; holdFired: boolean; timer: Timer | null }

export function createGestureController(
  o: { surface: HTMLElement; onReplay: () => void; onToggleTorch: () => void },
): { dispose(): void } {
  const { surface } = o;
  const cleanups: Array<() => void> = [];
  let press: Press | null = null;
  let swallowClick = false;
  let swallowTimer: Timer | null = null;
  let disposed = false;

  const stopHold = (p: Press): void => {
    if (p.timer !== null) clearTimeout(p.timer);
    p.timer = null;
  };
  const clearSwallow = (): void => {
    if (swallowTimer !== null) clearTimeout(swallowTimer);
    swallowTimer = null;
    swallowClick = false;
  };
  const swallowNextClick = (): void => {
    clearSwallow();
    swallowClick = true;
    swallowTimer = setTimeout(clearSwallow, CLICK_SWALLOW_MS);
  };
  const on = <K extends keyof HTMLElementEventMap>(type: K, handler: (e: HTMLElementEventMap[K]) => void): void => {
    surface.addEventListener(type, handler);
    cleanups.push(() => surface.removeEventListener(type, handler));
  };

  on('pointerdown', (e) => {
    if (e.button !== 0) return; // chỉ chạm / bút / nút chính của chuột
    if (press !== null && press.id !== e.pointerId) { // ngón thứ hai: không còn là chạm đơn
      press.invalid = true;
      stopHold(press);
      return;
    }
    if (press !== null) stopHold(press);
    const current: Press = { id: e.pointerId, x: e.clientX, y: e.clientY, invalid: false, holdFired: false, timer: null };
    current.timer = setTimeout(() => {
      current.timer = null;
      if (press !== current || current.invalid) return;
      current.holdFired = true;
      safeCall('onToggleTorch', o.onToggleTorch);
    }, HOLD_MS);
    press = current;
  });

  on('pointermove', (e) => {
    if (press === null || press.id !== e.pointerId || press.invalid) return;
    if (Math.hypot(e.clientX - press.x, e.clientY - press.y) > MOVE_TOLERANCE_PX) {
      press.invalid = true; // kéo quá ngưỡng: hủy cả chạm lẫn giữ
      stopHold(press);
    }
  });

  on('pointerup', (e) => {
    if (press === null || press.id !== e.pointerId) return;
    const done = press;
    stopHold(done);
    press = null;
    swallowNextClick(); // click đi kèm (nếu có) không được tính lần hai
    if (!done.invalid && !done.holdFired) safeCall('onReplay', o.onReplay);
  });

  const cancel = (e: PointerEvent): void => {
    if (press === null || press.id !== e.pointerId) return;
    stopHold(press);
    press = null;
  };
  on('pointercancel', cancel);
  on('pointerleave', cancel); // chuột rời bề mặt khi đang giữ

  on('click', () => {
    if (swallowClick) {
      clearSwallow();
      return;
    }
    safeCall('onReplay', o.onReplay);
  });

  // Giữ lâu trên Android mở menu ngữ cảnh của hệ thống: chặn để không phá cử chỉ giữ.
  on('contextmenu', (e) => e.preventDefault());

  // touch-action: manipulation tắt phóng to bằng chạm đúp (nếu không, chạm hai lần để nghe lại sẽ phóng to trang).
  const previous = { touchAction: surface.style.getPropertyValue('touch-action'), userSelect: surface.style.getPropertyValue('user-select') };
  surface.style.setProperty('touch-action', 'manipulation');
  surface.style.setProperty('user-select', 'none');

  return {
    dispose(): void {
      if (disposed) return;
      disposed = true;
      if (press !== null) stopHold(press);
      press = null;
      clearSwallow();
      for (const undo of cleanups) undo();
      surface.style.setProperty('touch-action', previous.touchAction);
      surface.style.setProperty('user-select', previous.userSelect);
    },
  };
}
</file>

<file path="src/accessibility/settings-manager.ts">
/**
 * Quản lý cài đặt trong bộ nhớ (F5): bọc ISettingsStore thành trạng thái có get / set(patch) / subscribe.
 * Mỗi thay đổi được ÁP DỤNG NGAY, rồi lưu xuống store (bất đồng bộ, đúng thứ tự):
 * - --font-scale trên <html> (P11 dùng calc(1rem * var(--font-scale))); data-contrast="high|normal" cùng các biến
 *   --a11y-fg, --a11y-bg, --a11y-border-width khi tương phản cao; data-motion="reduce|full" và --motion-scale
 *   theo prefers-reduced-motion; data-speech-output="APP_TTS|SCREEN_READER" (accessibility-manager đọc thuộc tính này).
 * - Phát SettingAck qua onAck SAU khi trạng thái đã đổi (speech manager đọc get() mới) để giọng nói xác nhận.
 *   Chỉ phát khi giá trị thật sự đổi. Khối B chưa có mã ack cho: tắt giọng nói, chữ lớn, tương phản cao, cách đọc,
 *   tự bật camera; các mục đó không phát ack (xem "Đề xuất sửa hợp đồng").
 * Giá trị ngoài phạm vi bị kẹp: fontScale trong [1, 2]; speechRate chỉ ba mức 0.8 / 1.0 / 1.2 (lấy mức gần nhất,
 * cách đều thì lấy mức chậm hơn); trường sai kiểu thì giữ giá trị cũ.
 * prefers-contrast: highContrast = false được coi là "chưa chọn" lúc nạp: nếu hệ điều hành đòi tương phản cao thì
 * trạng thái trong bộ nhớ là true (KHÔNG lưu xuống store). Khi người dùng tự đặt highContrast thì lựa chọn đó thắng.
 * Lỗi store: nạp lỗi thì giữ giá trị hiện có; lưu lỗi thì giá trị vẫn có hiệu lực trong phiên và chỉ ghi log.
 */
import { DEFAULT_SETTINGS } from '../config/app-config';
import type { ISettingsStore, SettingAck, Settings } from '../contracts';
import { createLogger } from '../utils/logger';
import { clamp } from '../utils/math';
import { SPEECH_OUTPUT_ATTR, safeCall } from './a11y-shared';

const log = createLogger('settings');

export const FONT_SCALE_MIN = 1;
export const FONT_SCALE_MAX = 2;
export const SPEECH_RATES = [0.8, 1.0, 1.2] as const;

const QUERY_CONTRAST_MORE = '(prefers-contrast: more)';
const QUERY_REDUCED_MOTION = '(prefers-reduced-motion: reduce)';
const HIGH_CONTRAST_VARS: ReadonlyArray<readonly [string, string]> = [
  ['--a11y-fg', '#ffffff'], ['--a11y-bg', '#000000'], ['--a11y-border-width', '4px'],
];

/** Tham số phụ (tùy chọn) để tiêm DOM và truy vấn media khi test; P11 gọi hai tham số vẫn đúng. */
export interface SettingsManagerOptions {
  /** Phần tử nhận biến CSS và thuộc tính data-*; mặc định <html>. Không có DOM thì chỉ giữ trạng thái. */
  target?: HTMLElement;
  /** Truy vấn media (prefers-*); mặc định window.matchMedia. */
  matchMedia?: (query: string) => { matches: boolean };
}

export interface SettingsManager {
  load(): Promise<Settings>;
  get(): Settings;
  set(p: Partial<Settings>): Promise<Settings>;
  subscribe(h: (s: Settings) => void): () => void;
}

function snapRate(value: unknown, fallback: number): number {
  if (typeof value !== 'number' || Number.isNaN(value)) return fallback;
  let best: number = SPEECH_RATES[0];
  for (const rate of SPEECH_RATES) if (Math.abs(rate - value) < Math.abs(best - value)) best = rate;
  return best;
}

const pickBool = (value: unknown, fallback: boolean): boolean => (typeof value === 'boolean' ? value : fallback);

/** Gộp input lên base, kẹp giá trị và bỏ qua trường sai kiểu. Không mang theo khóa lạ. */
function sanitize(input: Partial<Settings>, base: Settings): Settings {
  return {
    schemaVersion: 1,
    voiceEnabled: pickBool(input.voiceEnabled, base.voiceEnabled),
    voiceLanguage: 'vi-VN',
    speechRate: snapRate(input.speechRate, base.speechRate),
    verbosity: input.verbosity === 'BRIEF' || input.verbosity === 'DETAILED' ? input.verbosity : base.verbosity,
    speechOutput: input.speechOutput === 'APP_TTS' || input.speechOutput === 'SCREEN_READER' ? input.speechOutput : base.speechOutput,
    vibrationEnabled: pickBool(input.vibrationEnabled, base.vibrationEnabled),
    torchEnabled: pickBool(input.torchEnabled, base.torchEnabled),
    fontScale: typeof input.fontScale === 'number' && !Number.isNaN(input.fontScale)
      ? clamp(input.fontScale, FONT_SCALE_MIN, FONT_SCALE_MAX) : base.fontScale,
    highContrast: pickBool(input.highContrast, base.highContrast),
    autoStartCamera: pickBool(input.autoStartCamera, base.autoStartCamera),
    modelVersion: typeof input.modelVersion === 'string' && input.modelVersion !== '' ? input.modelVersion : base.modelVersion,
  };
}

function diff(prev: Settings, next: Settings): Partial<Settings> {
  const changed: Partial<Settings> = {};
  for (const key of Object.keys(next) as Array<keyof Settings>) {
    if (next[key] !== prev[key]) Object.assign(changed, { [key]: next[key] });
  }
  return changed;
}

/** Mã ack cho các trường vừa đổi (chỉ những trường Khối B có mã). Bật giọng nói có ack, tắt thì im lặng theo bản chất. */
function acksFor(changed: Partial<Settings>): SettingAck[] {
  const acks: SettingAck[] = [];
  if (changed.voiceEnabled === true) acks.push('VOICE_ON');
  if (changed.speechRate !== undefined) {
    acks.push(changed.speechRate <= SPEECH_RATES[0] ? 'RATE_SLOW' : changed.speechRate >= SPEECH_RATES[2] ? 'RATE_FAST' : 'RATE_NORMAL');
  }
  if (changed.verbosity !== undefined) acks.push(changed.verbosity === 'BRIEF' ? 'VERBOSITY_BRIEF' : 'VERBOSITY_DETAILED');
  if (changed.vibrationEnabled !== undefined) acks.push(changed.vibrationEnabled ? 'VIBRATION_ON' : 'VIBRATION_OFF');
  if (changed.torchEnabled !== undefined) acks.push(changed.torchEnabled ? 'TORCH_ON' : 'TORCH_OFF');
  return acks;
}

export function createSettingsManager(
  store: ISettingsStore,
  onAck: (a: SettingAck) => void,
  options?: SettingsManagerOptions,
): SettingsManager {
  let state: Settings = { ...DEFAULT_SETTINGS };
  let contrastChosen = false;
  let saveChain: Promise<void> = Promise.resolve();
  const listeners = new Set<(s: Settings) => void>();
  const target = options?.target ?? (typeof document === 'undefined' ? null : document.documentElement);
  const media = options?.matchMedia
    ?? (typeof window !== 'undefined' && typeof window.matchMedia === 'function' ? (q: string) => window.matchMedia(q) : null);
  const prefers = (query: string): boolean => {
    try {
      return media?.(query).matches === true;
    } catch {
      return false;
    }
  };

  function apply(): void {
    if (target === null) return;
    const reduceMotion = prefers(QUERY_REDUCED_MOTION);
    target.style.setProperty('--font-scale', String(state.fontScale));
    target.style.setProperty('--motion-scale', reduceMotion ? '0' : '1');
    for (const [name, value] of HIGH_CONTRAST_VARS) {
      if (state.highContrast) target.style.setProperty(name, value);
      else target.style.removeProperty(name);
    }
    target.setAttribute('data-contrast', state.highContrast ? 'high' : 'normal');
    target.setAttribute('data-motion', reduceMotion ? 'reduce' : 'full');
    target.setAttribute(SPEECH_OUTPUT_ATTR, state.speechOutput);
  }

  function emit(): void {
    for (const handler of [...listeners]) safeCall('subscribe', () => handler({ ...state }));
  }

  /** Lưu theo hàng đợi để thứ tự ghi đúng thứ tự gọi; lỗi lưu không làm hỏng set(). */
  function persist(patch: Partial<Settings>): Promise<void> {
    saveChain = saveChain
      .then(() => store.save(patch))
      .then(() => undefined, (error: unknown) => log.warn('Không lưu được cài đặt:', error));
    return saveChain;
  }

  return {
    async load(): Promise<Settings> {
      try {
        state = sanitize(await store.load(), DEFAULT_SETTINGS);
      } catch (error) {
        log.warn('Không nạp được cài đặt, giữ giá trị hiện có:', error);
      }
      if (!contrastChosen && !state.highContrast && prefers(QUERY_CONTRAST_MORE)) state = { ...state, highContrast: true };
      apply();
      emit();
      return { ...state };
    },

    get(): Settings {
      return { ...state };
    },

    async set(p: Partial<Settings>): Promise<Settings> {
      if (p.highContrast !== undefined) contrastChosen = true;
      const next = sanitize({ ...state, ...p }, state);
      const changed = diff(state, next);
      if (Object.keys(changed).length === 0) return { ...state };
      state = next;
      apply();
      emit();
      for (const ack of acksFor(changed)) safeCall('onAck', () => onAck(ack));
      await persist(changed);
      return { ...state };
    },

    subscribe(h: (s: Settings) => void): () => void {
      listeners.add(h);
      return () => {
        listeners.delete(h);
      };
    },
  };
}
</file>

<file path="src/accessibility/settings-view-model.ts">
/**
 * Mô tả các mục màn hình Cài đặt (F6) cho P11 dựng: nhãn tiếng Việt, kiểu (công tắc / nhóm radio / hành động),
 * giá trị hiện tại và hàm đổi. KHÔNG có mục chỉnh ngưỡng confidence: ngưỡng nhận dạng là việc của nhóm phát triển,
 * người dùng khiếm thị không thể tự kiểm chứng nên không được phép làm app "dễ tính" hơn (nguyên tắc Fail Safe).
 *
 * - value và valueText là getter: luôn phản ánh cài đặt MỚI NHẤT, P11 chỉ cần dựng lại khi settings-manager.subscribe báo.
 * - valueText luôn có chữ ("Bật", "Tắt", "Chậm"...) để trạng thái không phụ thuộc màu hay vị trí gạt.
 * - Mọi thay đổi đi qua hàm set của bên gọi (settings-manager.set) nên được áp dụng, lưu và xác nhận bằng giọng nói.
 * - Radio dùng giá trị chuỗi ('0.8', '1', '1.2' cho tốc độ) để khớp thẳng với <input type="radio">; chuỗi lạ bị bỏ qua.
 * - "Nghe lại hướng dẫn" là hành động chứ không phải cài đặt: truyền o.onReplayGuide để nối, không có thì run() không làm gì.
 */
import type { Settings } from '../contracts';
import { safeCall } from './a11y-shared';
import { SPEECH_RATES } from './settings-manager';

/** Chữ lớn bật = hệ số 1.5 (nằm trong khoảng 1..2 mà settings-manager cho phép); tắt = 1. */
export const LARGE_FONT_SCALE = 1.5;

export type SettingsItemId =
  | 'voice' | 'speechRate' | 'verbosity' | 'speechOutput' | 'vibration'
  | 'largeText' | 'highContrast' | 'autoStartCamera' | 'replayGuide';

interface ItemBase { readonly id: SettingsItemId; readonly label: string }

/** Công tắc bật/tắt. */
export interface SwitchItem extends ItemBase {
  readonly kind: 'switch';
  readonly value: boolean;
  readonly valueText: string;
  set(on: boolean): Promise<Settings>;
  toggle(): Promise<Settings>;
}

export interface RadioOption { readonly value: string; readonly label: string }

/** Nhóm lựa chọn một trong nhiều. */
export interface RadioItem extends ItemBase {
  readonly kind: 'radio';
  readonly value: string;
  readonly valueText: string;
  readonly options: readonly RadioOption[];
  set(value: string): Promise<Settings>;
}

/** Nút hành động (không lưu gì vào cài đặt). */
export interface ActionItem extends ItemBase {
  readonly kind: 'action';
  run(): void;
}

export type SettingsItem = SwitchItem | RadioItem | ActionItem;

type Setter = (p: Partial<Settings>) => Promise<Settings>;

function toSwitch(id: SettingsItemId, label: string, read: () => boolean, patch: (on: boolean) => Partial<Settings>, apply: Setter): SwitchItem {
  const change = (on: boolean): Promise<Settings> => apply(patch(on));
  return {
    id, label, kind: 'switch',
    get value() { return read(); },
    get valueText() { return read() ? 'Bật' : 'Tắt'; },
    set: change,
    toggle: () => change(!read()),
  };
}

function toRadio(
  id: SettingsItemId, label: string, options: readonly RadioOption[], read: () => string,
  patch: (value: string) => Partial<Settings> | null, apply: Setter, current: () => Settings,
): RadioItem {
  return {
    id, label, kind: 'radio', options,
    get value() { return read(); },
    get valueText() { return options.find((option) => option.value === read())?.label ?? ''; },
    set(value: string) {
      const p = patch(value);
      return p === null ? Promise.resolve(current()) : apply(p);
    },
  };
}

export function buildSettingsViewModel(
  get: () => Settings,
  set: (p: Partial<Settings>) => Promise<Settings>,
  o?: { onReplayGuide?: () => void },
): SettingsItem[] {
  return [
    toSwitch('voice', 'Giọng nói', () => get().voiceEnabled, (on) => ({ voiceEnabled: on }), set),
    toRadio('speechRate', 'Tốc độ đọc', [
      { value: '0.8', label: 'Chậm' }, { value: '1', label: 'Bình thường' }, { value: '1.2', label: 'Nhanh' },
    ], () => String(get().speechRate), (value) => {
      const rate = Number(value);
      return (SPEECH_RATES as readonly number[]).includes(rate) ? { speechRate: rate } : null;
    }, set, get),
    toRadio('verbosity', 'Chế độ đọc', [
      { value: 'BRIEF', label: 'Ngắn gọn' }, { value: 'DETAILED', label: 'Chi tiết' },
    ], () => get().verbosity, (value) => (value === 'BRIEF' || value === 'DETAILED' ? { verbosity: value } : null), set, get),
    toRadio('speechOutput', 'Đọc bằng', [
      { value: 'APP_TTS', label: 'Giọng của ứng dụng' }, { value: 'SCREEN_READER', label: 'Trình đọc màn hình' },
    ], () => get().speechOutput, (value) => (value === 'APP_TTS' || value === 'SCREEN_READER' ? { speechOutput: value } : null), set, get),
    toSwitch('vibration', 'Rung', () => get().vibrationEnabled, (on) => ({ vibrationEnabled: on }), set),
    toSwitch('largeText', 'Chữ lớn', () => get().fontScale > 1, (on) => ({ fontScale: on ? LARGE_FONT_SCALE : 1 }), set),
    toSwitch('highContrast', 'Tương phản cao', () => get().highContrast, (on) => ({ highContrast: on }), set),
    toSwitch('autoStartCamera', 'Tự bật camera', () => get().autoStartCamera, (on) => ({ autoStartCamera: on }), set),
    { id: 'replayGuide', label: 'Nghe lại hướng dẫn', kind: 'action', run: () => safeCall('onReplayGuide', () => o?.onReplayGuide?.()) },
  ];
}
</file>

<file path="src/accessibility/start-gate.ts">
/**
 * Cổng khởi động (F1): MỘT button toàn màn hình, nhãn "Bắt đầu nhận dạng tiền. Chạm hai lần để bắt đầu."
 *
 * VÌ SAO CẦN CỔNG NÀY
 * - Trình duyệt/WebView chỉ cho phát tiếng (Web Speech, mp3) sau MỘT thao tác của người dùng (chính sách autoplay).
 *   App này lấy giọng nói làm kênh chính nên câu chào đầu tiên cũng phải được phát. Cổng tạo ra đúng một sự kiện
 *   click có chủ đích, và unlock() được gọi NGAY TRONG sự kiện đó thì engine mới được "mở khóa".
 * - P11 chỉ hiện cổng khi TtsCapabilities.requiresUserGesture là true. Trên APK với giọng native không có chính sách
 *   này nên app tự bắt đầu, không hiện cổng.
 *
 * LƯU Ý NỀN TẢNG: khi TalkBack hoặc VoiceOver bật, chạm một lần chỉ là khám phá, chạm hai lần mới kích hoạt;
 * bộ lắng nghe cử chỉ tự viết (touchstart, pointerdown) không nhận được chạm đơn. Vì vậy cổng là button thật và
 * chỉ lắng nghe sự kiện click (Enter/Space và chạm hai lần của trình đọc màn hình đều sinh ra click).
 *
 * Thứ tự khi kích hoạt (chỉ chạy một lần): unlock() → onStart() → gỡ cổng → chuyển focus sang nút "Nghe lại kết quả".
 * Nên dựng cụm trợ năng (accessibility-manager) trước khi show() để cổng nằm đầu thứ tự đọc.
 */
import { roleSelector, ROLE_ATTR, safeCall, setStyles } from './a11y-shared';

/** Nhãn đọc của cổng (trình đọc màn hình đọc nguyên câu này). */
export const START_GATE_LABEL = 'Bắt đầu nhận dạng tiền. Chạm hai lần để bắt đầu.';
const TITLE_TEXT = 'Bắt đầu nhận dạng tiền';
const HINT_TEXT = 'Chạm hai lần để bắt đầu';

const GATE_STYLES: Readonly<Record<string, string>> = {
  position: 'fixed', top: '0', left: '0', width: '100%', height: '100%', 'z-index': '1000',
  display: 'flex', 'flex-direction': 'column', 'align-items': 'center', 'justify-content': 'center', gap: '1rem',
  margin: '0', padding: '1rem', 'box-sizing': 'border-box', cursor: 'pointer', 'text-align': 'center',
  border: 'var(--a11y-border-width, 4px) solid var(--a11y-fg, #ffffff)',
  background: 'var(--a11y-bg, #000000)', color: 'var(--a11y-fg, #ffffff)',
  'font-family': 'inherit', 'font-weight': '700', 'font-size': 'calc(1.75rem * var(--font-scale, 1))',
};

export function createStartGate(o: { root: HTMLElement; onStart: () => void; unlock: () => void }): { show(): void; hide(): void } {
  const doc = o.root.ownerDocument;
  let gate: HTMLButtonElement | null = null;
  let started = false;
  let inerted: Element[] = [];

  function focusReplay(): void {
    const selector = roleSelector('replay');
    const replay = o.root.querySelector<HTMLElement>(selector) ?? doc.querySelector<HTMLElement>(selector);
    replay?.focus({ preventScroll: true });
  }

  /** Khi cổng hiện, phần còn lại của app không được focus/đọc được (tránh lướt vào nút nằm dưới cổng). */
  function setInert(on: boolean): void {
    if (!on) {
      for (const el of inerted) el.removeAttribute('inert');
      inerted = [];
      return;
    }
    // Không làm inert vùng aria-live: giọng đọc qua trình đọc màn hình vẫn phải đến được người dùng.
    inerted = Array.from(o.root.children).filter(
      (el) => el !== gate && !el.hasAttribute('inert') && !el.hasAttribute('aria-live'),
    );
    for (const el of inerted) el.setAttribute('inert', '');
  }

  function close(forceFocus: boolean): void {
    if (gate === null) return;
    const active = doc.activeElement;
    const hadFocus = forceFocus || active === null || active === doc.body || gate.contains(active);
    setInert(false);
    gate.remove();
    gate = null;
    if (hadFocus) focusReplay();
  }

  function activate(): void {
    if (started) return; // chỉ một lần: chạm đúp, kích hoạt lặp của trình đọc màn hình
    started = true;
    safeCall('unlock', o.unlock); // 1. ngay trong sự kiện click, để qua chính sách autoplay
    safeCall('onStart', o.onStart); // 2. app bắt đầu (giọng chào, xin quyền camera...)
    close(true); // 3. gỡ cổng, 4. chuyển focus sang nút nghe lại
  }

  function show(): void {
    if (started || gate !== null) return;
    const button = doc.createElement('button');
    button.type = 'button';
    button.lang = 'vi';
    button.setAttribute(ROLE_ATTR, 'start-gate');
    button.setAttribute('aria-label', START_GATE_LABEL);
    setStyles(button, GATE_STYLES);
    for (const [text, size] of [[TITLE_TEXT, '1'], [HINT_TEXT, '0.7']] as const) {
      const line = doc.createElement('span');
      line.textContent = text;
      line.style.setProperty('font-size', `${size}em`);
      button.append(line);
    }
    button.addEventListener('click', activate);
    gate = button;
    o.root.prepend(button);
    setInert(true);
    button.focus({ preventScroll: true }); // TalkBack/VoiceOver đọc nhãn ngay khi cổng hiện
  }

  return { show, hide: () => close(false) };
}
</file>

<file path="src/analyzer/frame-analyzer.ts">
import type { AppConfig, Detection, FrameAnalysis, IFrameAnalyzer, InferenceResult } from '../contracts';
import { center } from '../utils/geometry';
import { measureBlur } from './blur-detector';
import { measureBrightness } from './brightness-analyzer';
import { splitByConfidence } from './confidence-analyzer';
import { detectClassConflict } from './conflict-detector';
import { detectOverlap } from './overlap-detector';
import { analyzePosition } from './position-analyzer';
import { createTemporalStabilizer, isFrameValid } from './temporal-stabilizer';

/** Sắp từ trái sang phải (tâm x tăng dần, hòa thì theo tâm y), ổn định. Trả mảng mới, không sửa đầu vào. */
function sortLeftToRight(detections: readonly Detection[]): Detection[] {
  return [...detections].sort((a, b) => {
    const ca = center(a.bbox);
    const cb = center(b.bbox);
    return ca.x - cb.x || ca.y - cb.y;
  });
}

/**
 * Tạo bộ phân tích khung hình. Chỉ MÔ TẢ khung hình (chắc hay không, chồng lấn, xung đột, vị trí, mờ, tối, ổn định),
 * tuyệt đối không quyết định đọc hay không, không nói, không tính tổng.
 *
 * Mỗi lần analyze: sắp detection trái → phải, tách sure/unsure (A1), rồi chạy A2 đến A6 trên mọi detection có
 * độ tin cậy ≥ confLow (cả chắc lẫn chưa chắc), cuối cùng đưa khung vào bộ ổn định (A7).
 * Ngưỡng: confLow, confSure lấy từ config.inference; mọi ngưỡng còn lại từ config.analyzer. Không có hằng số ma thuật.
 * Trạng thái duy nhất giữ lại giữa các khung: cửa sổ của bộ ổn định và emptyStreak.
 * Không sửa InferenceResult đầu vào; kết quả dùng mảng mới (các đối tượng Detection được dùng chung với đầu vào).
 * Ném RangeError nếu config.analyzer.stabilizer không hợp lệ (xem createTemporalStabilizer).
 *
 * @param config Cấu hình ứng dụng (DEFAULT_CONFIG hoặc bản đã hiệu chỉnh).
 */
export function createFrameAnalyzer(config: AppConfig): IFrameAnalyzer {
  const { inference, analyzer } = config;
  const stabilizer = createTemporalStabilizer(analyzer.stabilizer);
  let emptyStreak = 0;

  /** Phân tích một kết quả suy luận; meta.timestamp (mili-giây) là mốc thời gian cho cửa sổ ổn định. */
  function analyze(r: InferenceResult): FrameAnalysis {
    const { sure, unsure, kept } = splitByConfidence(sortLeftToRight(r.detections), inference.confLow, inference.confSure);
    const overlap = detectOverlap(kept, analyzer.overlapRatio);
    const conflict = detectClassConflict(kept, analyzer.conflictIou);
    const position = analyzePosition(kept, r.meta, analyzer.minAreaRatio, analyzer.edgeMarginRatio);
    const blur = measureBlur(r.gray, r.meta, kept.map((d) => d.bbox), analyzer.blurThreshold);
    const brightness = measureBrightness(r.gray, analyzer.lowLightMean);

    const stability = stabilizer.push({
      timestamp: r.meta.timestamp,
      valid: isFrameValid({ sure, unsure, overlap, conflict }),
      sure,
    });
    emptyStreak = kept.length === 0 ? emptyStreak + 1 : 0;

    return {
      meta: { ...r.meta },
      detections: kept,
      sure,
      unsure,
      overlap,
      conflict,
      position,
      quality: { ...blur, ...brightness },
      stability,
      emptyStreak,
    };
  }

  /** Xóa cửa sổ ổn định và đưa emptyStreak về 0 (ví dụ khi camera tạm dừng rồi chạy lại). */
  function reset(): void {
    stabilizer.reset();
    emptyStreak = 0;
  }

  return { analyze, reset };
}
</file>

<file path="src/camera/camera-controller.ts">
import { DEFAULT_CONFIG } from '../config/app-config';
import type { AppError, CameraStatus, CapturedFrame, ICameraService, ITorchPort } from '../contracts';
import { createEventBus } from '../utils/event-bus';
import { createLogger } from '../utils/logger';
import { systemClock } from '../utils/time';
import type { Clock } from '../utils/time';
import { createCameraError, mapCameraError } from './camera-errors';
import { attachStream, createCameraSource, detachStream, prepareVideoElement } from './camera-service';
import type { MediaDevicesLike } from './camera-service';
import { createFrameCapture, sanitizeFps, systemScheduler } from './frame-capture';
import type { Scheduler } from './frame-capture';

const log = createLogger('camera');

/** Số lần tự mở lại camera sau khi track kết thúc ngoài ý muốn (F6). Mỗi lần gọi start()/resume() làm mới. */
const AUTO_RETRY_LIMIT = 1;

/** Phần của document và Wake Lock mà module dùng (tiêm đồ giả khi test). */
export interface DocumentLike {
  readonly visibilityState: string;
  addEventListener(type: 'visibilitychange', listener: () => void): void;
  removeEventListener(type: 'visibilitychange', listener: () => void): void;
  createElement?(tagName: 'video'): HTMLVideoElement;
}
export interface WakeLockSentinelLike {
  release(): Promise<void>;
  addEventListener(type: 'release', listener: () => void): void;
}
export interface WakeLockLike {
  request(type: 'screen'): Promise<WakeLockSentinelLike>;
}

/** Mọi thứ chạm DOM, đồng hồ, hẹn giờ đều tiêm được; bỏ trống thì lấy từ môi trường thật. */
export interface CameraControllerDeps {
  video?: HTMLVideoElement;
  fps?: number;
  torchPort?: ITorchPort;
  mediaDevices?: MediaDevicesLike;
  isSecureContext?: boolean;
  doc?: DocumentLike;
  wakeLock?: WakeLockLike;
  clock?: Clock;
  scheduler?: Scheduler;
  createBitmap?: (video: HTMLVideoElement) => Promise<ImageBitmap>;
}

/**
 * Cài ICameraService: ghép CameraSource (getUserMedia, đèn, lấy nét) với FrameCapture (lấy mẫu)
 * và quản lý trạng thái, vòng đời trang, Wake Lock, mở lại khi mất camera.
 * Dùng khi cần tiêm đồ giả (test); mã ứng dụng gọi createCameraService.
 */
export function createCameraController(deps: CameraControllerDeps = {}): ICameraService {
  const nav = typeof navigator === 'undefined' ? undefined : (navigator as Navigator & { wakeLock?: WakeLockLike });
  const doc: DocumentLike | undefined = deps.doc ?? (typeof document === 'undefined' ? undefined : document);
  const wakeLockApi = deps.wakeLock ?? nav?.wakeLock;
  const createBitmap = deps.createBitmap ?? ((v: HTMLVideoElement) => createImageBitmap(v));
  const defaultFps = DEFAULT_CONFIG.inference.targetFps;

  const created = deps.video ?? doc?.createElement?.('video');
  if (!created) throw createCameraError('UNSUPPORTED_BROWSER', 'NO_DOCUMENT');
  const video: HTMLVideoElement = created;
  prepareVideoElement(video);

  const bus = createEventBus<{ status: { status: CameraStatus; error?: AppError } }>();
  const source = createCameraSource({
    mediaDevices: deps.mediaDevices ?? nav?.mediaDevices,
    isSecureContext: deps.isSecureContext ?? (typeof globalThis.isSecureContext === 'boolean' ? globalThis.isSecureContext : undefined),
    ...(deps.torchPort ? { torchPort: deps.torchPort } : {}),
    onEnded: () => onTrackEnded(),
  });
  const capture = createFrameCapture({
    source: video,
    createBitmap: () => createBitmap(video),
    clock: deps.clock ?? systemClock,
    scheduler: deps.scheduler ?? systemScheduler,
    fps: sanitizeFps(deps.fps ?? defaultFps, defaultFps),
  });

  let status: CameraStatus = 'IDLE';
  let generation = 0; // tăng mỗi lần start()/stop(): kết quả của lần mở đã bị huỷ thì bỏ
  let startPromise: Promise<void> | null = null;
  let opChain: Promise<unknown> = Promise.resolve(); // mọi thao tác mở camera chạy lần lượt
  let manualPause = false; // app gọi pause(): không tự tiếp tục khi trang hiện lại
  let autoPaused = false; // tự tạm dừng vì trang bị ẩn
  let streamLost = false; // track kết thúc khi đang PAUSED: resume phải mở lại
  let retriesLeft = AUTO_RETRY_LIMIT;
  let torchWanted = false;
  let wakeLock: WakeLockSentinelLike | null = null;
  let lifecycleAttached = false;

  function setStatus(next: CameraStatus, error?: AppError): void {
    if (next === status && error === undefined) return;
    status = next;
    bus.emit('status', error === undefined ? { status: next } : { status: next, error });
  }

  function enqueue<T>(job: () => Promise<T>): Promise<T> {
    const run = opChain.then(job, job);
    opChain = run.catch(() => undefined);
    return run;
  }

  /* ───── Wake Lock ───── */
  async function acquireWakeLock(): Promise<void> {
    if (!wakeLockApi || wakeLock) return;
    try {
      const sentinel = await wakeLockApi.request('screen');
      if (status !== 'ACTIVE' || wakeLock) {
        void sentinel.release().catch(() => undefined);
        return;
      }
      wakeLock = sentinel;
      sentinel.addEventListener('release', () => {
        if (wakeLock === sentinel) wakeLock = null;
      });
    } catch (err) {
      log.debug('Không giữ được màn hình sáng (bỏ qua)', err);
    }
  }

  function releaseWakeLock(): void {
    const sentinel = wakeLock;
    wakeLock = null;
    if (sentinel) void sentinel.release().catch(() => undefined);
  }

  /* ───── Chuyển trạng thái ───── */
  function enterActive(): void {
    setStatus('ACTIVE');
    capture.start();
    void acquireWakeLock();
    if (torchWanted) void source.setTorch(true);
  }

  function pauseInternal(): void {
    capture.stop();
    releaseWakeLock();
    if (torchWanted) void source.setTorch(false); // tắt đèn khi tạm dừng, resume sẽ bật lại
    video.pause();
    setStatus('PAUSED');
  }

  function releaseStream(): void {
    source.close();
    detachStream(video);
  }

  /**
   * Mở camera, gắn vào video, vào ACTIVE. Lỗi được ghi vào status ERROR và trả về (không ném) để nơi gọi quyết định.
   * Trả null khi thành công hoặc khi lần mở này đã bị stop() huỷ (đã tự dọn).
   */
  async function connect(gen: number): Promise<AppError | null> {
    try {
      const stream = await source.open();
      if (gen !== generation) {
        source.close();
        return null;
      }
      await attachStream(video, stream);
      if (gen !== generation) {
        releaseStream();
        return null;
      }
    } catch (err) {
      if (gen !== generation) return null;
      releaseStream();
      const appError = mapCameraError(err);
      setStatus('ERROR', appError);
      return appError;
    }
    streamLost = false;
    enterActive();
    return null;
  }

  /** Mở lại sau khi mất camera. Lỗi được báo qua onStatus, không ném. */
  function reopen(gen: number): Promise<void> {
    return enqueue(async () => {
      if (gen !== generation) return;
      setStatus('REQUESTING');
      await connect(gen);
    });
  }

  function onTrackEnded(): void {
    if (status === 'PAUSED') {
      streamLost = true;
      return;
    }
    if (status !== 'ACTIVE') return;
    capture.stop();
    releaseWakeLock();
    setStatus('ERROR', createCameraError('CAMERA_IN_USE', 'TRACK_ENDED'));
    if (retriesLeft <= 0) return;
    retriesLeft -= 1;
    reopen(generation).catch((err: unknown) => log.error('Mở lại camera bị lỗi không mong đợi', err));
  }

  /* ───── Vòng đời trang ───── */
  async function resumeFromPause(): Promise<void> {
    if (status !== 'PAUSED') return;
    autoPaused = false;
    const gen = generation;
    if (streamLost || !source.isLive()) return reopen(gen);
    try {
      await video.play();
    } catch (err) {
      if (gen === generation && status === 'PAUSED') setStatus('ERROR', createCameraError('CAMERA_FAILED', err));
      return;
    }
    if (gen === generation && status === 'PAUSED') enterActive();
  }

  function onVisibilityChange(): void {
    if (doc?.visibilityState === 'hidden') {
      if (status !== 'ACTIVE') return;
      autoPaused = true;
      pauseInternal();
    } else if (status === 'PAUSED' && autoPaused && !manualPause) {
      resumeFromPause().catch((err: unknown) => log.error('Tự tiếp tục khi trang hiện lại bị lỗi', err));
    }
  }

  /* ───── ICameraService ───── */
  function start(): Promise<void> {
    if (status === 'ACTIVE') return Promise.resolve();
    if (status === 'PAUSED') return resume();
    if (startPromise) return startPromise;
    if (status === 'REQUESTING') return Promise.resolve(); // đang mở lại sau khi mất camera
    const gen = ++generation;
    retriesLeft = AUTO_RETRY_LIMIT;
    manualPause = autoPaused = streamLost = false;
    if (doc && !lifecycleAttached) {
      doc.addEventListener('visibilitychange', onVisibilityChange);
      lifecycleAttached = true;
    }
    setStatus('REQUESTING'); // đồng bộ, giống FakeCamera: người gọi thấy ngay trạng thái đang xin quyền
    const run = enqueue(async () => {
      if (gen !== generation) return; // stop() đã huỷ trong lúc chờ lượt: không mở camera làm gì
      const error = await connect(gen);
      if (error) {
        detachLifecycle();
        throw error;
      }
    });
    startPromise = run;
    const clear = (): void => {
      if (startPromise === run) startPromise = null;
    };
    run.then(clear, clear);
    return run;
  }

  function detachLifecycle(): void {
    if (doc && lifecycleAttached) doc.removeEventListener('visibilitychange', onVisibilityChange);
    lifecycleAttached = false;
  }

  function stop(): void {
    generation += 1;
    startPromise = null;
    capture.stop();
    releaseWakeLock();
    releaseStream();
    detachLifecycle();
    manualPause = autoPaused = streamLost = torchWanted = false;
    setStatus('IDLE');
  }

  function pause(): void {
    if (status !== 'ACTIVE' && status !== 'PAUSED') return;
    manualPause = true;
    if (status === 'ACTIVE') pauseInternal();
  }

  async function resume(): Promise<void> {
    manualPause = false;
    retriesLeft = AUTO_RETRY_LIMIT;
    await resumeFromPause();
  }

  async function setTorch(on: boolean): Promise<boolean> {
    const ok = await source.setTorch(on);
    if (ok) torchWanted = on;
    return ok;
  }

  return {
    video,
    get status(): CameraStatus {
      return status;
    },
    get torchSupported(): boolean {
      return source.torchSupported;
    },
    start,
    stop,
    pause,
    resume,
    setSampling: (fps: number) => capture.setFps(fps),
    onFrame: (handler: (f: CapturedFrame) => void | Promise<void>) => capture.addHandler(handler),
    onStatus: (handler: (s: CameraStatus, error?: AppError) => void) => bus.on('status', (e) => handler(e.status, e.error)),
    setTorch,
  };
}

/** Điểm vào theo bảng đăng ký xuất khẩu (P02). */
export function createCameraService(
  opts?: { video?: HTMLVideoElement; fps?: number; torchPort?: ITorchPort },
): ICameraService {
  return createCameraController({ ...opts });
}
</file>

