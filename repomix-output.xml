describe('createFrameAnalyzer · ngưỡng đọc từ config (cùng đầu vào, đổi config thì kết quả đổi)', () => {
  const overlapInput = () => result(1, [det(1, 0, 20000, 0.9, box(20, 100, 180, 300)), det(1, 1, 50000, 0.9, box(132, 100, 292, 300))]);
