export interface TemporalStabilizer {
  /** Ghi một khung mới vào cửa sổ rồi trả kết luận ổn định cho CHÍNH khung đó. */
  push(frame: StabilizerFrame): StabilityInfo;
  /** Xóa toàn bộ cửa sổ. */
  reset(): void;
}
⋮----
/** Ghi một khung mới vào cửa sổ rồi trả kết luận ổn định cho CHÍNH khung đó. */
