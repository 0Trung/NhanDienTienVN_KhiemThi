<file path="src/utils/event-bus.ts">
import { createLogger } from './logger';

const log = createLogger('event-bus');

type StoredHandler = (payload: unknown) => void;
interface Entry { readonly handler: StoredHandler }

export interface EventBus<E extends Record<string, unknown>> {
  on<K extends keyof E>(k: K, h: (p: E[K]) => void): () => void;
  off<K extends keyof E>(k: K, h: (p: E[K]) => void): void;
  emit<K extends keyof E>(k: K, p: E[K]): void;
}

/**
 * Bus sự kiện nhỏ, có kiểu theo bản đồ sự kiện E.
 * - on trả về hàm hủy đăng ký.
 * - Lỗi ném ra trong một handler được ghi log và KHÔNG ảnh hưởng handler khác.
 * - emit duyệt trên bản chụp danh sách, nên handler tự hủy trong lúc emit không làm mất handler kế tiếp.
 */
export function createEventBus<E extends Record<string, unknown>>(): EventBus<E> {
  const registry = new Map<keyof E, Entry[]>();

  function removeEntry(key: keyof E, entry: Entry): void {
    const list = registry.get(key);
    if (!list) return;
    const index = list.indexOf(entry);
    if (index === -1) return;
    list.splice(index, 1);
    if (list.length === 0) registry.delete(key);
  }

  function on<K extends keyof E>(k: K, h: (p: E[K]) => void): () => void {
    const entry: Entry = { handler: h as StoredHandler };
    const list = registry.get(k);
    if (list) list.push(entry);
    else registry.set(k, [entry]);
    return () => removeEntry(k, entry);
  }

  function off<K extends keyof E>(k: K, h: (p: E[K]) => void): void {
    const list = registry.get(k);
    const entry = list?.find((e) => e.handler === (h as StoredHandler));
    if (entry) removeEntry(k, entry);
  }

  function emit<K extends keyof E>(k: K, p: E[K]): void {
    const list = registry.get(k);
    if (!list || list.length === 0) return;
    for (const entry of list.slice()) {
      try {
        entry.handler(p);
      } catch (err) {
        log.error(`Handler của sự kiện "${String(k)}" ném lỗi`, err);
      }
    }
  }

  return { on, off, emit };
}
</file>

<file path="src/utils/geometry.ts">
import type { BBox } from '../contracts';
import { clamp } from './math';

/** Diện tích hộp. Hộp suy biến (rộng/cao ≤ 0, đảo ngược, NaN, vô cực) trả 0, không ném lỗi. */
export function area(b: BBox): number {
  const w = b.x2 - b.x1;
  const h = b.y2 - b.y1;
  if (!(w > 0) || !(h > 0)) return 0;
  const r = w * h;
  return Number.isFinite(r) ? r : 0;
}

/** Diện tích phần giao của hai hộp; rời nhau, chỉ chạm cạnh hoặc suy biến thì 0. */
export function intersectionArea(a: BBox, b: BBox): number {
  const w = Math.min(a.x2, b.x2) - Math.max(a.x1, b.x1);
  const h = Math.min(a.y2, b.y2) - Math.max(a.y1, b.y1);
  if (!(w > 0) || !(h > 0)) return 0;
  const r = w * h;
  return Number.isFinite(r) ? r : 0;
}

/** Intersection over Union, trong [0, 1]; suy biến thì 0. */
export function iou(a: BBox, b: BBox): number {
  const inter = intersectionArea(a, b);
  if (inter === 0) return 0;
  const union = area(a) + area(b) - inter;
  return union > 0 ? inter / union : 0;
}

/** Diện tích giao chia cho diện tích hộp nhỏ hơn; hộp nhỏ nằm trọn trong hộp lớn thì 1. Suy biến thì 0. */
export function overlapOverMin(a: BBox, b: BBox): number {
  const inter = intersectionArea(a, b);
  if (inter === 0) return 0;
  const smaller = Math.min(area(a), area(b));
  return smaller > 0 ? inter / smaller : 0;
}

/** Tâm hộp. */
export function center(b: BBox): { x: number; y: number } {
  return { x: (b.x1 + b.x2) / 2, y: (b.y1 + b.y2) / 2 };
}

/** Cắt hộp vào khung [0, w] × [0, h]. Trả hộp mới, không sửa hộp gốc; có thể ra hộp suy biến. */
export function clampBox(b: BBox, w: number, h: number): BBox {
  const maxX = Number.isFinite(w) && w > 0 ? w : 0;
  const maxY = Number.isFinite(h) && h > 0 ? h : 0;
  return {
    x1: clamp(b.x1, 0, maxX),
    y1: clamp(b.y1, 0, maxY),
    x2: clamp(b.x2, 0, maxX),
    y2: clamp(b.y2, 0, maxY),
  };
}

/** Hộp hợp lệ: mọi toạ độ hữu hạn, x1 < x2 và y1 < y2. */
export function isValidBox(b: BBox): boolean {
  return (
    Number.isFinite(b.x1) && Number.isFinite(b.y1) && Number.isFinite(b.x2) && Number.isFinite(b.y2) &&
    b.x2 > b.x1 && b.y2 > b.y1
  );
}
</file>

<file path="src/utils/logger.ts">
/**
 * Logger dùng chung. Mức log chỉnh được; bộ đệm vòng giữ 200 dòng gần nhất để xem khi gỡ lỗi.
 * Mặc định: bản production chỉ ghi warn và error, bản dev ghi từ debug.
 * Mức log áp dụng cho cả bộ đệm lẫn nơi in ra. Không chạm DOM nên dùng được trong Web Worker.
 */
export type LogLevel = 'debug' | 'info' | 'warn' | 'error';
/** Nơi nhận dòng log đã định dạng. Mặc định là console. */
export type LogSink = (level: LogLevel, line: string) => void;

export interface Logger {
  debug(...a: unknown[]): void;
  info(...a: unknown[]): void;
  warn(...a: unknown[]): void;
  error(...a: unknown[]): void;
}

const RANK: Record<LogLevel, number> = { debug: 0, info: 1, warn: 2, error: 3 };
const MAX_LINES = 200;
const MAX_LINE_LENGTH = 1000;

function defaultLevel(): LogLevel {
  try {
    return import.meta.env?.PROD === true ? 'warn' : 'debug';
  } catch {
    return 'warn';
  }
}

function consoleSink(level: LogLevel, line: string): void {
  console[level](line);
}

let currentLevel: LogLevel = defaultLevel();
let sink: LogSink = consoleSink;
const buffer: string[] = [];

function formatArg(a: unknown): string {
  if (typeof a === 'string') return a;
  if (a instanceof Error) return `${a.name}: ${a.message}`;
  if (typeof a === 'object' && a !== null) {
    try {
      return JSON.stringify(a);
    } catch {
      return String(a);
    }
  }
  return String(a);
}

function write(scope: string, level: LogLevel, args: unknown[]): void {
  if (RANK[level] < RANK[currentLevel]) return;
  let line = `${new Date().toISOString()} ${level.toUpperCase()} [${scope}] ${args.map(formatArg).join(' ')}`;
  if (line.length > MAX_LINE_LENGTH) line = `${line.slice(0, MAX_LINE_LENGTH)}…`;
  buffer.push(line);
  if (buffer.length > MAX_LINES) buffer.splice(0, buffer.length - MAX_LINES);
  try {
    sink(level, line);
  } catch {
    // Lỗi của nơi nhận log không được làm hỏng luồng chính.
  }
}

/** Tạo logger gắn với một phạm vi (tên module). */
export function createLogger(scope: string): Logger {
  return {
    debug: (...a) => write(scope, 'debug', a),
    info: (...a) => write(scope, 'info', a),
    warn: (...a) => write(scope, 'warn', a),
    error: (...a) => write(scope, 'error', a),
  };
}

/** Các dòng log gần nhất (tối đa 200), cũ trước, mới sau. */
export function getRecentLogs(): string[] {
  return buffer.slice();
}

/** Đổi mức log tối thiểu được ghi. */
export function setLogLevel(level: LogLevel): void {
  currentLevel = level;
}

export function getLogLevel(): LogLevel {
  return currentLevel;
}

/** Thay nơi nhận log (dùng khi test); truyền null để quay về console. */
export function setLogSink(next: LogSink | null): void {
  sink = next ?? consoleSink;
}

/** Xóa bộ đệm log. */
export function clearRecentLogs(): void {
  buffer.length = 0;
}
</file>

<file path="src/utils/math.ts">
/**
 * Giới hạn v vào đoạn [lo, hi]. Nếu lo > hi thì hai đầu mút được hoán đổi.
 * v là NaN thì trả về đầu mút dưới.
 */
export function clamp(v: number, lo: number, hi: number): number {
  const min = Math.min(lo, hi);
  const max = Math.max(lo, hi);
  if (Number.isNaN(v)) return min;
  if (v < min) return min;
  if (v > max) return max;
  return v;
}

/** Trung bình cộng; mảng rỗng trả 0. */
export function mean(xs: ArrayLike<number>): number {
  const n = xs.length;
  if (n === 0) return 0;
  let sum = 0;
  for (let i = 0; i < n; i++) sum += xs[i] ?? 0;
  return sum / n;
}

/** Bộ sinh số giả ngẫu nhiên mulberry32: cùng seed cho cùng dãy, giá trị trong [0, 1). */
export function mulberry32(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = Math.imul(a ^ (a >>> 15), a | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
</file>

