<file path="src/vision/model-manager.ts">
import { AppError } from '../contracts';
import type { AppConfig, ClassesJson, ModelConfigJson, ModelInfo, ModelManifest, RawModelOutput } from '../contracts';
import { createLogger } from '../utils/logger';
import { systemClock } from '../utils/time';
import type { Clock } from '../utils/time';
import type { InferenceSession } from 'onnxruntime-web/wasm';

/**
 * Nạp và chạy mô hình ONNX bằng onnxruntime-web. Thuần logic, không phụ thuộc trình duyệt nên chạy được
 * trong Worker lẫn Node; fetch, ORT và thông tin môi trường đều nhận qua tham số để test bằng đồ giả.
 */
const log = createLogger('model-manager');

/** Số luồng WASM tối đa khi trang được cô lập đa nguồn gốc (crossOriginIsolated). */
const MAX_WASM_THREADS = 4;

type Backend = ModelInfo['backend'];

/** Phần của onnxruntime-web mà module này dùng; đồ giả trong test chỉ cần thỏa cấu trúc này. */
export type OrtModule = Pick<typeof import('onnxruntime-web/wasm'), 'env' | 'InferenceSession' | 'Tensor'>;
/** Phần của Response mà module cần; fetch thật thỏa cấu trúc này. */
export interface FetchResponseLike { ok: boolean; status: number; json(): Promise<unknown>; arrayBuffer(): Promise<ArrayBuffer> }
export type FetchLike = (url: string) => Promise<FetchResponseLike>;
/** Thông tin môi trường chạy, đọc từ globalThis (test tiêm giá trị giả). */
export interface RuntimeEnv { crossOriginIsolated: boolean; hardwareConcurrency: number; hasWebGpu: boolean; userAgent: string }

export interface LoadModelOptions {
  baseUrl: string;
  ortBaseUrl: string;
  config: AppConfig['inference'];
  fetchFn?: FetchLike;
  /** Nạp ORT theo backend; mặc định import động onnxruntime-web/wasm hoặc onnxruntime-web/webgpu. */
  ortLoader?: (backend: Backend) => Promise<OrtModule>;
  runtime?: RuntimeEnv;
  now?: Clock;
}

/** Phần worker-core cần của một mô hình đã nạp. */
export interface ModelRunner {
  readonly info: ModelInfo;
  predict(tensor: Float32Array): Promise<RawModelOutput>;
  dispose(): Promise<void>;
}
export interface LoadedModel extends ModelRunner {
  readonly manifest: ModelManifest;
  readonly config: ModelConfigJson;
  /** Nguyên văn classes.json; giá trị được kiểm bằng buildClassMap ở nơi dùng. */
  readonly classes: ClassesJson;
}

const withSlash = (url: string): string => (url.endsWith('/') ? url : `${url}/`);
const fileName = (url: string): string => url.slice(url.lastIndexOf('/') + 1);
const isRecord = (v: unknown): v is Record<string, unknown> => typeof v === 'object' && v !== null && !Array.isArray(v);
const isClasses = (v: unknown): v is ClassesJson => isRecord(v);
const isModelConfig = (v: unknown): v is ModelConfigJson => isRecord(v) && Number.isInteger(v.inputSize) && Number(v.inputSize) > 0;
const isManifest = (v: unknown): v is ModelManifest =>
  isRecord(v) && typeof v.file === 'string' && typeof v.sha256 === 'string' && typeof v.version === 'string' &&
  typeof v.inputName === 'string' && typeof v.outputName === 'string' && Array.isArray(v.inputShape) &&
  Number.isInteger(v.sizeBytes) && Number.isInteger(v.classCount);

function readRuntimeEnv(): RuntimeEnv {
  const g = globalThis as { crossOriginIsolated?: boolean; navigator?: { hardwareConcurrency?: number; userAgent?: string; gpu?: unknown } };
  return {
    crossOriginIsolated: g.crossOriginIsolated === true,
    hardwareConcurrency: g.navigator?.hardwareConcurrency ?? 1,
    hasWebGpu: g.navigator?.gpu !== undefined,
    userAgent: g.navigator?.userAgent ?? '',
  };
}

function describeRuntime(r: RuntimeEnv): string {
  const chrome = /Chrome\/([\d.]+)/.exec(r.userAgent)?.[1] ?? 'không rõ';
  const kind = /;\s*wv\)/.test(r.userAgent) ? 'Android WebView' : 'Chrome';
  return `Môi trường: ${kind} ${chrome}; crossOriginIsolated=${r.crossOriginIsolated}; CPU=${r.hardwareConcurrency}; WebGPU=${r.hasWebGpu}`;
}

/** WebView thường không cô lập đa nguồn gốc nên chỉ dùng đa luồng khi crossOriginIsolated. */
function pickThreads(r: RuntimeEnv): number {
  if (!r.crossOriginIsolated) return 1;
  return Math.max(1, Math.min(MAX_WASM_THREADS, Math.floor(r.hardwareConcurrency) || 1));
}

/** Bản wasm-only dùng ort-wasm-simd-threaded.{mjs,wasm}: đúng các file scripts/copy-ort-wasm.mjs chép vào public/ort. */
function importOrt(backend: Backend): Promise<OrtModule> {
  return backend === 'webgpu' ? import('onnxruntime-web/webgpu') : import('onnxruntime-web/wasm');
}

async function fetchOk(fetchFn: FetchLike, url: string): Promise<FetchResponseLike> {
  let res: FetchResponseLike;
  try {
    res = await fetchFn(url);
  } catch (e) {
    throw new AppError('MODEL_MISSING', `Không đọc được tệp mô hình "${fileName(url)}".`, true, e);
  }
  if (!res.ok) throw new AppError('MODEL_MISSING', `Không tìm thấy tệp mô hình "${fileName(url)}" (HTTP ${res.status}).`, true);
  return res;
}

async function fetchJson<T>(fetchFn: FetchLike, url: string, guard: (v: unknown) => v is T): Promise<T> {
  const res = await fetchOk(fetchFn, url);
  let value: unknown;
  try {
    value = await res.json();
  } catch (e) {
    throw new AppError('MODEL_CORRUPT', `Tệp "${fileName(url)}" không phải JSON hợp lệ.`, true, e);
  }
  if (!guard(value)) throw new AppError('MODEL_CORRUPT', `Tệp "${fileName(url)}" thiếu hoặc sai trường bắt buộc.`, true);
  return value;
}

async function fetchBytes(fetchFn: FetchLike, url: string): Promise<ArrayBuffer> {
  const res = await fetchOk(fetchFn, url);
  try {
    return await res.arrayBuffer();
  } catch (e) {
    throw new AppError('MODEL_MISSING', `Đọc dở tệp mô hình "${fileName(url)}".`, true, e);
  }
}

async function verifyBytes(buffer: ArrayBuffer, manifest: ModelManifest, checksum: boolean): Promise<void> {
  if (buffer.byteLength !== manifest.sizeBytes) {
    throw new AppError('MODEL_CORRUPT', `Tệp mô hình sai kích thước: nhận ${buffer.byteLength} byte, manifest ghi ${manifest.sizeBytes}.`, true);
  }
  if (!checksum) return;
  const subtle = globalThis.crypto?.subtle;
  if (!subtle) {
    throw new AppError('UNSUPPORTED_BROWSER', 'Thiếu crypto.subtle (cần HTTPS hoặc localhost) nên không kiểm tra được sha256; đặt verifyChecksum=false khi chạy thử qua http.', true);
  }
  const bytes = new Uint8Array(await subtle.digest('SHA-256', buffer));
  const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
  if (hex !== manifest.sha256.toLowerCase()) {
    throw new AppError('MODEL_CORRUPT', `Tệp mô hình sai sha256: nhận ${hex.slice(0, 12)}…, manifest ghi ${manifest.sha256.slice(0, 12)}….`, true);
  }
}

/** F4: tạo ort.Tensor [1,3,S,S], chạy session, trả RawModelOutput; luôn giải phóng tensor tạm. */
function makePredict(ort: OrtModule, session: InferenceSession, manifest: ModelManifest, size: number) {
  const dims = [1, 3, size, size];
  const expected = 3 * size * size;
  return async (tensor: Float32Array): Promise<RawModelOutput> => {
    if (tensor.length !== expected) {
      throw new AppError('INFERENCE_FAILED', `Tensor đầu vào có ${tensor.length} phần tử, cần ${expected} (1×3×${size}×${size}).`);
    }
    const input = new ort.Tensor('float32', tensor, dims);
    let outputs: InferenceSession.ReturnType | undefined;
    try {
      outputs = await session.run({ [manifest.inputName]: input }, [manifest.outputName]);
      const out = outputs[manifest.outputName];
      if (!out || !(out.data instanceof Float32Array)) {
        throw new AppError('INFERENCE_FAILED', `Đầu ra "${manifest.outputName}" thiếu hoặc không phải float32.`);
      }
      return { data: out.data, dims: [...out.dims] };
    } finally {
      input.dispose();
      if (outputs) for (const t of Object.values(outputs)) t.dispose();
    }
  };
}

/**
 * F1-F3: đọc manifest/config/classes, tải onnx, kiểm kích thước và sha256, khởi tạo ORT (WASM, hoặc thử WebGPU trước
 * nếu config.preferWebGpu và có navigator.gpu), chạy nóng một lần. Lỗi: MODEL_MISSING, MODEL_CORRUPT, MODEL_INIT_FAILED.
 */
export async function loadModel(o: LoadModelOptions): Promise<LoadedModel> {
  const now = o.now ?? systemClock;
  const fetchFn = o.fetchFn ?? ((url: string) => fetch(url));
  const runtime = o.runtime ?? readRuntimeEnv();
  const t0 = now();
  log.info(describeRuntime(runtime));

  const base = withSlash(o.baseUrl);
  const manifest = await fetchJson(fetchFn, `${base}model-manifest.json`, isManifest);
  const modelConfig = await fetchJson(fetchFn, `${base}model-config.json`, isModelConfig);
  const classes = await fetchJson(fetchFn, `${base}classes.json`, isClasses);
  const size = modelConfig.inputSize;
  const shape = manifest.inputShape;
  if (shape.length !== 4 || shape[2] !== size || shape[3] !== size) {
    throw new AppError('MODEL_CORRUPT', `model-manifest.json (inputShape ${shape.join('×')}) không khớp model-config.json (inputSize ${size}).`, true);
  }
  const buffer = await fetchBytes(fetchFn, `${base}${manifest.file}`);
  await verifyBytes(buffer, manifest, o.config.verifyChecksum);

  const threads = pickThreads(runtime);
  const backends: Backend[] = o.config.preferWebGpu && runtime.hasWebGpu ? ['webgpu', 'wasm'] : ['wasm'];
  let lastError: unknown;
  for (const backend of backends) {
    let session: InferenceSession | undefined;
    try {
      const ort = await (o.ortLoader ?? importOrt)(backend);
      ort.env.wasm.wasmPaths = withSlash(o.ortBaseUrl);
      ort.env.wasm.numThreads = threads;
      ort.env.wasm.simd = true;
      session = await ort.InferenceSession.create(new Uint8Array(buffer), { executionProviders: [backend], graphOptimizationLevel: 'all' });
      const tLoaded = now();
      const predict = makePredict(ort, session, manifest, size);
      await predict(new Float32Array(3 * size * size)); // F3: chạy nóng với tensor toàn 0
      const tWarm = now();
      const live = session;
      const info: ModelInfo = {
        version: manifest.version, inputSize: size, classCount: manifest.classCount,
        backend, threads, loadMs: tLoaded - t0, warmupMs: tWarm - tLoaded,
      };
      log.info('Mô hình sẵn sàng', info);
      return {
        info, manifest, config: modelConfig, classes, predict,
        dispose: async () => {
          try {
            await live.release();
          } catch (e) {
            log.warn('Giải phóng phiên ORT lỗi', e);
          }
        },
      };
    } catch (e) {
      lastError = e;
      log.warn(`Backend ${backend} không dùng được`, e);
      await session?.release().catch(() => undefined);
    }
  }
  const reason = lastError instanceof Error ? lastError.message : String(lastError);
  throw new AppError('MODEL_INIT_FAILED', `Không khởi tạo được ONNX Runtime: ${reason}`, true, lastError);
}
</file>

<file path="src/voice/audio-clip-engine.ts">
import { AppError } from '../contracts';
import type { ITtsEngine, TtsCapabilities, TtsHooks } from '../contracts';
import { createLogger } from '../utils/logger';

const log = createLogger('audio-clip');

/** Engine phát file mp3 ghi sẵn theo audioKey; canSpeak cho biết khóa nào thực sự có file. */
export interface AudioClipEngine extends ITtsEngine {
  canSpeak(audioKey: string): boolean;
}

/** Phần của fetch mà engine dùng (fetch thật thỏa mãn kiểu này). */
export type AudioFetch = (url: string, init?: { method: string }) => Promise<{ ok: boolean; json(): Promise<unknown> }>;

export interface AudioClipDeps {
  /** Thư mục gốc của ứng dụng (Vite base), ví dụ "./". Manifest nằm ở <baseUrl>audio/manifest.json. */
  baseUrl: string;
  fetchFn: AudioFetch;
  createAudio: () => HTMLAudioElement;
}

const UNAVAILABLE: TtsCapabilities = {
  available: false,
  vietnameseVoice: false,
  offlineVietnamese: false,
  requiresUserGesture: false,
};

/** Tên file hợp lệ: không có dấu gạch chéo, không bắt đầu bằng dấu chấm (chặn đường dẫn lạ trong manifest). */
const SAFE_FILE_NAME = /^[A-Za-z0-9_-][A-Za-z0-9_.-]*$/;

/** WAV im lặng 2 mẫu, dựng từ byte: dùng để "mở khóa" phần tử audio trong lần chạm đầu tiên. */
export function silentWavDataUri(): string {
  const bytes = [
    0x52, 0x49, 0x46, 0x46, 0x26, 0x00, 0x00, 0x00, 0x57, 0x41, 0x56, 0x45, // "RIFF", 38, "WAVE"
    0x66, 0x6d, 0x74, 0x20, 0x10, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, // "fmt ", 16, PCM, mono
    0x40, 0x1f, 0x00, 0x00, 0x40, 0x1f, 0x00, 0x00, 0x01, 0x00, 0x08, 0x00, // 8000 Hz, 8000 byte/s, 1, 8 bit
    0x64, 0x61, 0x74, 0x61, 0x02, 0x00, 0x00, 0x00, 0x80, 0x80, // "data", 2 byte im lặng
  ];
  return `data:audio/wav;base64,${btoa(String.fromCharCode(...bytes))}`;
}

function parseManifest(data: unknown): Array<[string, string]> {
  if (typeof data !== 'object' || data === null || Array.isArray(data)) return [];
  return Object.entries(data).filter(
    (entry): entry is [string, string] => typeof entry[1] === 'string' && SAFE_FILE_NAME.test(entry[1]),
  );
}

/** Engine audio-clip với các thành phần tiêm vào (dùng cho test và cho createAudioClipEngine). */
export function createAudioClipEngineWith(deps: AudioClipDeps): AudioClipEngine {
  const base = deps.baseUrl.endsWith('/') ? deps.baseUrl : `${deps.baseUrl}/`;
  const clips = new Map<string, string>(); // khóa → URL của file đã xác nhận tồn tại
  let audio: HTMLAudioElement | null = null; // MỘT phần tử audio, tạo lười và dùng lại cho mọi câu
  let counter = 0;
  let current = 0; // id của clip đang phát; 0 = không có
  let unlocked = false;

  function getAudio(): HTMLAudioElement {
    audio ??= deps.createAudio();
    return audio;
  }

  async function init(): Promise<TtsCapabilities> {
    clips.clear();
    try {
      const res = await deps.fetchFn(`${base}audio/manifest.json`);
      if (res.ok) {
        const entries = parseManifest(await res.json());
        await Promise.all(
          entries.map(async ([key, file]) => {
            const url = `${base}audio/${file}`;
            try {
              if ((await deps.fetchFn(url, { method: 'HEAD' })).ok) clips.set(key, url);
            } catch (e) {
              log.warn(`Không kiểm tra được file ${file}:`, e);
            }
          }),
        );
      }
    } catch (e) {
      log.warn('Không đọc được manifest âm thanh ghi sẵn:', e);
    }
    if (clips.size === 0) return { ...UNAVAILABLE };
    // requiresUserGesture = true: giả định chính sách tự phát của WebView chưa được nới (nếu đã nới thì để false).
    return { available: true, vietnameseVoice: true, offlineVietnamese: true, requiresUserGesture: true };
  }

  /** Gọi trong lần chạm đầu tiên: phát một clip im lặng trên chính phần tử audio sẽ dùng về sau. */
  function unlock(): void {
    if (unlocked) return;
    unlocked = true;
    try {
      const el = getAudio();
      el.src = silentWavDataUri();
      const started: Promise<void> | undefined = el.play();
      started?.catch((e: unknown) => {
        if (e instanceof Error && e.name === 'NotAllowedError') unlocked = false; // vẫn bị khóa: thử lại lần chạm sau
      });
    } catch (e) {
      unlocked = false;
      log.warn('unlock lỗi:', e);
    }
  }

  function speak(_text: string, opts: { rate: number; lang: string; audioKey?: string }, hooks: TtsHooks): void {
    const url = opts.audioKey === undefined ? undefined : clips.get(opts.audioKey);
    if (url === undefined) {
      hooks.onError(new AppError('TTS_UNAVAILABLE', `Không có âm thanh ghi sẵn cho khóa ${String(opts.audioKey)}`));
      return;
    }
    const el = getAudio();
    if (current !== 0) el.pause(); // không để hai clip chồng nhau
    counter += 1;
    const id = counter;
    current = id;
    el.onended = () => {
      if (current !== id) return;
      current = 0;
      hooks.onEnd();
    };
    el.onerror = () => {
      if (current !== id) return;
      current = 0;
      hooks.onError(new AppError('TTS_UNAVAILABLE', 'Không phát được file âm thanh ghi sẵn'));
    };
    const fail = (e: unknown): void => {
      if (current !== id) return;
      current = 0;
      hooks.onError(new AppError('TTS_UNAVAILABLE', 'Trình duyệt từ chối phát âm thanh ghi sẵn', false, e));
    };
    try {
      el.src = url;
      el.playbackRate = opts.rate;
      const started: Promise<void> | undefined = el.play();
      if (started === undefined) hooks.onStart();
      else {
        started.then(() => {
          if (current === id) hooks.onStart();
        }, fail);
      }
    } catch (e) {
      fail(e);
    }
  }

  function cancel(): void {
    current = 0;
    audio?.pause();
  }

  return { name: 'audio-clip', init, unlock, speak, cancel, canSpeak: (audioKey) => clips.has(audioKey) };
}

/** Engine audio-clip thật: phát mp3 trong public/audio (đã nằm sẵn trong APK, chạy được khi không có mạng). */
export function createAudioClipEngine(o?: { baseUrl?: string }): AudioClipEngine {
  return createAudioClipEngineWith({
    baseUrl: o?.baseUrl ?? './',
    fetchFn: (url, init) => fetch(url, init),
    createAudio: () => new Audio(),
  });
}
</file>

<file path="src/voice/native-tts-engine.ts">
import { DEFAULT_SETTINGS } from '../config/app-config';
import { AppError } from '../contracts';
import type { ITtsEngine, TtsCapabilities, TtsHooks } from '../contracts';
import { createLogger } from '../utils/logger';
import { getPlatform } from '../utils/platform';
import { createCapacitorTtsPort } from './native-tts-adapter';

const log = createLogger('native-tts');

const VIETNAMESE_LANG = DEFAULT_SETTINGS.voiceLanguage;

export interface NativeTtsVoice {
  lang: string;
  name?: string;
  /** true nếu giọng chạy cục bộ (không cần Internet); undefined nếu plugin không cho biết. */
  localService?: boolean;
}

/**
 * Cổng nhỏ che plugin TTS native. Mọi lỗi của plugin phải ra ngoài dưới dạng AppError TTS_UNAVAILABLE.
 * speak luôn dùng hàng đợi kiểu flush: câu mới thay câu đang đọc; promise hoàn tất khi đọc xong.
 */
export interface NativeTtsPort {
  isLanguageSupported(lang: string): Promise<boolean>;
  listVoices(): Promise<NativeTtsVoice[]>;
  speak(o: { text: string; lang: string; rate: number }): Promise<void>;
  stop(): Promise<void>;
}

export interface NativeTtsDeps {
  port: NativeTtsPort;
  isNative: () => boolean;
}

const UNAVAILABLE: TtsCapabilities = {
  available: false,
  vietnameseVoice: false,
  offlineVietnamese: false,
  requiresUserGesture: false,
};

function isVietnamese(lang: string): boolean {
  return lang.toLowerCase().replace('_', '-').startsWith('vi');
}

function toAppError(e: unknown): AppError {
  return e instanceof AppError ? e : new AppError('TTS_UNAVAILABLE', 'Engine đọc của điện thoại gặp lỗi', false, e);
}

/** Engine TTS native với cổng tiêm vào (dùng cho test và cho createNativeTtsEngine). */
export function createNativeTtsEngineWith(deps: NativeTtsDeps): ITtsEngine {
  const { port } = deps;
  let counter = 0;
  let current = 0; // id của câu đang chờ plugin; 0 = không có câu nào

  function stopQuietly(): void {
    try {
      port.stop().catch((e: unknown) => log.warn('port.stop lỗi:', e));
    } catch (e) {
      log.warn('port.stop ném lỗi:', e);
    }
  }

  async function init(): Promise<TtsCapabilities> {
    if (!deps.isNative()) return { ...UNAVAILABLE };
    try {
      const supported = await port.isLanguageSupported(VIETNAMESE_LANG);
      let viVoices: NativeTtsVoice[] = [];
      try {
        viVoices = (await port.listVoices()).filter((v) => isVietnamese(v.lang));
      } catch (e) {
        log.warn('Không liệt kê được giọng của máy:', e);
      }
      // KHÔNG CHẮC: nếu plugin không cho biết giọng nào chạy cục bộ thì coi giọng Việt là chạy ngoại tuyến (xem Giả định).
      const localKnown = viVoices.some((v) => typeof v.localService === 'boolean');
      const offlineVietnamese = supported && (localKnown ? viVoices.some((v) => v.localService === true) : true);
      const voiceName = (viVoices.find((v) => v.localService === true) ?? viVoices[0])?.name;
      return {
        available: true,
        vietnameseVoice: supported,
        offlineVietnamese,
        requiresUserGesture: false,
        ...(voiceName === undefined ? {} : { voiceName }),
      };
    } catch (e) {
      log.warn('Plugin TTS không dùng được:', toAppError(e));
      return { ...UNAVAILABLE };
    }
  }

  function speak(text: string, opts: { rate: number; lang: string; audioKey?: string }, hooks: TtsHooks): void {
    if (current !== 0) {
      current = 0; // câu cũ bị thay: kết quả muộn của nó sẽ bị bỏ qua
      stopQuietly();
    }
    counter += 1;
    const id = counter;
    current = id;
    hooks.onStart();
    let pending: Promise<void>;
    try {
      pending = port.speak({ text, lang: opts.lang, rate: opts.rate });
    } catch (e) {
      current = 0;
      hooks.onError(toAppError(e));
      return;
    }
    pending.then(
      () => {
        if (current !== id) return;
        current = 0;
        hooks.onEnd();
      },
      (e: unknown) => {
        if (current !== id) return;
        current = 0;
        hooks.onError(toAppError(e));
      },
    );
  }

  function cancel(): void {
    current = 0;
    stopQuietly();
  }

  return { name: 'native-tts', init, unlock: () => undefined, speak, cancel };
}

/** Engine TTS native thật: chỉ available trong APK Android. */
export function createNativeTtsEngine(): ITtsEngine {
  return createNativeTtsEngineWith({
    port: createCapacitorTtsPort(),
    isNative: () => getPlatform() === 'android-native',
  });
}
</file>

<file path="src/voice/speech-manager.ts">
import type {
  AppConfig,
  HapticEvent,
  IHaptics,
  ISpeech,
  ITtsEngine,
  RecognitionResult,
  Settings,
  SpeechIntent,
  TtsCapabilities,
  TtsHooks,
  UtteranceEvent,
} from '../contracts';
import { createLogger } from '../utils/logger';
import { systemClock } from '../utils/time';
import { buildPrompt } from './prompt-manager';
import type { Prompt } from './prompt-manager';

const log = createLogger('speech');

/**
 * Ước lượng thời gian đọc để đặt watchdog: độ dài chữ × hệ số / tốc độ + đệm.
 * AppConfig.speech chưa có các tham số này nên tạm đặt ở đây (xem "Đề xuất sửa hợp đồng").
 */
export const WATCHDOG_MS_PER_CHAR = 120;
export const WATCHDOG_MARGIN_MS = 1000;

export interface SpeechManagerOptions {
  engines: ITtsEngine[];
  haptics: IHaptics;
  getSettings: () => Settings;
  config: AppConfig['speech'];
  now?: () => number;
}

/** Hẹn giờ được tiêm vào để test không phải chờ thật. */
export interface SpeechTimers {
  setTimeout(handler: () => void, ms: number): unknown;
  clearTimeout(handle: unknown): void;
}

const REAL_TIMERS: SpeechTimers = {
  setTimeout: (handler, ms) => globalThis.setTimeout(handler, ms),
  clearTimeout: (handle) => globalThis.clearTimeout(handle as number),
};

const UNAVAILABLE: TtsCapabilities = {
  available: false,
  vietnameseVoice: false,
  offlineVietnamese: false,
  requiresUserGesture: false,
};

/** Cắt câu dài theo dấu chấm thành các câu ngắn (mỗi câu giữ dấu chấm của nó). */
export function splitIntoUtterances(text: string): string[] {
  return (text.match(/[^.]+\.?/g) ?? []).map((s) => s.trim()).filter((s) => s !== '' && s !== '.');
}

/** Thời gian chờ tối đa cho một câu: số lớn hơn giữa maxUtteranceMs và ước lượng theo độ dài chữ. */
export function utteranceTimeoutMs(text: string, rate: number, maxUtteranceMs: number): number {
  const safeRate = Number.isFinite(rate) && rate > 0 ? rate : 1;
  const estimate = Math.ceil((text.length * WATCHDOG_MS_PER_CHAR) / safeRate) + WATCHDOG_MARGIN_MS;
  return Math.max(maxUtteranceMs, estimate);
}

function hapticFor(intent: SpeechIntent): HapticEvent | null {
  switch (intent.kind) {
    case 'CAMERA_READY':
      return 'START';
    case 'RESULT':
      return 'SUCCESS';
    case 'ERROR':
      return 'ERROR';
    case 'GUIDANCE':
      return intent.code === 'LOW_CONFIDENCE' || intent.code === 'CLASS_CONFLICT' ? 'UNCERTAIN' : null;
    default:
      return null;
  }
}

interface QueueItem {
  readonly kind: SpeechIntent['kind'];
  readonly prompt: Prompt;
  readonly chunks: readonly string[];
  readonly enqueuedAt: number;
  next: number;
  started: boolean;
}

interface ActiveUtterance {
  readonly id: number;
  readonly item: QueueItem;
  readonly watchdog: unknown;
}

interface ProbedEngine {
  engine: ITtsEngine;
  caps: TtsCapabilities;
}

type EndOutcome = 'ended' | 'error' | 'cancelled' | 'watchdog';

/** Chọn engine: aria-live (nếu chọn đọc qua trình đọc màn hình) → engine đầu tiên có giọng Việt → audio-clip → engine nào dùng được. */
function chooseEngine(probed: ProbedEngine[], speechOutput: Settings['speechOutput']): ProbedEngine | null {
  const usable = probed.filter((p) => p.caps.available);
  if (speechOutput === 'SCREEN_READER') {
    const reader = usable.find((p) => p.engine.name === 'aria-live');
    if (reader !== undefined) return reader;
  }
  const voiced = usable.find((p) => p.engine.name !== 'audio-clip' && p.caps.vietnameseVoice);
  if (voiced !== undefined) return voiced;
  const clip = usable.find((p) => p.engine.name === 'audio-clip');
  if (clip !== undefined) return clip;
  const any = usable[0];
  return any === undefined ? null : { engine: any.engine, caps: { ...any.caps, vietnameseVoice: false } };
}

/**
 * Bộ điều phối giọng nói với hẹn giờ tiêm vào (dùng cho test và cho createSpeechManager).
 * Bảo đảm: tại mọi thời điểm chỉ có MỘT utterance đang phát; mỗi utterance có đúng một sự kiện start và một end
 * (kể cả khi bị hủy, lỗi hay watchdog); hook muộn của utterance cũ bị bỏ qua. Phải await init() trước khi say().
 */
export function createSpeechManagerWithTimers(o: SpeechManagerOptions, timers: SpeechTimers): ISpeech {
  const { engines, haptics, getSettings, config } = o;
  const now = o.now ?? systemClock;
  const handlers = new Set<(e: UtteranceEvent) => void>();
  const spokenAt = new Map<string, number>(); // câu → lần cuối người dùng được báo (bắt đầu đọc hoặc đọc xong)
  let selected: ProbedEngine | null = null;
  let queue: QueueItem[] = []; // luôn sắp theo ưu tiên giảm dần; đầu hàng là mục đang đọc dở hoặc sắp đọc
  let active: ActiveUtterance | null = null;
  let gapTimer: unknown = null;
  let lastEndAt = Number.NEGATIVE_INFINITY;
  let lastResult: RecognitionResult | null = null;
  let nextId = 1;

  function safely(label: string, fn: () => void): void {
    try {
      fn();
    } catch (e) {
      log.error(`${label} ném lỗi`, e);
    }
  }

  function emit(phase: UtteranceEvent['phase'], kind: UtteranceEvent['kind']): void {
    for (const handler of [...handlers]) {
      safely('Bộ nghe sự kiện utterance', () => handler({ phase, kind }));
    }
  }

  function playHaptic(intent: SpeechIntent): void {
    const event = hapticFor(intent);
    if (event !== null) safely('haptics.play', () => haptics.play(event));
  }

  function isActive(id: number): boolean {
    return active !== null && active.id === id;
  }

  function removeItem(item: QueueItem): void {
    queue = queue.filter((q) => q !== item);
  }

  /** Bỏ hướng dẫn chờ quá guidanceStaleMs (chỉ mục chưa đọc câu nào) và quên các câu đã quá cửa sổ chống lặp. */
  function dropStale(): void {
    const t = now();
    queue = queue.filter((item) => {
      const stale = item.kind === 'GUIDANCE' && !item.started && t - item.enqueuedAt > config.guidanceStaleMs;
      if (stale) log.debug('Bỏ hướng dẫn quá hạn:', item.prompt.text);
      return !stale;
    });
    for (const [text, at] of spokenAt) {
      if (t - at >= config.dedupeWindowMs) spokenAt.delete(text);
    }
  }

  function isRepeat(text: string): boolean {
    if (queue.some((item) => item.prompt.text === text)) return true;
    const at = spokenAt.get(text);
    return at !== undefined && now() - at < config.dedupeWindowMs;
  }

  function remainingGapMs(): number {
    return Math.max(0, Math.min(config.minGapMs, lastEndAt + config.minGapMs - now()));
  }

  /** Kết thúc utterance đang phát (đúng một lần), rồi đọc tiếp. Hook của utterance cũ (id lệch) bị bỏ qua. */
  function endUtterance(id: number, outcome: EndOutcome): void {
    const current = active;
    if (current === null || current.id !== id) return;
    timers.clearTimeout(current.watchdog);
    active = null;
    lastEndAt = now();
    const { item } = current;
    if (outcome !== 'ended' || item.next >= item.chunks.length) removeItem(item); // lỗi, hủy, watchdog: bỏ phần còn lại
    if (outcome === 'error' && item.next === 1) spokenAt.delete(item.prompt.text); // chưa nghe được gì: cho phép thử lại
    else spokenAt.set(item.prompt.text, lastEndAt);
    emit('end', item.kind);
    pump();
  }

  function cancelActive(): void {
    const current = active;
    if (current === null) return;
    safely('engine.cancel', () => selected?.engine.cancel());
    endUtterance(current.id, 'cancelled');
  }

  function cancelEverything(): void {
    queue = [];
    if (gapTimer !== null) {
      timers.clearTimeout(gapTimer);
      gapTimer = null;
    }
    cancelActive();
  }

  function onWatchdog(id: number): void {
    if (!isActive(id)) return;
    log.warn('Watchdog: engine không báo kết thúc, tự kết thúc câu');
    safely('engine.cancel', () => selected?.engine.cancel());
    endUtterance(id, 'watchdog');
  }

  function startChunk(engine: ITtsEngine, item: QueueItem): void {
    const text = item.chunks[item.next];
    if (text === undefined) {
      removeItem(item);
      pump();
      return;
    }
    const settings = getSettings();
    item.next += 1;
    item.started = true;
    spokenAt.set(item.prompt.text, now());
    const id = nextId;
    nextId += 1;
    const timeout = utteranceTimeoutMs(text, settings.speechRate, config.maxUtteranceMs);
    const watchdog = timers.setTimeout(() => safely('watchdog', () => onWatchdog(id)), timeout);
    active = { id, item, watchdog };
    emit('start', item.kind);
    if (!isActive(id)) return; // một bộ nghe đã hủy hoặc ngắt ngay trong sự kiện start
    const hooks: TtsHooks = {
      onStart: () => undefined,
      onEnd: () => safely('onEnd', () => endUtterance(id, 'ended')),
      onError: (e) =>
        safely('onError', () => {
          log.warn('Engine báo lỗi khi đọc:', e);
          endUtterance(id, 'error');
        }),
    };
    const base = { rate: settings.speechRate, lang: settings.voiceLanguage };
    const opts =
      engine.name === 'audio-clip' && item.prompt.audioKey !== undefined ? { ...base, audioKey: item.prompt.audioKey } : base;
    try {
      engine.speak(text, opts, hooks);
    } catch (e) {
      log.warn('engine.speak ném lỗi:', e);
      endUtterance(id, 'error');
    }
  }

  /** Đọc mục đầu hàng đợi nếu đang rảnh và đã đủ khoảng lặng; chưa đủ thì hẹn giờ. */
  function pump(): void {
    if (active !== null || gapTimer !== null) return;
    dropStale();
    const item = queue[0];
    if (item === undefined) return;
    if (selected === null || !getSettings().voiceEnabled) {
      queue = [];
      return;
    }
    const wait = remainingGapMs();
    if (wait > 0) {
      gapTimer = timers.setTimeout(
        () =>
          safely('gap', () => {
            gapTimer = null;
            pump();
          }),
        wait,
      );
      return;
    }
    startChunk(selected.engine, item);
  }

  function accept(intent: SpeechIntent, prompt: Prompt, settings: Settings): void {
    dropStale();
    if (intent.kind !== 'REPLAY' && isRepeat(prompt.text)) {
      log.debug('Bỏ câu lặp:', prompt.text);
      return;
    }
    const head = queue[0];
    const inProgress = head !== undefined && head.started ? head : undefined;
    if (intent.kind === 'GUIDANCE' && inProgress !== undefined && (inProgress.kind === 'RESULT' || inProgress.kind === 'REPLAY')) {
      log.debug('Hướng dẫn không được ngắt kết quả đang đọc:', prompt.text);
      return;
    }

    playHaptic(intent);

    const engine = selected === null ? null : selected.engine;
    const canSpeak =
      settings.voiceEnabled && engine !== null && (engine.name !== 'audio-clip' || prompt.audioKey !== undefined);
    if (engine === null || !canSpeak) {
      if (!settings.voiceEnabled) cancelEverything();
      spokenAt.set(prompt.text, now());
      return;
    }

    // Ưu tiên cao hơn: xóa mục thấp hơn (kể cả mục đang đọc). Cùng supersedeKey: thay mục đang chờ.
    const lowered = queue.filter((q) => q.prompt.priority < prompt.priority);
    queue = queue.filter(
      (q) => q.prompt.priority >= prompt.priority && !(q.prompt.supersedeKey === prompt.supersedeKey && !q.started),
    );
    queue.push({
      kind: intent.kind,
      prompt,
      chunks: engine.name === 'audio-clip' ? [prompt.text] : splitIntoUtterances(prompt.text),
      enqueuedAt: now(),
      next: 0,
      started: false,
    });
    if (active !== null && lowered.some((q) => q === active?.item)) cancelActive();
    pump();
  }

  function say(intent: SpeechIntent): void {
    safely('say', () => {
      const settings = getSettings();
      let prompt: Prompt;
      try {
        prompt = buildPrompt(intent, settings);
      } catch (e) {
        // Fail Safe: dữ liệu không đáng tin thì KHÔNG đọc số tiền; kết quả hỏng được thay bằng lời từ chối an toàn.
        log.error('Không dựng được câu nói, bỏ qua:', e);
        if (intent.kind === 'RESULT') say({ kind: 'GUIDANCE', code: 'LOW_CONFIDENCE' });
        return;
      }
      if (intent.kind === 'RESULT') lastResult = intent.result;
      accept(intent, prompt, settings);
    });
  }

  async function probe(engine: ITtsEngine): Promise<ProbedEngine> {
    try {
      return { engine, caps: { ...(await engine.init()) } };
    } catch (e) {
      log.warn(`Engine ${engine.name} init lỗi, coi như không dùng được:`, e);
      return { engine, caps: { ...UNAVAILABLE } };
    }
  }

  async function init(): Promise<TtsCapabilities> {
    safely('init', cancelEverything);
    selected = null;
    try {
      const speechOutput = getSettings().speechOutput;
      selected = chooseEngine(await Promise.all(engines.map(probe)), speechOutput);
    } catch (e) {
      log.error('Chọn engine lỗi:', e);
    }
    if (selected === null) log.warn('Không có engine đọc nào dùng được');
    else log.info(`Chọn engine ${selected.engine.name}`);
    return selected === null ? { ...UNAVAILABLE } : { ...selected.caps };
  }

  return {
    /** true khi có một utterance đang phát (từ start đến end); không tính khoảng lặng giữa hai câu. */
    get isSpeaking(): boolean {
      return active !== null;
    },
    init,
    unlock(): void {
      for (const engine of engines) safely(`${engine.name}.unlock`, () => engine.unlock());
    },
    say,
    replayLast(): void {
      say(lastResult !== null ? { kind: 'REPLAY', result: lastResult } : { kind: 'REPLAY_EMPTY' });
    },
    cancelAll(): void {
      safely('cancelAll', cancelEverything);
    },
    onUtterance(handler: (e: UtteranceEvent) => void): () => void {
      handlers.add(handler);
      return () => {
        handlers.delete(handler);
      };
    },
  };
}

/** Bộ điều phối giọng nói thật (hẹn giờ của hệ thống). */
export function createSpeechManager(o: SpeechManagerOptions): ISpeech {
  return createSpeechManagerWithTimers(o, REAL_TIMERS);
}
